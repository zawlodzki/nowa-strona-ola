PUBLIC_SANITY_PROJECT_ID=your-project-id
PUBLIC_SANITY_DATASET=production
# Endpoint publicznej instancji c15t. Lokalnie klient używa /api/c15t dla atrap.
PUBLIC_C15T_ENDPOINT=https://consent.zawlodzki.com/api/c15t
# Włączyć dopiero po migracji GTM i zatwierdzeniu neutralnych treści pomiaru.
PUBLIC_GTM_ENABLED=false
# Opcjonalnie: inny webhook formularzy (tylko https://). Domyślnie produkcyjny n8n.
# PUBLIC_LEAD_WEBHOOK_URL=https://example.com/webhook/test

# IndexNow pozostaje wyłączony. Klucz 8–128 znaków A–Z, a–z, 0–9 lub -.
# Włączenie wymaga DEPLOYMENT_TARGET=production i SITE_INDEXING=production.
# INDEXNOW_KEY=
