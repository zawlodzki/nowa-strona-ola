{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ola-website-integrations",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 0.1,
    },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
  "env": {
    "staging": { "name": "ola-website-integrations-staging" },
    "production": { "name": "ola-website-integrations-production" },
  },
}
