{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ola-website-studio",
  "compatibility_date": "2026-09-14",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 0.1,
    },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "env": {
    "production": {
      "name": "ola-website-studio-production",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "studio.aleksandraolesiewicz.com",
          "custom_domain": true,
        },
      ],
    },
  },
}
