---
import Layout from "../layouts/Layout.astro";
import { catalogCopy } from "../sections/catalog-examples";
import CtaSection from "../sections/CtaSection.astro";
import FormSection from "../sections/FormSection.astro";
import { getPage } from "../sanity/repository";
import PageHero from "../views/PageHero.astro";
import SiteFooter from "../ui/site-footer/SiteFooter.astro";
import SiteHeader from "../ui/site-header/SiteHeader.astro";
export function getStaticPaths() {
  return [
    { params: { locale: undefined }, props: { lang: "pl" } },
    { params: { locale: "en" }, props: { lang: "en" } },
  ];
}
const { lang } = Astro.props as { lang: "pl" | "en" };
const pl = lang === "pl";
const page = await getPage(lang, "home");
const form = catalogCopy(lang).form;
---

<Layout lang={lang} title={page.seo?.title ?? page.title}>
  <SiteHeader lang={lang} />
  <main id="main">
    <PageHero page={page} />
    <FormSection
      lang={lang}
      labelledby="contact-title"
      content={{
        ...form,
        lead: pl
          ? "To formularz demonstracyjny. Dane pozostają w przeglądarce i nie są wysyłane."
          : "This is a demonstration form. Your data stays in the browser and is not sent.",
      }}
    />
    <CtaSection
      labelledby="home-cta-title"
      content={{
        theme: "dark",
        title: pl
          ? "Ten sam system. Inny kontekst."
          : "One system. A different context.",
        lead: pl
          ? "Jasny i ciemny wariant korzystają ze wspólnych tokenów."
          : "Light and dark sections share the same design tokens.",
        action: {
          href: "#contact",
          label: pl ? "Wróć do formularza" : "Back to the form",
        },
      }}
    />
  </main>
  <SiteFooter lang={lang} />
</Layout>
