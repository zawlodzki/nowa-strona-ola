---
import type { GetStaticPaths } from "astro";

import { blogCollectionPageCount } from "@/lib/pagination";
import { blogPath } from "@/lib/paths";
import {
  getArticleIndex,
  getBlogPage,
  getSiteSettings,
  listArticles,
  listCategories,
} from "@/sanity/repository";
import BlogCollectionPage from "@/views/BlogCollectionPage.astro";

export const getStaticPaths = (async () => {
  const articles = await listArticles("pl");
  const totalPages = blogCollectionPageCount(articles.length);
  return Array.from({ length: totalPages }, (_, index) => index + 1)
    .filter((page) => page > 1)
    .map((page) => ({ params: { page: String(page) } }));
}) satisfies GetStaticPaths;

const lang = "pl" as const;
const page = Number(Astro.params.page);
const [index, settings, categories, blogPage] = await Promise.all([
  getArticleIndex(lang, page),
  getSiteSettings(lang),
  listCategories(lang),
  getBlogPage(lang),
]);
---

<BlogCollectionPage
  lang={lang}
  settings={settings}
  page={blogPage}
  index={index}
  categories={categories}
  pageHref={(pageNumber) => blogPath(lang, pageNumber)}
  alternateHref={blogPath("en", page)}
/>
