---
import type { GetStaticPaths } from "astro";

import { ARTICLES_PER_PAGE, blogPath } from "@/lib/paths";
import {
  getArticleIndex,
  getSiteSettings,
  listArticles,
  listCategories,
} from "@/sanity/repository";
import BlogIndex from "@/views/BlogIndex.astro";

export const getStaticPaths = (async () => {
  const articles = await listArticles("pl");
  const totalPages = Math.max(
    1,
    Math.ceil(articles.length / ARTICLES_PER_PAGE),
  );
  return Array.from({ length: totalPages }, (_, index) => index + 1)
    .filter((page) => page > 1)
    .map((page) => ({ params: { page: String(page) } }));
}) satisfies GetStaticPaths;

const lang = "pl" as const;
const page = Number(Astro.params.page);
const [index, settings, categories] = await Promise.all([
  getArticleIndex(lang, page),
  getSiteSettings(lang),
  listCategories(lang),
]);
---

<BlogIndex
  lang={lang}
  settings={settings}
  title="Blog"
  lead="Wpisy demonstracyjne. Każdy język ma osobne dokumenty."
  articles={index.items}
  featured={index.featured}
  categories={categories}
  page={index.page}
  totalPages={index.totalPages}
  pageHref={(pageNumber) => blogPath(lang, pageNumber)}
  alternateHref={blogPath("en", page)}
/>
