---
import type { GetStaticPaths } from "astro";

import { blogCategoryPath } from "@/lib/paths";
import {
  getArticleIndex,
  getCategory,
  getSiteSettings,
  listCategories,
  listCategoryPageParams,
} from "@/sanity/repository";
import BlogIndex from "@/views/BlogIndex.astro";

export const getStaticPaths = (async () => {
  const paths = await listCategoryPageParams("pl");
  return paths.map((entry) => ({ params: entry }));
}) satisfies GetStaticPaths;

const lang = "pl" as const;
const slug = Astro.params.slug;
const page = Number(Astro.params.page);
if (!slug) throw new Error("Brak sluga kategorii.");
const [category, index, settings, categories] = await Promise.all([
  getCategory(lang, slug),
  getArticleIndex(lang, page, { categorySlug: slug }),
  getSiteSettings(lang),
  listCategories(lang),
]);
---

<BlogIndex
  lang={lang}
  settings={settings}
  title={category.title ?? slug}
  lead={category.description ?? ""}
  articles={index.items}
  featured={index.featured}
  categories={categories}
  page={index.page}
  totalPages={index.totalPages}
  category={category}
  pageHref={(pageNumber) => blogCategoryPath(lang, slug, pageNumber)}
  alternateHref={
    category.translation?.slug
      ? blogCategoryPath("en", category.translation.slug, page)
      : null
  }
/>
