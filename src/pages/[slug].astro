---
import type { GetStaticPaths } from "astro";

import { HOME_SLUG, reservedPageSlugs } from "@/lib/paths";
import {
  findLegalPage,
  getLegalPagePaths,
  getPage,
  getPagePaths,
  getSiteSettings,
} from "@/sanity/repository";
import ComposedPage from "@/views/ComposedPage.astro";
import LegalPage from "@/views/LegalPage.astro";

export const getStaticPaths = (async () => {
  const [pages, legal] = await Promise.all([
    getPagePaths(),
    getLegalPagePaths(),
  ]);
  const legalSlugs = new Set(
    legal
      .filter((entry) => entry.language === "pl" && entry.slug)
      .map((entry) => entry.slug as string),
  );
  const pageSlugs = pages
    .filter(
      (entry) =>
        entry.language === "pl" &&
        entry.slug &&
        entry.slug !== HOME_SLUG &&
        !(reservedPageSlugs as readonly string[]).includes(entry.slug) &&
        !legalSlugs.has(entry.slug),
    )
    .map((entry) => entry.slug as string);
  return [...new Set([...pageSlugs, ...legalSlugs])].map((slug) => ({
    params: { slug },
  }));
}) satisfies GetStaticPaths;

const lang = "pl" as const;
const slug = Astro.params.slug;
if (!slug) throw new Error("Brak sluga strony.");
const [legal, settings] = await Promise.all([
  findLegalPage(lang, slug),
  getSiteSettings(lang),
]);
const page = legal ? null : await getPage(lang, slug);
---

{legal ? (
  <LegalPage lang={lang} page={legal} settings={settings} />
) : page ? (
  <ComposedPage lang={lang} page={page} settings={settings} />
) : null}
