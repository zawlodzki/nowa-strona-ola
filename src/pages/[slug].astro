---
import type { GetStaticPaths } from "astro";
import { HOME_SLUG, reservedPageSlugs } from "@/lib/paths";
import {
  getLegalPagePaths,
  getPage,
  getPagePaths,
  getSiteSettings,
} from "@/sanity/repository";
import LegacyPage from "@/views/LegacyPage.astro";
export const getStaticPaths = (async () => {
  const [pages, legal] = await Promise.all([
    getPagePaths(),
    getLegalPagePaths(),
  ]);
  const legalSlugs = new Set(
    legal.filter((p) => p.language === "pl").map((p) => p.slug),
  );
  return pages
    .filter(
      (p) =>
        p.language === "pl" &&
        p.slug &&
        p.slug !== HOME_SLUG &&
        !(reservedPageSlugs as readonly string[]).includes(p.slug) &&
        !legalSlugs.has(p.slug),
    )
    .map((p) => ({ params: { slug: p.slug as string } }));
}) satisfies GetStaticPaths;
const lang = "pl" as const;
const slug = Astro.params.slug;
if (!slug) throw new Error("Missing page slug.");
const [page, settings] = await Promise.all([
  getPage(lang, slug),
  getSiteSettings(lang),
]);
---

<LegacyPage lang={lang} page={page} settings={settings} />
