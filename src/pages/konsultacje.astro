---
import { getPage, getSiteSettings } from "@/sanity/repository";
import ConsultationPage from "@/views/ConsultationPage.astro";

const lang = "pl" as const;
const [page, settings] = await Promise.all([
  getPage(lang, "konsultacje"),
  getSiteSettings(lang),
]);
---

<ConsultationPage lang={lang} page={page} settings={settings} />
