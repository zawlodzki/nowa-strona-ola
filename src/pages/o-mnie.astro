---
import { getPage, getSiteSettings } from "@/sanity/repository";
import AboutPage from "@/views/AboutPage.astro";

const lang = "pl" as const;
const [page, settings] = await Promise.all([
  getPage(lang, "o-mnie"),
  getSiteSettings(lang),
]);
---

<AboutPage lang={lang} page={page} settings={settings} />
