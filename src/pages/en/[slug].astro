---
import type { GetStaticPaths } from "astro";

import { HOME_SLUG, reservedPageSlugs } from "@/lib/paths";
import { getPage, getPagePaths, getSiteSettings } from "@/sanity/repository";
import ComposedPage from "@/views/ComposedPage.astro";

export const getStaticPaths = (async () => {
  const paths = await getPagePaths();
  return paths
    .filter(
      (entry) =>
        entry.language === "en" &&
        entry.slug &&
        entry.slug !== HOME_SLUG &&
        !(reservedPageSlugs as readonly string[]).includes(entry.slug),
    )
    .map((entry) => ({ params: { slug: entry.slug } }));
}) satisfies GetStaticPaths;

const lang = "en" as const;
const slug = Astro.params.slug;
if (!slug) throw new Error("Missing page slug.");
const [page, settings] = await Promise.all([
  getPage(lang, slug),
  getSiteSettings(lang),
]);
---

<ComposedPage lang={lang} page={page} settings={settings} />
