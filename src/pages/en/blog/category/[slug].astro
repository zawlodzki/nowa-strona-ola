---
import type { GetStaticPaths } from "astro";

import { blogCategoryPath } from "@/lib/paths";
import {
  getArticleIndex,
  getBlogPage,
  getCategory,
  getSiteSettings,
  listCategories,
} from "@/sanity/repository";
import BlogCollectionPage from "@/views/BlogCollectionPage.astro";

export const getStaticPaths = (async () => {
  const categories = await listCategories("en");
  return categories
    .filter((category) => category.slug)
    .map((category) => ({ params: { slug: category.slug } }));
}) satisfies GetStaticPaths;

const lang = "en" as const;
const slug = Astro.params.slug;
if (!slug) throw new Error("Missing category slug.");
const [category, index, settings, categories, blogPage] = await Promise.all([
  getCategory(lang, slug),
  getArticleIndex(lang, 1, { categorySlug: slug }),
  getSiteSettings(lang),
  listCategories(lang),
  getBlogPage(lang),
]);
---

<BlogCollectionPage
  lang={lang}
  settings={settings}
  page={blogPage}
  index={index}
  categories={categories}
  category={category}
  pageHref={(page) => blogCategoryPath(lang, slug, page)}
  alternateHref={
    category.translation?.slug
      ? blogCategoryPath("pl", category.translation.slug)
      : null
  }
/>
