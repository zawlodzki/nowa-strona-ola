---
import { blogPath } from "@/lib/paths";
import {
  getArticleIndex,
  getSiteSettings,
  listCategories,
} from "@/sanity/repository";
import BlogCollectionPage from "@/views/BlogCollectionPage.astro";

const lang = "en" as const;
const [index, settings, categories] = await Promise.all([
  getArticleIndex(lang, 1),
  getSiteSettings(lang),
  listCategories(lang),
]);
---

<BlogCollectionPage
  lang={lang}
  settings={settings}
  index={index}
  categories={categories}
  pageHref={(page) => blogPath(lang, page)}
  alternateHref={blogPath("pl")}
/>
