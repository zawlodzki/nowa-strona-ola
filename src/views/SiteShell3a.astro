---
import type { Locale } from "@ola/shared";

import Layout3a from "@/design-system/Layout3a.astro";
import SiteFooter from "@/design-system/components/SiteFooter.astro";
import SiteHeader from "@/design-system/components/SiteHeader.astro";
import ConsentPanel from "@/design-system/components/ConsentPanel.astro";
import { homePath } from "@/lib/paths";
import { isIndexingEnabled } from "@/lib/seo/site";
import type { PageSeo } from "@/lib/seo/types";
import SeoHead from "@/views/SeoHead.astro";
import type { NavigationLink, SocialLink } from "@/design-system/types";

export interface Props {
  lang: Locale;
  title: string;
  description?: string;
  navigation: NavigationLink[];
  footerLinks?: NavigationLink[];
  headerCta?: NavigationLink;
  footerNote: string;
  socialLinks?: SocialLink[];
  legalLinks?: NavigationLink[];
  copyright: string;
  preview?: boolean;
  languageHref?: string | null;
  legacyBase?: boolean;
  /** Canonical, Open Graph and JSON-LD; omitted in the draft preview. */
  seo?: PageSeo;
  /** Always noindex (e.g. 404), independent of the build environment. */
  noindex?: boolean;
}

const {
  lang,
  title,
  description,
  navigation,
  footerLinks = navigation,
  headerCta,
  footerNote,
  socialLinks = [],
  legalLinks = [],
  copyright,
  preview = false,
  languageHref = null,
  legacyBase = false,
  seo,
  noindex: forceNoindex = false,
} = Astro.props;
const homeHref = homePath(lang);
const noindex =
  forceNoindex || preview || seo?.noindex === true || !isIndexingEnabled();
---

<Layout3a
  lang={lang}
  title={title}
  description={description}
  noindex={noindex}
  legacyBase={legacyBase}
>
  {seo && !preview && (
    <SeoHead
      slot="head"
      lang={lang}
      title={title}
      description={description}
      seo={seo}
    />
  )}
  {preview && (
    <div class="preview-banner">
      <strong>
        {lang === "pl" ? "Chroniony podgląd szkicu" : "Protected draft preview"}
      </strong>
      <form method="post" action="/api/draft-mode/disable">
        <button type="submit">
          {lang === "pl" ? "Zakończ podgląd" : "End preview"}
        </button>
      </form>
    </div>
  )}
  <SiteHeader
    homeHref={homeHref}
    links={navigation}
    cta={headerCta}
    lang={lang}
    languageHref={languageHref}
  />
  <slot />
  <SiteFooter
    homeHref={homeHref}
    description={footerNote}
    links={footerLinks}
    socialLinks={socialLinks}
    legalLinks={legalLinks}
    copyright={copyright}
    lang={lang}
    consentEnabled={!preview}
  />
  {!preview && (
    <ConsentPanel
      lang={lang}
      endpoint={
        import.meta.env.PUBLIC_C15T_ENDPOINT ??
        "https://consent.zawlodzki.com/api/c15t"
      }
    />
  )}
</Layout3a>

<style>
  .preview-banner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--ao-space-16);
    padding-block: var(--ao-space-12);
    padding-inline: var(--ao-space-24);
    background: var(--ao-surface);
    border-block-end: 1px solid var(--ao-line);
    font-size: 0.875rem;
  }
  .preview-banner button {
    min-block-size: var(--ao-target-min);
    padding-inline: var(--ao-space-16);
    border: 1px solid var(--ao-line);
    background: transparent;
    color: inherit;
  }
</style>
