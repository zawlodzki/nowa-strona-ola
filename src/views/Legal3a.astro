---
import Breadcrumbs from "@/design-system/components/Breadcrumbs.astro";
import Container from "@/design-system/components/Container.astro";
import type { LegalPageView } from "@/content/map-legal";

export interface Props {
  content: LegalPageView;
}

const { content } = Astro.props;
---

<main id="main" class="legal3a">
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(content.jsonLd)}
  ></script>
  <div class="legal-heading" id="start">
    <Container>
      <Breadcrumbs
        label={content.breadcrumbLabel}
        links={content.breadcrumbs}
      />
      <h1>{content.title}</h1>
      <p class="legal-effective">
        {content.versionLabel} ·{" "}
        {content.effective ? (
          <>
            {content.effectiveCaption}{" "}
            <time datetime={content.effective.datetime}>
              {content.effective.label}
            </time>
          </>
        ) : (
          content.pendingCaption
        )}
      </p>
    </Container>
  </div>
  <Container>
    <div class="legal-layout">
      {content.toc.length > 1 && (
        <nav class="legal-toc" aria-labelledby="toc-title">
          <details open>
            <summary id="toc-title">{content.tocLabel}</summary>
            <ol>
              {content.toc.map((entry) => (
                <li>
                  <a href={`#${entry.id}`}>{entry.text}</a>
                </li>
              ))}
            </ol>
          </details>
        </nav>
      )}
      <div class="article-richtext" set:html={content.html} />
    </div>
  </Container>
</main>

<style>
  .legal-heading {
    padding-block-start: 32px;
  }
  .legal3a h1 {
    max-inline-size: 1000px;
    margin-block: 40px 16px;
    margin-inline: 0;
    font-size: var(--ao-legal-heading);
    line-height: 1.08;
    letter-spacing: -0.04em;
  }
  .legal-effective {
    color: var(--ao-muted);
    font-size: 0.9375rem;
    margin-block: 0 32px;
    margin-inline: 0;
  }
  .legal-layout {
    display: grid;
    gap: 32px;
    padding-block-end: 80px;
  }
  .legal-toc {
    padding-block: 20px;
    padding-inline: 24px;
    border-radius: var(--ao-radius-panel);
    background: var(--ao-surface);
  }
  .legal-toc summary {
    font-weight: 600;
    cursor: pointer;
  }
  .legal-toc ol {
    margin-block: 16px 0;
    margin-inline: 0;
    padding-inline-start: 20px;
  }
  @media (hover: hover) and (pointer: fine) {
    .legal-toc a:hover {
      color: var(--ao-primary);
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }
  .article-richtext {
    font-size: 1.125rem;
    line-height: 1.8;
  }
  .article-richtext :global(p) {
    margin-block-end: 24px;
  }
  .article-richtext :global(h2) {
    margin-block: 56px 20px;
    margin-inline: 0;
    font-size: 2.125rem;
    letter-spacing: -0.03em;
    line-height: 1.15;
    scroll-margin-block-start: 32px;
  }
  .article-richtext :global(h2:focus-visible) {
    outline: 2px solid var(--ao-primary);
    outline-offset: 8px;
  }
  .article-richtext :global(h3) {
    font-size: 1.4375rem;
    font-weight: 600;
    margin-block: 32px 16px;
    margin-inline: 0;
  }
  .article-richtext :global(ul),
  .article-richtext :global(ol) {
    padding-inline-start: 24px;
    margin-block: 20px 28px;
    margin-inline: 0;
  }
  /* Legacy base (Tailwind preflight) hides list markers; legal clauses need
     their numbers, as in the article-3a richtext mockup (nested too). */
  .article-richtext :global(ol) {
    list-style: decimal;
  }
  .article-richtext :global(li) {
    padding-inline-start: 8px;
    margin-block: 12px;
    margin-inline: 0;
  }
  .article-richtext :global(a) {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  /* Legal quotations are forms and addresses to copy, not pull quotes. */
  .article-richtext :global(blockquote) {
    margin-block: 28px;
    margin-inline: 0;
    padding-block: 24px;
    padding-inline: 24px;
    border-radius: var(--ao-radius-panel);
    background: var(--ao-surface);
  }
  .article-richtext :global(blockquote p) {
    margin-block-end: 12px;
  }
  .article-richtext :global(blockquote p:last-child) {
    margin-block-end: 0;
  }
  .article-richtext :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9em;
    background: var(--ao-surface);
    padding-block: 1px;
    padding-inline: 5px;
    border-radius: 4px;
    overflow-wrap: anywhere;
  }
  .article-richtext :global(.article-table-wrap) {
    overflow-x: auto;
    margin-block: 28px;
    margin-inline: 0;
    scrollbar-color: var(--ao-primary) var(--ao-surface);
  }
  .article-richtext :global(.article-table-wrap:focus-visible) {
    outline: 2px solid var(--ao-primary);
    outline-offset: 4px;
  }
  .article-richtext :global(table) {
    border-collapse: collapse;
    inline-size: 100%;
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .article-richtext :global(caption) {
    text-align: start;
    font-size: 0.8125rem;
    color: var(--ao-muted);
    margin-block-end: 12px;
  }
  .article-richtext :global(th),
  .article-richtext :global(td) {
    padding: 16px;
    text-align: start;
    border-block-end: 1px solid var(--ao-line);
    vertical-align: top;
  }
  .article-richtext :global(thead) {
    background: var(--ao-surface);
  }
  .article-richtext :global(tbody th) {
    font-weight: 500;
    inline-size: 28%;
  }
  @media (min-width: 960px) {
    .legal-layout {
      grid-template-columns: 260px minmax(0, 1fr);
      align-items: start;
    }
    .legal-toc {
      position: sticky;
      inset-block-start: var(--ao-sticky-offset);
      max-block-size: calc(100dvh - var(--ao-sticky-offset) - 24px);
      overflow-y: auto;
      scrollbar-width: thin;
    }
    .legal-layout:not(:has(.legal-toc)) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 959px) {
    .legal3a h1 {
      font-size: var(--ao-legal-mobile);
    }
    .article-richtext :global(h2) {
      font-size: 1.625rem;
    }
  }
</style>
