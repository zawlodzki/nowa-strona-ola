---
import type { Locale } from "@ola/shared";

import ArrowIcon from "@/design-system/components/ArrowIcon.astro";
import BookCover from "@/design-system/components/BookCover.astro";
import Button from "@/design-system/components/Button.astro";
import Carousel from "@/design-system/components/Carousel.astro";
import Container from "@/design-system/components/Container.astro";
import ContentCard from "@/design-system/components/ContentCard.astro";
import LeadForm from "@/design-system/components/LeadForm.astro";
import Heading from "@/design-system/components/Heading.astro";
import Hero from "@/design-system/components/Hero.astro";
import Newsletter from "@/design-system/components/Newsletter.astro";
import PriceGross from "@/design-system/components/PriceGross.astro";
import ReviewCard from "@/design-system/components/ReviewCard.astro";
import Section from "@/design-system/components/Section.astro";
import SplitPanel from "@/design-system/components/SplitPanel.astro";
import TextLink from "@/design-system/components/TextLink.astro";
import SiteImage from "@/design-system/components/SiteImage.astro";
import BookCoverArt, {
  type CoverArtKind,
} from "@/design-system/decorations/BookCoverArt.astro";
import CheckMark from "@/design-system/decorations/CheckMark.astro";
import CoverStage from "@/design-system/decorations/CoverStage.astro";
import StageBackdrop from "@/design-system/decorations/StageBackdrop.astro";
import TopicIcon from "@/design-system/decorations/TopicIcon.astro";
import { currencyLabel, topicLabel } from "@/lib/offer";
import type { HomepageView } from "@/content/map-homepage";

export interface Props {
  lang: Locale;
  content: HomepageView;
  reviewsDisclosure: string;
}

const { lang, content, reviewsDisclosure } = Astro.props;
const metric = content.approach.items[0];
const firstPcos = content.ebooks.items.find((item) => item.topic === "pcos");
const firstPeri = content.ebooks.items.find(
  (item) => item.topic === "perimenopause",
);
const pl = lang === "pl";
const coverArts: { kind: CoverArtKind; variant: "default" | "alt" }[] = [
  { kind: "decisions", variant: "default" },
  { kind: "route", variant: "alt" },
  { kind: "nutrition", variant: "default" },
  { kind: "observation", variant: "default" },
  { kind: "journal", variant: "alt" },
  { kind: "evening", variant: "default" },
];

function coverLabels(kind: CoverArtKind): string[] {
  switch (kind) {
    case "decisions":
      return pl ? ["Cel", "Dawka", "Decyzja"] : ["Aim", "Dose", "Decision"];
    case "route":
      return pl ? ["Badania", "Termin", "Wizyta"] : ["Tests", "Date", "Visit"];
    case "observation":
      return pl ? ["Energia", "Siła", "Sen"] : ["Energy", "Strength", "Sleep"];
    case "journal":
      return pl ? ["12 tygodni obserwacji"] : ["12 weeks of observation"];
    case "evening":
      return pl
        ? ["18:00", "20:00", "22:00", "Od kolacji do snu"]
        : ["18:00", "20:00", "22:00", "From dinner to sleep"];
    default:
      return [];
  }
}
---

<main id="main" class="home3a">
  <Hero
    id="start"
    kind="home"
    title={content.hero.title}
    description={content.hero.lead}
  >
    <Button slot="actions" as="a" href={content.hero.primary.href} arrow>
      {content.hero.primary.label}
    </Button>
    {content.hero.secondary && (
      <Button
        slot="actions"
        as="a"
        href={content.hero.secondary.href}
        variant="secondary"
        arrow
      >
        {content.hero.secondary.label}
      </Button>
    )}
    <div slot="media" class="home3a-portrait">
      <StageBackdrop />
      <SiteImage
        src={content.hero.media?.src}
        fallback="hero"
        alt={content.hero.media?.label ?? ""}
        width={1122}
        height={1402}
        fit="contain"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </Hero>

  <Section
    id="z-kim-pracuje"
    spacing="compact"
    class="home3a-audience"
    aria-labelledby="audience-title"
  >
    <Container>
      <div class="home3a-audience__head">
        <Heading id="audience-title">{content.audience.title}</Heading>
        {content.audience.lead && (
          <p class="ao-lead">{content.audience.lead}</p>
        )}
      </div>
      <ul class="home3a-audience__list">
        {content.audience.items.map((item) => (
          <li>
            {item.icon && (
              <span class="home3a-audience__icon" aria-hidden="true">
                {item.icon === "check" ? (
                  <CheckMark />
                ) : item.icon === "arrow" ? (
                  <ArrowIcon />
                ) : (
                  <TopicIcon name={item.icon} />
                )}
              </span>
            )}
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  <Section id="dlaczego-ja">
    <Container class="home3a-why">
      <div>
        <Heading>{content.approach.title}</Heading>
        {content.approach.lead && (
          <p class="ao-lead">{content.approach.lead}</p>
        )}
        <p class="home3a-count">
          <strong>
            {metric.value}
            <span>{metric.suffix}</span>
          </strong>
          <span>{metric.label}</span>
        </p>
      </div>
      <div class="home3a-results">
        {content.approach.highlights.map((item) => (
          <article>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </Container>
  </Section>

  <Section id="o-mnie" class="home3a-about">
    <Container class="home3a-about__grid">
      <div class="home3a-about__media">
        <SiteImage
          src={content.about.media.src}
          objectPosition="50% 15%"
          fallback="about"
          alt={content.about.media.label}
          width={1122}
          height={1402}
          loading="lazy"
        />
        <SiteImage
          class="home3a-about__food"
          src={content.about.secondaryMedia?.src}
          fallback="food"
          alt={content.about.secondaryMedia?.label ?? ""}
          width={1536}
          height={1024}
          loading="lazy"
        />
      </div>
      <div>
        <Heading>{content.about.title}</Heading>
        {content.about.lead && <p class="home3a-large">{content.about.lead}</p>}
        {content.about.body.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        {content.about.action && (
          <TextLink href={content.about.action.href}>
            {content.about.action.label}
          </TextLink>
        )}
      </div>
    </Container>
  </Section>

  <Section id="ebooki">
    <Container>
      <div class="home3a-section-head">
        <Heading>{content.ebooks.title}</Heading>
        <p class="ao-lead">{content.ebooks.lead}</p>
      </div>
      <Carousel
        id="ebooks-track"
        label={
          pl ? "E-booki, przewijaj w poziomie" : "E-books, scroll sideways"
        }
        columns={3}
        lang={lang}
        showPosition
        itemCount={content.ebooks.items.length}
      >
        <nav
          slot="toolbar"
          class="home3a-groups"
          aria-label={pl ? "Temat e-booków" : "E-book topics"}
        >
          {firstPcos && (
            <a
              href={`#ebook-${firstPcos.slug}`}
              data-book-group="pcos"
              aria-current="true"
            >
              PCOS
            </a>
          )}
          {firstPeri && (
            <a
              href={`#ebook-${firstPeri.slug}`}
              data-book-group="perimenopause"
            >
              {pl ? "Perimenopauza" : "Perimenopause"}
            </a>
          )}
        </nav>
        {content.ebooks.items.map((item, index) => {
          const art = coverArts[index] ?? {
            kind: "decisions" as const,
            variant: "default" as const,
          };
          return (
            <div id={`ebook-${item.slug}`} data-book-group={item.topic}>
              <ContentCard
                title={item.title}
                href={item.href}
                description={item.description}
                metadata={topicLabel(item.topic, lang)}
                metadataEnd="E-book"
                actionLabel={content.ebooks.cardActionLabel}
              >
                <CoverStage slot="media" variant={art.variant}>
                  <BookCover
                    title={item.title}
                    subtitle={item.subtitle ?? ""}
                    author={item.authorName}
                    topic={
                      pl
                        ? "Praktyczny przewodnik dla kobiet"
                        : "A practical guide for women"
                    }
                    tone={item.coverTone}
                  >
                    <BookCoverArt
                      slot="art"
                      kind={art.kind}
                      labels={coverLabels(art.kind)}
                      imageSrc={
                        art.kind === "nutrition"
                          ? content.about.secondaryMedia?.src
                          : undefined
                      }
                    />
                  </BookCover>
                </CoverStage>
                <PriceGross
                  slot="price"
                  amount={item.priceGross}
                  unit={currencyLabel(item.currency, lang)}
                  note={pl ? "brutto" : "gross"}
                />
              </ContentCard>
            </div>
          );
        })}
        {content.ebooks.collection && (
          <p slot="after" class="home3a-collection">
            <TextLink
              href={content.ebooks.collection.href}
              arrowDirection="right"
            >
              {content.ebooks.collection.label}
            </TextLink>
          </p>
        )}
        {content.ebooks.note && (
          <p slot="footer" class="home3a-note">
            {content.ebooks.note}
          </p>
        )}
      </Carousel>
    </Container>
  </Section>

  <Section id="konsultacje" spacing="compact">
    <Container>
      <SplitPanel labelledBy="consultation-title" id="konsultacje-panel">
        <Heading id="consultation-title">{content.consultation.title}</Heading>
        {content.consultation.body.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        <ul class="home3a-facts">
          {content.consultation.facts.map((fact) => (
            <li>
              <CheckMark />
              <span>{fact}</span>
            </li>
          ))}
        </ul>
        {content.consultation.priceLabel && (
          <p class="home3a-price">{content.consultation.priceLabel}</p>
        )}
        <Button as="a" href={content.consultation.action.href} arrow>
          {content.consultation.action.label}
        </Button>
        {content.consultation.bookingStatus === "placeholder" && (
          <p class="home3a-note">
            {pl
              ? "Tymczasowy adres kalendarza. Właściwe wydarzenie rezerwacji będzie podane później. To nie jest potwierdzenie wizyty."
              : "Temporary calendar address. The real booking event will be added later. This is not a booking confirmation."}
          </p>
        )}
        <SiteImage
          slot="media"
          src={content.consultation.media.src}
          fallback="contact"
          alt={content.consultation.media.label}
          width={1536}
          height={1024}
          loading="lazy"
        />
      </SplitPanel>
    </Container>
  </Section>

  <Section id="opinie">
    <Container>
      <div class="home3a-section-head">
        <Heading>{content.testimonials.title}</Heading>
      </div>
      <Carousel
        id="reviews-track"
        label={pl ? "Opinie, przewijaj w poziomie" : "Reviews, scroll sideways"}
        columns={2}
        lang={lang}
      >
        {content.testimonials.lead && (
          <p slot="toolbar" class="home3a-reviews-lead">
            {content.testimonials.lead}
          </p>
        )}
        {content.testimonials.items.map((item) => (
          <ReviewCard
            author={
              item.anonymous ? (item.displayLabel ?? "") : (item.name ?? "")
            }
            context={item.anonymous ? undefined : item.role}
          >
            <p>{item.quote}</p>
          </ReviewCard>
        ))}
      </Carousel>
      <p class="ao-review-disclosure">{reviewsDisclosure}</p>
    </Container>
  </Section>

  <Newsletter
    id="newsletter"
    title={content.newsletter.title}
    description={content.newsletter.lead}
  >
    <LeadForm slot="form" content={content.newsletter} lang={lang} />
  </Newsletter>
</main>

<style>
  .home3a-portrait {
    position: relative;
    block-size: 550px;
  }
  .home3a :global(.ao-hero .ao-lead) {
    max-inline-size: 52ch;
    font-size: 1.125rem;
    line-height: 1.5;
  }
  .home3a-portrait :global(img) {
    position: relative;
    z-index: 1;
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
    object-position: center bottom;
  }
  .home3a-audience {
    padding-block-start: var(--ao-space-32);
  }
  .home3a-audience__head {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--ao-space-24) 80px;
    align-items: end;
    margin-block-end: var(--ao-space-40);
  }
  .home3a-audience__head :global(.ao-heading) {
    font-size: 3.5rem;
  }
  .home3a-audience__head .ao-lead {
    max-inline-size: 52ch;
    margin: 0;
  }
  .home3a-audience__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: audience;
  }
  .home3a-audience__list:has(> li:nth-child(5)) {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .home3a-audience__list li {
    position: relative;
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 28px;
    border: 1px solid var(--ao-line);
    border-radius: 24px;
    counter-increment: audience;
  }
  .home3a-audience__list li:nth-child(odd) {
    background: var(--ao-surface);
    border-color: transparent;
  }
  .home3a-audience__list li::after {
    content: counter(audience, decimal-leading-zero);
    content: counter(audience, decimal-leading-zero) / "";
    position: absolute;
    inset-block-start: 28px;
    inset-inline-end: 28px;
    color: var(--ao-primary);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  .home3a-audience__icon {
    display: grid;
    place-items: center;
    inline-size: 40px;
    block-size: 40px;
    margin-block-end: 8px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ao-accent) 14%, var(--ao-background));
    color: var(--ao-accent);
  }
  .home3a-audience__icon :global(svg) {
    inline-size: 20px;
    block-size: 20px;
  }
  .home3a-audience__list h3 {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .home3a-audience__list p {
    margin: 0;
    color: var(--ao-muted);
    font-size: 0.875rem;
  }
  .home3a-why {
    display: grid;
    grid-template-columns: 0.95fr 1.2fr;
    gap: 80px;
    align-items: start;
  }
  .home3a-why :global(.ao-heading) {
    font-size: 3.5rem;
  }
  .home3a-count {
    display: flex;
    align-items: center;
    gap: var(--ao-space-24);
    margin-block-start: var(--ao-space-48);
  }
  .home3a-count strong {
    font-size: 92px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.07em;
    white-space: nowrap;
  }
  .home3a-count strong span {
    color: var(--ao-accent);
  }
  .home3a-count > span {
    max-inline-size: 180px;
    font-size: 14px;
  }
  .home3a-results {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .home3a-results article {
    padding: 28px;
    border-radius: 24px;
    background: var(--ao-surface);
  }
  .home3a-results article:first-child {
    grid-column: span 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 40px;
    align-items: center;
  }
  .home3a-results article:nth-child(2) {
    background: transparent;
    border: 1px solid var(--ao-line);
  }
  .home3a-results h3 {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .home3a-results p {
    margin-block-start: 10px;
    color: var(--ao-muted);
    font-size: 0.875rem;
  }
  .home3a-results article:first-child p {
    margin: 0;
  }
  .home3a-about__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }
  .home3a-about__media {
    position: relative;
    max-inline-size: none;
  }
  .home3a-about__media :global(img:not(.home3a-about__food)) {
    inline-size: 100%;
    block-size: 540px;
    object-fit: cover;
    border-radius: 24px;
  }
  :global(img.home3a-about__food) {
    position: absolute;
    inset-inline-end: 24px;
    inset-block-end: -32px;
    inline-size: 220px;
    block-size: 150px;
    object-fit: cover;
    border: 8px solid var(--ao-background);
    border-radius: 24px;
  }
  .home3a-about :global(.ao-heading) {
    font-size: 4rem;
  }
  .home3a-large {
    margin-block-start: var(--ao-space-24);
    font-size: 1.5625rem;
    font-weight: 500;
  }
  .home3a-about p + p,
  .home3a-about .ao-text-link {
    margin-block-start: var(--ao-space-24);
    display: inline-flex;
  }
  .home3a-section-head {
    max-inline-size: 720px;
    margin-block-end: var(--ao-space-40);
  }
  .home3a-groups {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ao-space-8);
    font-size: 0.875rem;
  }
  .home3a-groups a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--ao-target-min);
    padding-block: 10px;
    padding-inline: 16px;
    border: 1px solid var(--ao-line);
    border-radius: 999px;
  }
  .home3a-groups a[aria-current] {
    background: var(--ao-primary);
    border-color: var(--ao-primary);
    color: var(--ao-on-primary);
  }
  @media (hover: hover) and (pointer: fine) {
    .home3a-groups a:hover {
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }
  .home3a-reviews-lead {
    margin: 0;
    font-size: 0.875rem;
    color: var(--ao-muted);
  }
  .home3a-collection {
    margin-block-start: var(--ao-space-32);
  }
  .home3a-note {
    margin-block-start: var(--ao-space-16);
    font-size: 0.75rem;
    color: var(--ao-muted);
  }
  .home3a :global(.ao-carousel__footer) .home3a-note {
    margin: 0;
  }
  .home3a-facts {
    display: grid;
    gap: 12px;
    margin-block: var(--ao-space-32);
    margin-inline: 0;
    padding: 0;
    list-style: none;
    font-size: 0.8125rem;
  }
  .home3a-facts li {
    display: grid;
    grid-template-columns: 16px 1fr;
    align-items: center;
    gap: 12px;
  }
  .home3a-facts :global(.ao-deco-check) {
    inline-size: 12px;
    block-size: 12px;
    color: var(--ao-accent);
  }
  .home3a-price {
    font-size: 1.125rem;
    margin-block-end: var(--ao-space-24);
  }
  .home3a :global(#konsultacje-panel img) {
    inline-size: 100%;
    block-size: 520px;
    object-fit: cover;
    object-position: 70% center;
  }
  @container page3a (max-width: 1199px) {
    .home3a-portrait {
      block-size: 500px;
    }
  }
  @container page3a (max-width: 879px) {
    .home3a-why,
    .home3a-about__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--ao-space-40);
    }
    .home3a-audience__head {
      grid-template-columns: minmax(0, 1fr);
    }
    .home3a-audience__list,
    .home3a-audience__list:has(> li:nth-child(5)) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .home3a-why :global(.ao-heading),
    .home3a-audience__head :global(.ao-heading),
    .home3a-about :global(.ao-heading) {
      font-size: clamp(2.25rem, 8vw, 3.25rem);
    }
    .home3a-results {
      grid-template-columns: 1fr;
    }
    .home3a-results article:first-child {
      grid-column: auto;
      grid-template-columns: 1fr;
    }
    .home3a :global(.ao-hero .ao-lead) {
      font-size: 1rem;
    }
    .home3a-portrait {
      block-size: 450px;
    }
    .home3a-about__media :global(img:not(.home3a-about__food)) {
      block-size: 440px;
    }
    :global(img.home3a-about__food) {
      inset-inline-end: 16px;
      inset-block-end: -20px;
      inline-size: 176px;
      block-size: 125px;
      border-width: 6px;
    }
    .home3a :global(#konsultacje-panel img) {
      block-size: 390px;
      object-position: 75% center;
    }
  }
  @container page3a (max-width: 767px) {
    .home3a-count strong {
      font-size: 78px;
    }
    .home3a-portrait {
      block-size: 410px;
    }
    .home3a-about__media :global(img:not(.home3a-about__food)) {
      block-size: 440px;
      object-position: center 25%;
    }
    .home3a :global(#konsultacje-panel img) {
      block-size: 280px;
    }
  }
  @container page3a (max-width: 559px) {
    .home3a-audience__list,
    .home3a-audience__list:has(> li:nth-child(5)) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @container page3a (max-width: 374px) {
    .home3a-portrait {
      block-size: 340px;
    }
    .home3a-count strong {
      font-size: 64px;
    }
  }
</style>
