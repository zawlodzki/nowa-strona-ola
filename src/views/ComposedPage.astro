---
import type { Locale } from "@ola/shared";

import { consultationCopy } from "@/content/consultation-seed";
import { mapAbout } from "@/content/map-about";
import { mapConsultation } from "@/content/map-consultation";
import { mapHomepage, shellLinks } from "@/content/map-homepage";
import { homepageCopyright } from "@/sanity/homepage-fixtures";
import { pagePath } from "@/lib/paths";
import type { PageContent, SiteSettings } from "@/sanity/repository";
import Layout from "@/layouts/Layout.astro";
import SiteFooter from "@/ui/site-footer/SiteFooter.astro";
import SiteHeader from "@/ui/site-header/SiteHeader.astro";
import About3a from "@/views/About3a.astro";
import Consultation3a from "@/views/Consultation3a.astro";
import Homepage3a from "@/views/Homepage3a.astro";
import PageSections from "@/views/PageSections.astro";
import SiteShell3a from "@/views/SiteShell3a.astro";

export interface Props {
  lang: Locale;
  page: PageContent;
  settings: SiteSettings;
  section?: "home" | "page";
  preview?: boolean;
}

const {
  lang,
  page,
  settings,
  section = "page",
  preview = false,
} = Astro.props as Props;
const alternateHref = page.translation?.slug
  ? pagePath(
      page.translation.language === "en" ? "en" : "pl",
      page.translation.slug,
    )
  : null;
const isHome = page.slug === "home" || section === "home";
const isAbout = page.slug === "o-mnie" || page.slug === "about";
const isConsultation =
  page.slug === "konsultacje" || page.slug === "consultations";
const shell = shellLinks(settings);
const currentHref = pagePath(lang, page.slug);
const navigation = shell.navigation.map((item) => ({
  ...item,
  current: item.href === currentHref,
}));
const headerCta = isAbout
  ? shell.headerCta
    ? { ...shell.headerCta, href: "#newsletter" }
    : undefined
  : shell.headerCta;
const consultation = isConsultation ? mapConsultation(page, lang) : undefined;
const consultationLabels = consultationCopy[lang];
---

{isHome ? (
  <SiteShell3a
    lang={lang}
    title={page.seo?.title ?? page.title}
    description={page.seo?.description ?? undefined}
    preview={preview}
    footerNote={settings.footerNote ?? ""}
    copyright={homepageCopyright(lang)}
    languageHref={alternateHref}
    {...shell}
  >
    <Homepage3a lang={lang} content={mapHomepage(page, lang)} />
  </SiteShell3a>
) : isAbout ? (
  <SiteShell3a
    lang={lang}
    title={page.seo?.title ?? page.title}
    description={page.seo?.description ?? undefined}
    preview={preview}
    footerNote={settings.footerNote ?? ""}
    copyright={homepageCopyright(lang)}
    languageHref={alternateHref}
    navigation={navigation}
    headerCta={headerCta}
    socialLinks={shell.socialLinks}
    legalLinks={shell.legalLinks}
  >
    <About3a lang={lang} content={mapAbout(page, lang)} />
  </SiteShell3a>
) : consultation ? (
  <SiteShell3a
    lang={lang}
    title={page.seo?.title ?? page.title}
    description={page.seo?.description ?? undefined}
    preview={preview}
    footerNote={settings.footerNote ?? ""}
    copyright={homepageCopyright(lang)}
    languageHref={alternateHref}
    navigation={[...consultationLabels.navigation]}
    footerLinks={navigation}
    headerCta={{
      label: `${consultationLabels.headerCtaPrefix} · ${consultation.price.price} ${consultation.price.currencyLabel}`,
      href: "#cena",
    }}
    socialLinks={shell.socialLinks}
    legalLinks={shell.legalLinks}
  >
    <Consultation3a lang={lang} content={consultation} />
  </SiteShell3a>
) : (
  <Layout lang={lang} title={page.seo?.title ?? page.title}>
    <SiteHeader
      lang={lang}
      section={section}
      alternateHref={alternateHref}
      navigation={settings.navigation}
    />
    <main id="main">
      <PageSections lang={lang} sections={page.sections} />
    </main>
    <SiteFooter lang={lang} note={settings.footerNote ?? undefined} />
  </Layout>
)}
