---
import type { Locale } from "@ola/shared";
import type { PageContent, SiteSettings } from "@/sanity/repository";
export interface Props {
  lang: Locale;
  page: PageContent;
  settings: SiteSettings;
  section?: "home" | "page";
  preview?: boolean;
}
const { page, section } = Astro.props;
// Import only the selected template, including in the protected preview.
const { default: Page } =
  page.slug === "home" || section === "home"
    ? await import("./HomePage.astro")
    : page.slug === "o-mnie" || page.slug === "about"
      ? await import("./AboutPage.astro")
      : page.slug === "konsultacje" || page.slug === "consultations"
        ? await import("./ConsultationPage.astro")
        : page.slug === "kontakt" || page.slug === "contact"
          ? await import("./ContactPage.astro")
          : await import("./LegacyPage.astro");
---

<Page {...Astro.props} />
