---
import Breadcrumbs from "@/design-system/components/Breadcrumbs.astro";
import Button from "@/design-system/components/Button.astro";
import Container from "@/design-system/components/Container.astro";
import DemoForm from "@/design-system/components/DemoForm.astro";
import Newsletter from "@/design-system/components/Newsletter.astro";
import PriceGross from "@/design-system/components/PriceGross.astro";
import SiteImage from "@/design-system/components/SiteImage.astro";
import TextLink from "@/design-system/components/TextLink.astro";
import BookCover from "@/design-system/components/BookCover.astro";
import ArrowIcon from "@/design-system/components/ArrowIcon.astro";
import BookCoverArt from "@/design-system/decorations/BookCoverArt.astro";
import CoverStage from "@/design-system/decorations/CoverStage.astro";
import CloseGlyph from "@/design-system/decorations/CloseGlyph.astro";
import FacebookGlyph from "@/design-system/decorations/FacebookGlyph.astro";
import LinkGlyph from "@/design-system/decorations/LinkGlyph.astro";
import MailGlyph from "@/design-system/decorations/MailGlyph.astro";
import MailIcon from "@/design-system/decorations/MailIcon.astro";
import PlusToggle from "@/design-system/decorations/PlusToggle.astro";
import ShareNetwork from "@/design-system/decorations/ShareNetwork.astro";
import WhatsAppGlyph from "@/design-system/decorations/WhatsAppGlyph.astro";
import { articleBodyToHtml, markArticleIntro } from "@/content/portable-text";
import type { Article3aView } from "@/content/map-article";
import { homepageMediaKeys } from "@/content/homepage-seed";
import { ebookCoverArt, ebookCoverLabels } from "@/lib/ebook-covers";
import { currencyLabel, topicLabel } from "@/lib/offer";

export interface Props {
  content: Article3aView;
  preview?: boolean;
}

const { content, preview = false } = Astro.props;
const lang = content.language;
const pl = lang === "pl";
const { html } = articleBodyToHtml(content.body);
const bodyHtml = markArticleIntro(html);
---

<main id="main" class="article3a">
  <script
    type="application/ld+json"
    id={content.faq ? "article-faq-schema" : undefined}
    is:inline
    set:html={JSON.stringify(content.jsonLd)}
  ></script>
  <div class="article-heading" id="start">
    <Container>
      <Breadcrumbs
        label={content.breadcrumbLabel}
        links={content.breadcrumbs}
      />
      <h1>{content.title}</h1>
      <p class="article-deck">{content.lead}</p>
      <div class="article-meta">
        <a class="byline" href={content.byline.href}>
          <SiteImage
            src={content.byline.photo.src}
            fallback={content.byline.photo.fallback}
            alt={content.byline.photo.alt}
            width={content.byline.photo.width}
            height={content.byline.photo.height}
            objectPosition={content.byline.photo.objectPosition}
            loading="eager"
            decoding="sync"
          />
          <span>
            <strong>{content.byline.name}</strong>
            <span>{content.byline.role}</span>
          </span>
        </a>
        <div class="article-dates">
          <span>
            {content.publishedCaption}
            <time datetime={content.publishedAt}>{content.publishedLabel}</time>
          </span>
          {content.updatedAt && content.updatedLabel && (
            <span>
              {content.updatedCaption}
              <time datetime={content.updatedAt}>{content.updatedLabel}</time>
            </span>
          )}
        </div>
      </div>
    </Container>
  </div>
  <figure class="article-main-image">
    <Container>
      <SiteImage
        src={content.hero.src}
        fallback={content.hero.fallback}
        alt={content.hero.alt}
        width={content.hero.width}
        height={content.hero.height}
        objectPosition={content.hero.objectPosition}
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
      {content.hero.caption && <figcaption>{content.hero.caption}</figcaption>}
    </Container>
  </figure>
  <Container>
    <div class="article-layout">
      <aside class="article-toc">
        {content.toc.length > 0 && (
          <nav aria-labelledby="toc-title">
            <details open>
              <summary id="toc-title">{content.tocLabel}</summary>
              <ol>
                {content.toc.map((entry) => (
                  <li>
                    <a href={`#${entry.id}`}>{entry.text}</a>
                  </li>
                ))}
              </ol>
            </details>
          </nav>
        )}
        {!preview && (
          <div
            class="article-share"
            data-share-path={content.share.canonicalUrl}
            data-share-title={content.share.title}
            data-copied={content.share.copied}
            data-failed={content.share.copyFailed}
          >
            <button
              class="share-trigger"
              type="button"
              aria-expanded="false"
              aria-controls="share-options"
              disabled
            >
              <ShareNetwork />
              {content.share.trigger}
            </button>
            <div
              id="share-options"
              class="share-options"
              popover="auto"
              role="dialog"
              aria-label={content.share.dialog}
            >
              <div class="share-options-heading">
                <strong>{content.share.dialog}</strong>
                <button
                  class="share-close"
                  type="button"
                  aria-label={content.share.close}
                >
                  <CloseGlyph />
                </button>
              </div>
              <div class="share-actions">
                <button class="share-option" type="button" data-share="copy">
                  <LinkGlyph />
                  <span>{content.share.copy}</span>
                </button>
                <a class="share-option" data-share="email">
                  <MailGlyph />
                  <span>{content.share.email}</span>
                </a>
                <a
                  class="share-option"
                  data-share="facebook"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <FacebookGlyph />
                  <span>{content.share.facebook}</span>
                </a>
                <a
                  class="share-option"
                  data-share="whatsapp"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <WhatsAppGlyph />
                  <span>{content.share.whatsapp}</span>
                </a>
              </div>
              <p class="share-status" role="status" aria-live="polite"></p>
              <div class="share-copy-fallback" hidden>
                <label for="share-url">{content.share.manual}</label>
                <input id="share-url" type="url" readonly />
              </div>
            </div>
          </div>
        )}
      </aside>
      <div class="article-center">
        <article
          class="article-richtext"
          aria-label={pl ? "Treść artykułu" : "Article body"}
        >
          {content.proposalNote && (
            <p class="sample-note">{content.proposalNote}</p>
          )}
          <Fragment set:html={bodyHtml} />
        </article>
        {content.sources.length > 0 && (
          <section
            class="article-sources"
            aria-labelledby="article-sources-title"
          >
            <h2 id="article-sources-title">{content.sourcesLabel}</h2>
            <ol>
              {content.sources.map((source) => (
                <li>
                  <a href={source.href} rel="noreferrer">
                    {source.title}
                  </a>
                </li>
              ))}
            </ol>
          </section>
        )}
        {content.authors.map((person) => (
          <section class="author-box" id="autor" aria-labelledby="author-title">
            <SiteImage
              src={person.photo.src}
              fallback={person.photo.fallback}
              alt={person.photo.alt}
              width={person.photo.width}
              height={person.photo.height}
              objectPosition={person.photo.objectPosition}
              decoding="sync"
            />
            <div>
              <h2 id="author-title">{person.name}</h2>
              <p class="author-role">{person.role}</p>
              <p>{person.bio}</p>
              <TextLink href={person.aboutHref}>{person.aboutLabel}</TextLink>
            </div>
          </section>
        ))}
      </div>
      {(content.sidebar || content.recommendations) && (
        <aside class="article-sidebar" aria-label={content.sidebarLabel}>
          {content.sidebar && (
            <section class="article-newsletter" aria-labelledby="sidebar-title">
              <div class="sidebar-panel">
                <MailIcon />
                <h2 id="sidebar-title">{content.sidebar.title}</h2>
                <p>{content.sidebar.lead}</p>
                <Button as="a" href="#newsletter">
                  {content.sidebar.actionLabel}
                </Button>
                <p class="sidebar-note">{content.sidebar.note}</p>
              </div>
            </section>
          )}
          {content.recommendations && (
            <aside
              class="article-recommendations"
              aria-label={content.recommendationsLabel}
            >
              <button
                class="recommendations-trigger"
                type="button"
                aria-expanded="true"
                aria-controls="recommended-articles"
                disabled
              >
                <span>{content.recommendationsLabel}</span>
                <PlusToggle
                  class="ao-icon ui-icon"
                  plusClass="recommendation-plus"
                />
              </button>
              <div id="recommended-articles">
                {content.recommendations.map((item) => (
                  <a href={item.href}>
                    <span>{item.kicker}</span>
                    <strong>{item.title}</strong>
                    <ArrowIcon />
                  </a>
                ))}
              </div>
            </aside>
          )}
        </aside>
      )}
    </div>
  </Container>
  {content.ebooks && (
    <section
      class="article-books section"
      id="ebooki"
      aria-labelledby="books-title"
    >
      <Container>
        <div class="section-heading">
          <div>
            <h2 id="books-title">{content.ebooks.title}</h2>
            <p>{content.ebooks.lead}</p>
          </div>
          <TextLink href={content.ebooks.allHref}>
            {content.ebooks.allLabel}
          </TextLink>
        </div>
        <div class="related-books">
          {content.ebooks.items.map((item) => {
            const art = ebookCoverArt(item.slug);
            return (
              <article class="book-card" data-book-topic={item.topic}>
                <a class="cover-link" href={item.href}>
                  <CoverStage variant={art.variant}>
                    <BookCover
                      title={item.title}
                      subtitle={item.subtitle ?? ""}
                      author={item.authorName}
                      topic={content.ebooks!.coverTopic}
                      tone={item.coverTone}
                    >
                      <BookCoverArt
                        slot="art"
                        kind={art.kind}
                        labels={ebookCoverLabels(art.kind, lang)}
                        imageSrc={
                          art.kind === "nutrition"
                            ? homepageMediaKeys.food
                            : undefined
                        }
                      />
                    </BookCover>
                  </CoverStage>
                </a>
                <div class="book-meta">
                  <span>{topicLabel(item.topic, lang)}</span>
                  <span>E-book</span>
                </div>
                <h3>
                  <a href={item.href}>{item.title}</a>
                </h3>
                <p>{item.description}</p>
                <div class="book-action">
                  <PriceGross
                    amount={item.priceGross}
                    unit={currencyLabel(item.currency, lang)}
                    note={pl ? "brutto" : "gross"}
                  />
                  <TextLink href={item.href}>
                    {content.ebooks!.actionLabel}
                  </TextLink>
                </div>
              </article>
            );
          })}
        </div>
        <p class="mock-note">{content.ebooks.note}</p>
      </Container>
    </section>
  )}
  {content.faq && (
    <section class="article-faq section" id="faq" aria-labelledby="faq-title">
      <Container>
        <div class="faq-intro">
          <h2 id="faq-title">{content.faq.title}</h2>
          <p>{content.faq.lead}</p>
          {content.faq.note && <p class="mock-note">{content.faq.note}</p>}
        </div>
        <div class="article-faq-list">
          {content.faq.items.map((item, index) => (
            <details open={index === 0}>
              <summary>
                <span>{item.question}</span>
                <PlusToggle class="faq-toggle" />
              </summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </Container>
    </section>
  )}
  {content.newsletter && (
    <Newsletter
      id="newsletter"
      title={content.newsletter.title}
      description={content.newsletter.lead}
    >
      <DemoForm slot="form" content={content.newsletter} lang={lang} />
    </Newsletter>
  )}
</main>

<script>
  function enhanceShare(
    shareRoot: HTMLElement,
    shareTrigger: HTMLButtonElement,
    sharePanel: HTMLElement,
    copyAction: HTMLButtonElement,
    shareStatus: HTMLElement,
    shareFallback: HTMLElement,
    shareInput: HTMLInputElement,
  ) {
    const shareUrl = new URL(
      shareRoot.dataset.sharePath || window.location.pathname,
      window.location.origin,
    );
    shareUrl.hash = "";
    shareUrl.search = "";
    const articleTitle = shareRoot.dataset.shareTitle || "";
    const encodedUrl = encodeURIComponent(shareUrl.href);
    const email = document.querySelector('[data-share="email"]');
    const facebook = document.querySelector('[data-share="facebook"]');
    const whatsapp = document.querySelector('[data-share="whatsapp"]');
    if (email instanceof HTMLAnchorElement) {
      email.href = `mailto:?subject=${encodeURIComponent(articleTitle)}&body=${encodeURIComponent(`${articleTitle}\n${shareUrl.href}`)}`;
    }
    if (facebook instanceof HTMLAnchorElement) {
      facebook.href = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
    }
    if (whatsapp instanceof HTMLAnchorElement) {
      whatsapp.href = `https://wa.me/?text=${encodeURIComponent(`${articleTitle}\n${shareUrl.href}`)}`;
    }
    shareInput.value = shareUrl.href;
    shareTrigger.disabled = false;
    let closeTimer: number | undefined;
    let sharePinned = false;
    const shareOpen = () => sharePanel.matches(":popover-open");
    function positionShare() {
      if (!shareOpen()) return;
      const rect = shareTrigger.getBoundingClientRect();
      const belowSpace = Math.max(1, window.innerHeight - rect.bottom - 24);
      const aboveSpace = Math.max(1, rect.top - 24);
      const placeBelow =
        sharePanel.scrollHeight <= belowSpace || belowSpace >= aboveSpace;
      sharePanel.style.maxHeight = `${placeBelow ? belowSpace : aboveSpace}px`;
      const panelHeight = sharePanel.getBoundingClientRect().height;
      const panelWidth = sharePanel.getBoundingClientRect().width;
      const left = Math.max(
        16,
        Math.min(rect.left, window.innerWidth - panelWidth - 16),
      );
      const top = placeBelow
        ? rect.bottom + 8
        : Math.max(16, rect.top - panelHeight - 8);
      sharePanel.style.left = `${left}px`;
      sharePanel.style.top = `${top}px`;
    }
    function openShare() {
      window.clearTimeout(closeTimer);
      if (!shareOpen()) sharePanel.showPopover();
      shareTrigger.setAttribute("aria-expanded", "true");
      positionShare();
    }
    function closeShare(restoreFocus = false) {
      window.clearTimeout(closeTimer);
      if (shareOpen()) sharePanel.hidePopover();
      sharePinned = false;
      shareTrigger.setAttribute("aria-expanded", "false");
      if (restoreFocus) shareTrigger.focus();
    }
    function scheduleClose() {
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(() => {
        if (!sharePinned && !sharePanel.contains(document.activeElement))
          closeShare();
      }, 180);
    }
    shareTrigger.addEventListener("pointerenter", (event) => {
      if (event.pointerType === "mouse") openShare();
    });
    shareTrigger.addEventListener("pointerleave", scheduleClose);
    sharePanel.addEventListener("pointerenter", () =>
      window.clearTimeout(closeTimer),
    );
    sharePanel.addEventListener("pointerleave", scheduleClose);
    shareTrigger.addEventListener("click", (event) => {
      if (shareOpen() && sharePinned) closeShare();
      else {
        sharePinned = true;
        openShare();
        if (event.detail === 0) copyAction.focus();
      }
    });
    sharePanel.addEventListener("toggle", () => {
      shareTrigger.setAttribute("aria-expanded", String(shareOpen()));
      if (!shareOpen()) sharePinned = false;
    });
    sharePanel.addEventListener("focusout", (event) => {
      if (!event.relatedTarget) return;
      window.setTimeout(() => {
        if (
          !sharePanel.contains(document.activeElement) &&
          document.activeElement !== shareTrigger
        )
          closeShare();
      }, 0);
    });
    document
      .querySelector(".share-close")
      ?.addEventListener("click", () => closeShare(true));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && shareOpen()) {
        event.preventDefault();
        closeShare(
          sharePanel.contains(document.activeElement) ||
            document.activeElement === shareTrigger,
        );
      }
    });
    copyAction.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(shareUrl.href);
        shareStatus.textContent = shareRoot.dataset.copied || "";
        shareFallback.hidden = true;
        positionShare();
      } catch {
        shareStatus.textContent = shareRoot.dataset.failed || "";
        shareFallback.hidden = false;
        positionShare();
        shareInput.focus();
        shareInput.select();
      }
    });
    window.addEventListener("scroll", positionShare, { passive: true });
    window.addEventListener("resize", positionShare);
  }

  function enhanceRecommendations(
    recommendations: HTMLElement,
    recommendationsTrigger: HTMLButtonElement,
    recommendationsList: HTMLElement,
    articleBody: HTMLElement,
  ) {
    recommendations.hidden = true;
    recommendations.dataset.enhanced = "true";
    recommendationsTrigger.disabled = false;
    recommendationsTrigger.addEventListener("click", () => {
      recommendationsTrigger.focus({ preventScroll: true });
      const expanded =
        recommendationsTrigger.getAttribute("aria-expanded") !== "true";
      recommendationsTrigger.setAttribute("aria-expanded", String(expanded));
      recommendationsList.hidden = !expanded;
    });
    let scrollPending = false;
    function updateReadingProgress() {
      const rect = articleBody.getBoundingClientRect();
      const reachedHalf = window.innerHeight / 2 >= rect.top + rect.height / 2;
      recommendations.hidden =
        !reachedHalf && !recommendations.contains(document.activeElement);
      scrollPending = false;
    }
    function queueReadingProgress() {
      if (scrollPending) return;
      scrollPending = true;
      requestAnimationFrame(updateReadingProgress);
    }
    recommendations.addEventListener("focusout", queueReadingProgress);
    window.addEventListener("scroll", queueReadingProgress, { passive: true });
    window.addEventListener("resize", queueReadingProgress);
    new ResizeObserver(queueReadingProgress).observe(articleBody);
    document.fonts.ready.then(queueReadingProgress);
    updateReadingProgress();
  }

  const shareRoot = document.querySelector(".article-share");
  const shareTrigger = document.querySelector(".share-trigger");
  const sharePanel = document.querySelector("#share-options");
  const copyAction = document.querySelector('[data-share="copy"]');
  const shareStatus = document.querySelector(".share-status");
  const shareFallback = document.querySelector(".share-copy-fallback");
  const shareInput = document.querySelector("#share-url");
  if (
    shareRoot instanceof HTMLElement &&
    shareTrigger instanceof HTMLButtonElement &&
    sharePanel instanceof HTMLElement &&
    copyAction instanceof HTMLButtonElement &&
    shareStatus instanceof HTMLElement &&
    shareFallback instanceof HTMLElement &&
    shareInput instanceof HTMLInputElement
  ) {
    enhanceShare(
      shareRoot,
      shareTrigger,
      sharePanel,
      copyAction,
      shareStatus,
      shareFallback,
      shareInput,
    );
  }

  const recommendations = document.querySelector(".article-recommendations");
  const recommendationsTrigger = document.querySelector(
    ".recommendations-trigger",
  );
  const recommendationsList = document.querySelector("#recommended-articles");
  const articleBody = document.querySelector(".article-richtext");
  if (
    recommendations instanceof HTMLElement &&
    recommendationsTrigger instanceof HTMLButtonElement &&
    recommendationsList instanceof HTMLElement &&
    articleBody instanceof HTMLElement
  ) {
    enhanceRecommendations(
      recommendations,
      recommendationsTrigger,
      recommendationsList,
      articleBody,
    );
  }
</script>

<style>
  /* Szablon artykułu dziedziczy paletę, font i elementy 3a. */
  .article3a ::selection {
    background: var(--ao-surface);
    color: var(--ao-ink);
  }
  .article3a input {
    caret-color: var(--ao-primary);
  }
  .article3a .desktop-nav [aria-current] {
    text-decoration: underline;
    text-underline-offset: 6px;
  }
  .article-heading {
    padding-top: 32px;
  }
  .breadcrumbs {
    font-size: 13px;
    color: var(--ao-muted);
  }
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .breadcrumbs li + li::before {
    content: "/";
    margin-right: 16px;
    color: var(--ao-line);
  }
  .breadcrumbs a:hover {
    text-decoration: underline;
  }
  .article3a h1 {
    max-width: 1000px;
    margin: 52px auto 24px;
    font-size: clamp(36px, 5.2vw, 76px);
    line-height: 1.05;
    letter-spacing: -0.04em;
    text-align: center;
  }
  .article-deck {
    max-width: 650px;
    margin: auto;
    text-align: center;
    color: var(--ao-muted);
    font-size: 20px;
  }
  .article-meta {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px 40px;
    margin: 32px 0 40px;
    font-size: 13px;
  }
  .byline {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .byline :global(img) {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 25%;
  }
  .byline span span {
    display: block;
    color: var(--ao-muted);
  }
  .article-dates {
    display: grid;
    gap: 4px;
    padding-left: 32px;
    border-left: 1px solid var(--ao-line);
    color: var(--ao-muted);
    font-variant-numeric: tabular-nums;
  }
  .article-dates time {
    color: var(--ao-ink);
    margin-left: 8px;
  }
  .article-main-image :global(img) {
    width: 100%;
    height: clamp(240px, 34vw, 480px);
    border-radius: var(--ao-radius-panel);
    object-fit: cover;
    object-position: center 55%;
  }
  .article-main-image figcaption {
    margin-top: 12px;
    color: var(--ao-muted);
    font-size: 13px;
    text-align: right;
  }
  .article-layout {
    display: grid;
    grid-template-columns: minmax(150px, 0.8fr) minmax(0, 2.8fr) minmax(
        200px,
        1fr
      );
    gap: 48px;
    align-items: start;
    padding-top: 64px;
  }
  .article-layout > * {
    min-width: 0;
  }
  .article-toc,
  .article-sidebar {
    position: sticky;
    top: 32px;
  }
  .article-sidebar {
    max-height: calc(100dvh - 64px);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--ao-line) transparent;
  }
  .article-toc summary {
    font-weight: 650;
    font-size: 16px;
    cursor: pointer;
    padding: 4px 0 16px;
  }
  .article-toc ol {
    padding: 0;
    margin: 0;
    list-style: none;
    border-top: 1px solid var(--ao-line);
  }
  .article-toc a {
    display: block;
    padding: 14px 0;
    color: var(--ao-muted);
    font-size: 14px;
    line-height: 1.45;
    border-bottom: 1px solid var(--ao-line);
  }
  .article-toc a:hover {
    color: var(--ao-primary);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .article-richtext {
    font-size: 18px;
    line-height: 1.8;
  }
  .article-richtext > :global(p) {
    margin-bottom: 24px;
  }
  .article-richtext :global(.article-intro) {
    font-size: 22px;
    line-height: 1.6;
    font-weight: 500;
  }
  .article-richtext .sample-note {
    font-size: 13px;
    line-height: 1.5;
    color: var(--ao-muted);
    margin-bottom: 24px;
  }
  .article-richtext :global(h2) {
    margin: 56px 0 20px;
    font-size: 34px;
    letter-spacing: -0.03em;
    line-height: 1.15;
    scroll-margin-top: 32px;
  }
  .article-richtext :global(h2:focus-visible) {
