---
import type { Locale } from "@ola/shared";

import Breadcrumbs from "@/design-system/components/Breadcrumbs.astro";
import Button from "@/design-system/components/Button.astro";
import Container from "@/design-system/components/Container.astro";
import DemoForm from "@/design-system/components/DemoForm.astro";
import Heading from "@/design-system/components/Heading.astro";
import Newsletter from "@/design-system/components/Newsletter.astro";
import SiteImage from "@/design-system/components/SiteImage.astro";
import TextLink from "@/design-system/components/TextLink.astro";
import ArrowIcon from "@/design-system/components/ArrowIcon.astro";
import type {
  BlogCollectionView,
  BlogPostCard,
} from "@/content/map-blog-collection";
import { toDatetime } from "@/lib/dates";

export interface Props {
  lang: Locale;
  content: BlogCollectionView;
}

const { lang, content } = Astro.props;
const pl = lang === "pl";
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      name: content.title.replaceAll("\n", " "),
      description: content.lead,
      url: content.href,
    },
    {
      "@type": "ItemList",
      itemListElement: [
        ...(content.latest ? [content.latest] : []),
        ...content.items,
      ].map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        url: item.href,
        name: item.title,
      })),
    },
  ],
};

function readAria(item: BlogPostCard) {
  return `${content.readActionLabel}: ${item.title}`;
}
---

<main id="main" class="blog3a">
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  ></script>
  <section class="blog3a-heading" aria-labelledby="blog-title">
    <Container>
      <Breadcrumbs
        label={pl ? "Ścieżka nawigacji" : "Breadcrumb"}
        links={content.breadcrumbs}
      />
      <Heading as="h1" size="display" id="blog-title" class="blog3a-title">
        {content.title}
      </Heading>
      <p class="blog3a-lead">{content.lead}</p>
      {content.note && <p class="blog3a-note">{content.note}</p>}
      <nav
        class="blog3a-categories"
        aria-label={pl ? "Kategorie" : "Categories"}
      >
        {content.categories.map((category) => (
          <a
            href={category.href}
            aria-current={category.current ? "page" : undefined}
          >
            {category.title}
          </a>
        ))}
      </nav>
    </Container>
  </section>

  {content.isEmpty ? (
    <section
      class="blog3a-collection"
      id="wpisy"
      aria-labelledby="collection-title"
    >
      <Container>
        <h2 class="blog3a-section-title" id="collection-title">
          {content.collectionTitle}
        </h2>
        <p class="blog3a-empty">{content.emptyMessage}</p>
      </Container>
    </section>
  ) : content.isCategoryEmpty ? (
    <section
      class="blog3a-collection"
      id="wpisy"
      aria-labelledby="collection-title"
    >
      <Container>
        <h2 class="blog3a-section-title" id="collection-title">
          {content.category?.title ?? content.collectionTitle}
        </h2>
        <p class="blog3a-empty">{content.emptyCategoryMessage}</p>
      </Container>
    </section>
  ) : (
    <>
      {content.latest && (
        <section class="blog3a-featured" aria-labelledby="latest-title">
          <Container>
            <h2 class="blog3a-section-title" id="latest-title">
              {content.latestTitle}
            </h2>
            <article class="blog3a-featured-post">
              <a
                class="blog3a-featured-image"
                href={content.latest.href}
                aria-label={readAria(content.latest)}
              >
                <SiteImage
                  src={content.latest.imageSrc}
                  alt={content.latest.imageAlt}
                  width={content.latest.imageWidth}
                  height={content.latest.imageHeight}
                  objectPosition={content.latest.objectPosition}
                  loading="eager"
                  fetchpriority="high"
                />
              </a>
              <div class="blog3a-featured-copy">
                <p class="blog3a-meta">
                  {content.latest.categoryLabel && (
                    <span>{content.latest.categoryLabel}</span>
                  )}
                  <time datetime={toDatetime(content.latest.publishedAt)}>
                    {content.latest.dateLabel}
                  </time>
                </p>
                <h3>
                  <a href={content.latest.href}>{content.latest.title}</a>
                </h3>
                <p class="blog3a-description">{content.latest.lead}</p>
                <Button as="a" href={content.latest.href} arrow>
                  {content.readActionLabel}
                </Button>
              </div>
            </article>
          </Container>
        </section>
      )}
      <section
        class="blog3a-collection"
        id="wpisy"
        aria-labelledby="collection-title"
      >
        <Container>
          <div class="blog3a-collection-heading">
            <h2 class="blog3a-section-title" id="collection-title">
              {content.collectionTitle}
            </h2>
            {content.rangeLabel && <p>{content.rangeLabel}</p>}
          </div>
          {content.items.length > 0 && (
            <div class="blog3a-grid">
              {content.items.map((item) => (
                <article class="blog3a-card">
                  <a
                    class:list={[
                      "blog3a-card-image",
                      `blog3a-card-image--${item.frame}`,
                    ]}
                    href={item.href}
                    aria-label={readAria(item)}
                  >
                    <SiteImage
                      src={item.imageSrc}
                      alt={item.imageAlt}
                      width={item.imageWidth}
                      height={item.imageHeight}
                      objectPosition={item.objectPosition}
                      loading="eager"
                    />
                  </a>
                  <p class="blog3a-meta">
                    {item.categoryLabel && <span>{item.categoryLabel}</span>}
                    <time datetime={toDatetime(item.publishedAt)}>
                      {item.dateLabel}
                    </time>
                  </p>
                  <h3>
                    <a href={item.href}>{item.title}</a>
                  </h3>
                  <p class="blog3a-description">{item.lead}</p>
                  <TextLink href={item.href} aria-label={readAria(item)}>
                    {item.readLabel}
                  </TextLink>
                </article>
              ))}
            </div>
          )}
          {content.pagination && (
            <>
              <nav
                class="blog3a-pagination"
                aria-label={content.paginationLabel}
              >
                {content.pagination.prevHref ? (
                  <a
                    class="blog3a-direction"
                    href={content.pagination.prevHref}
                  >
                    <ArrowIcon direction="chevron-left" />
                    {content.previousLabel}
                  </a>
                ) : (
                  <span
                    class="blog3a-direction is-disabled"
                    aria-disabled="true"
                  >
                    <ArrowIcon direction="chevron-left" />
                    {content.previousLabel}
                  </span>
                )}
                <div class="blog3a-page-numbers">
                  {content.pagination.pages.map((page) => (
                    <a
                      class="blog3a-page-number"
                      href={page.href}
                      aria-label={`${content.pageLabel} ${page.page}`}
                      aria-current={page.current ? "page" : undefined}
                    >
                      {page.page}
                    </a>
                  ))}
                </div>
                {content.pagination.nextHref ? (
                  <a
                    class="blog3a-direction"
                    href={content.pagination.nextHref}
                  >
                    {content.nextLabel}
                    <ArrowIcon direction="chevron-right" />
                  </a>
                ) : (
                  <span
                    class="blog3a-direction is-disabled"
                    aria-disabled="true"
                  >
                    {content.nextLabel}
                    <ArrowIcon direction="chevron-right" />
                  </span>
                )}
              </nav>
              <p class="blog3a-page-status">{content.pageStatus}</p>
            </>
          )}
        </Container>
      </section>
    </>
  )}

  {content.newsletter && (
    <Newsletter
      id="newsletter"
      title={content.newsletter.title}
      description={content.newsletter.lead}
    >
      <DemoForm slot="form" content={content.newsletter} lang={lang} />
    </Newsletter>
  )}
</main>

<style>
  .blog3a :global(.ao-breadcrumbs) {
    margin-bottom: 40px;
  }
  .blog3a-heading {
    padding-block: 32px 56px;
  }
  .blog3a-title {
    font-size: clamp(42px, 6vw, 84px);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }
  .blog3a-lead {
    max-width: 650px;
    margin-top: 24px;
    color: var(--ao-muted);
    font-size: 20px;
  }
  .blog3a-note {
    margin-top: 16px;
    color: var(--ao-muted);
    font-size: 13px;
  }
  .blog3a-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
    margin-top: 24px;
    font-size: 13px;
  }
  .blog3a-categories a {
    color: var(--ao-muted);
  }
  .blog3a-categories a:hover,
  .blog3a-categories a[aria-current] {
    color: var(--ao-primary);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .blog3a-section-title {
    font-size: 28px;
    line-height: 1.2;
    letter-spacing: -0.03em;
    font-weight: 650;
  }
  .blog3a-featured :global(.ao-container) > .blog3a-section-title {
    margin-bottom: 24px;
  }
  .blog3a-featured-post {
    display: grid;
    grid-template-columns: 1.08fr 1fr;
    align-items: stretch;
    width: 100%;
    max-width: 100%;
    border-radius: var(--ao-radius-panel);
    overflow: hidden;
    isolation: isolate;
    background: var(--ao-surface);
  }
  .blog3a-featured-image {
    display: grid;
    min-width: 0;
    min-height: 400px;
    overflow: hidden;
  }
  .blog3a-featured-image :global(img) {
    width: 100%;
    height: 100%;
    min-height: 0;
    max-width: none;
    object-fit: cover;
  }
  .blog3a-featured-copy {
    min-width: 0;
    padding: 44px;
    align-self: center;
  }
  .blog3a-featured-copy h3 {
    margin-top: 24px;
    font-size: clamp(28px, 3.1vw, 44px);
    line-height: 1.12;
    font-weight: 650;
    letter-spacing: -0.03em;
    max-width: none;
  }
  .blog3a-featured-copy :global(.ao-button) {
    padding-inline: 16px;
    gap: 12px;
    max-width: 100%;
    margin-top: 28px;
    white-space: normal;
    text-align: left;
  }
  .blog3a-collection {
    padding-block: 64px 80px;
  }
  .blog3a-collection-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding-block: 24px;
    border-top: 1px solid var(--ao-line);
  }
  .blog3a-collection-heading > p,
  .blog3a-page-status {
    color: var(--ao-muted);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }
  .blog3a-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 56px 40px;
  }
  .blog3a-card-image {
    display: grid;
    aspect-ratio: 1.8;
    border-radius: var(--ao-radius-panel);
    overflow: hidden;
    isolation: isolate;
    background: var(--ao-surface);
  }
  .blog3a-card-image :global(img) {
    width: 100%;
    height: 100%;
    min-height: 0;
    max-width: none;
    object-fit: cover;
  }
  .blog3a-card-image--food-close :global(img) {
    object-position: 75% 70%;
  }
  .blog3a-card-image--portrait :global(img),
  .blog3a-card-image--portrait-close :global(img) {
    object-position: center 15%;
  }
  .blog3a-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    color: var(--ao-muted);
    font-size: 13px;
  }
  .blog3a-meta > span {
    color: var(--ao-primary);
    font-weight: 600;
  }
  .blog3a-card .blog3a-meta {
    margin-top: 24px;
  }
  .blog3a-card h3 {
    max-width: 29ch;
    margin-top: 12px;
    font-size: 29px;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .blog3a-description {
    max-width: 58ch;
    margin-top: 16px;
    color: var(--ao-muted);
    font-size: 17px;
  }
  .blog3a-card :global(.ao-text-link) {
    margin-top: 20px;
  }
  .blog3a-card h3 a:hover,
  .blog3a-featured-copy h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .blog3a-card-image:focus-visible,
  .blog3a-featured-image:focus-visible {
    outline-offset: -6px;
  }
  .blog3a-empty {
    margin-top: 24px;
    color: var(--ao-muted);
    font-size: 17px;
    max-width: 46ch;
  }
  .blog3a-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px 32px;
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid var(--ao-line);
  }
  .blog3a-direction {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    padding: 12px 16px;
    border: 1px solid var(--ao-line);
    border-radius: var(--ao-radius-control);
    font-size: 14px;
  }
  .blog3a-page-numbers {
    display: flex;
    gap: 8px;
  }
  .blog3a-page-number {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--ao-line);
    border-radius: 50%;
    font-variant-numeric: tabular-nums;
  }
  .blog3a-page-number[aria-current] {
    border-color: var(--ao-primary);
    background: var(--ao-primary);
    color: var(--ao-on-primary);
  }
  .blog3a-direction:hover,
  .blog3a-page-number:not([aria-current]):hover {
    border-color: var(--ao-primary);
    background: var(--ao-surface);
  }
  .is-disabled {
    color: var(--ao-muted);
    border-color: transparent;
  }
  .blog3a-direction.is-disabled:hover {
    background: transparent;
    border-color: transparent;
  }
  .blog3a-page-status {
    margin-top: 16px;
    text-align: center;
  }
  @media (prefers-reduced-motion: reduce) {
    .blog3a-card :global(.ao-text-link .ao-icon) {
      transition: none;
      transform: none;
    }
  }
  @container page3a (max-width: 999px) {
    .blog3a-featured-copy {
      padding: 32px;
    }
    .blog3a-featured-image {
      min-height: 360px;
    }
    .blog3a-grid {
      gap: 48px 28px;
    }
    .blog3a-card h3 {
      font-size: 25px;
    }
  }
  @container page3a (max-width: 767px) {
    .blog3a-heading {
      padding-block: 24px 40px;
    }
    .blog3a :global(.ao-breadcrumbs) {
      margin-bottom: 28px;
    }
    .blog3a-lead {
      font-size: 18px;
    }
    .blog3a-section-title {
      font-size: 25px;
    }
    .blog3a-featured-post,
    .blog3a-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .blog3a-featured-image {
      min-height: 0;
      height: auto;
      aspect-ratio: 1.4;
    }
    .blog3a-featured-copy {
      padding: 28px 24px;
    }
    .blog3a-featured-copy h3 {
      font-size: 29px;
      margin-top: 20px;
    }
    .blog3a-collection {
      padding-block: 48px;
    }
    .blog3a-grid {
      gap: 40px;
    }
    .blog3a-card h3 {
      font-size: 26px;
    }
    .blog3a-card .blog3a-meta {
      margin-top: 20px;
    }
    .blog3a-pagination {
      gap: 12px;
      margin-top: 40px;
      padding-top: 24px;
    }
    .blog3a-direction {
      font-size: 13px;
      padding-inline: 12px;
      gap: 6px;
    }
    .blog3a-direction :global(.ao-icon) {
      width: 18px;
      height: 18px;
    }
    .blog3a-page-number {
      width: 44px;
      height: 44px;
    }
    .blog3a-page-numbers {
      gap: 6px;
    }
  }
  @container page3a (max-width: 374px) {
    .blog3a-pagination {
      gap: 8px;
    }
    .blog3a-direction {
      padding-inline: 8px;
    }
    .blog3a-page-numbers {
      order: -1;
      justify-content: center;
      width: 100%;
    }
  }
  @container page3a (max-width: 270px) {
    .blog3a-featured-copy {
      padding-inline: 16px;
    }
  }
</style>
