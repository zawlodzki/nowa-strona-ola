---
import type { PageContent } from "../sanity/repository";
import { Button } from "../ui/button";
import Container from "../ui/container/Container.astro";
import {
  Dialog,
  DialogTrigger,
  DialogContent,
  DialogTitle,
  DialogDescription,
} from "../ui/dialog";
import Eyebrow from "../ui/eyebrow/Eyebrow.astro";
import Heading from "../ui/heading/Heading.astro";

export interface Props {
  page: PageContent;
}

const { page } = Astro.props;
const pl = page.language === "pl";
---

<section class="hero" aria-labelledby="hero-title">
  <Container>
    <Eyebrow>{page.eyebrow}</Eyebrow>
    <Heading tag="h1" id="hero-title">
      {page.title}
    </Heading>
    <p class="lead">{page.lead}</p>
    <div class="actions">
      <Button as="a" href="#contact">
        {pl ? "Porozmawiajmy" : "Let’s talk"}
      </Button>
      <Dialog>
        <DialogTrigger>{pl ? "Jak pracujemy" : "How we work"}</DialogTrigger>
        <DialogContent
          showCloseButton={false}
          aria-labelledby="dialog-title"
          aria-describedby="dialog-description"
        >
          <DialogTitle id="dialog-title">
            {pl ? "Najpierw rozmowa" : "A conversation first"}
          </DialogTitle>
          <DialogDescription id="dialog-description">
            {pl
              ? "Poznajemy cel, porządkujemy potrzeby i wspólnie ustalamy następny krok."
              : "We understand the goal, clarify your needs and agree on the next step together."}
          </DialogDescription>
          <Button
            data-slot="dialog-close"
            data-dialog-close
            class="relative inset-auto text-sm"
          >
            {pl ? "Zamknij" : "Close"}
          </Button>
        </DialogContent>
      </Dialog>
    </div>
    <noscript>
      <p>
        {pl
          ? "Najpierw rozmowa: poznajemy cel, porządkujemy potrzeby i ustalamy następny krok."
          : "A conversation first: we understand the goal, clarify your needs and agree on the next step."}
      </p>
    </noscript>
  </Container>
</section>
