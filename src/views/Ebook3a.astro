---
import type { Locale } from "@ola/shared";

import ArrowIcon from "@/design-system/components/ArrowIcon.astro";
import BookCover from "@/design-system/components/BookCover.astro";
import Button from "@/design-system/components/Button.astro";
import Container from "@/design-system/components/Container.astro";
import FaqItem from "@/design-system/components/FaqItem.astro";
import Heading from "@/design-system/components/Heading.astro";
import Hero from "@/design-system/components/Hero.astro";
import ReviewCard from "@/design-system/components/ReviewCard.astro";
import Section from "@/design-system/components/Section.astro";
import TextLink from "@/design-system/components/TextLink.astro";
import BookArtDecisions from "@/design-system/decorations/BookArtDecisions.astro";
import CheckMark from "@/design-system/decorations/CheckMark.astro";
import ProductOrbit from "@/design-system/decorations/ProductOrbit.astro";
import SheetShadow from "@/design-system/decorations/SheetShadow.astro";
import SupplementBottles from "@/design-system/decorations/SupplementBottles.astro";
import SiteImage from "@/design-system/components/SiteImage.astro";
import { ebookCopy } from "@/content/ebook-seed";
import { socialProfileSameAs } from "@/content/social-profiles";
import { canPurchase, type EbookView } from "@/content/map-ebook";
import { schemaOfferAvailability } from "@/lib/offer";

export interface Props {
  lang: Locale;
  content: EbookView;
}

const { lang, content } = Astro.props;
const copy = ebookCopy[lang];
const { landing, author, chapters, materials } = content;
const planned = !canPurchase(content.availability);
const purchaseText = `${landing.purchaseLabel} · ${content.priceGross} ${content.currencyLabel}`;
const oneLine = (value: string) => value.replaceAll("\n", " ");
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      name: oneLine(landing.heroTitle),
      description: landing.heroLead,
      inLanguage: lang,
      about: { "@id": "#ebook" },
    },
    {
      "@type": "Product",
      "@id": "#ebook",
      name: content.title,
      description: landing.heroLead,
      author: {
        "@type": "Person",
        name: author.name,
        jobTitle: author.role,
        sameAs: socialProfileSameAs(),
      },
      offers: {
        "@type": "Offer",
        price: content.priceGross,
        priceCurrency: content.currency,
        availability: schemaOfferAvailability(content.availability),
        url: content.checkoutUrl,
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: landing.faq.items.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    },
  ],
};
---

<main id="main" class="ebook3a">
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  ></script>
  <Hero
    id="start"
    kind="product"
    title={landing.heroTitle}
    description={landing.heroLead}
  >
    <p class="ebook3a-eyebrow" slot="kicker">
      {copy.heroEyebrow}
    </p>
    <Button slot="actions" as="a" href="#cena" arrow>
      {landing.primaryLabel}
    </Button>
    <TextLink slot="actions" href="#podglad">
      {landing.secondaryLabel}
    </TextLink>
    <figure slot="media" class="ebook3a-stage">
      <div class="ebook3a-orbit">
        <ProductOrbit />
      </div>
      <div class="ebook3a-book">
        <BookCover
          title={content.title}
          subtitle={content.subtitle ?? ""}
          author={author.name}
          topic={copy.coverTopic}
          tone={content.coverTone}
        >
          <BookArtDecisions slot="art" labels={copy.coverArt} />
        </BookCover>
      </div>
      <figcaption class="ebook3a-caption">{copy.coverCaption}</figcaption>
    </figure>
  </Hero>

  <div class="ao-container ebook3a-facts" aria-label={copy.factsAria}>
    {landing.facts.map((fact) => (
      <p>
        <strong>{fact.title}</strong>
        <span>{fact.detail}</span>
      </p>
    ))}
  </div>

  <Section id="problem">
    <Container class="ebook3a-split ebook3a-problem">
      <div>
        <Heading>{landing.problemTitle}</Heading>
        {landing.problemParagraphs.map((paragraph, index) => (
          <p class="ebook3a-copy">
            {index === 1 ? <strong>{paragraph}</strong> : paragraph}
          </p>
        ))}
      </div>
      <div class="ebook3a-shelf">
        <SupplementBottles labels={copy.bottleLabels} />
        <div class="ebook3a-questions">
          {landing.problemQuestions.map((question) => (
            <p>{question}</p>
          ))}
        </div>
        <p class="ebook3a-caption">{copy.problemCaption}</p>
      </div>
    </Container>
  </Section>

  <Section id="dla-kogo" surface="soft">
    <Container>
      <div class="ebook3a-audience-head">
        <Heading>{landing.audienceTitle}</Heading>
        <p class="ebook3a-copy">{landing.audienceLead}</p>
      </div>
      <div class="ebook3a-audience">
        {landing.audienceItems.map((item) => (
          <article>
            <span class="ebook3a-mark" aria-hidden="true">
              <ArrowIcon />
            </span>
            <Heading as="h3" size="card">
              {item.title}
            </Heading>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
      <p class="ebook3a-note ebook3a-audience-note">{landing.educationNote}</p>
    </Container>
  </Section>

  <Section id="zawartosc">
    <Container class="ebook3a-split ebook3a-contents">
      <div>
        <p class="ebook3a-eyebrow">{copy.contentsEyebrow}</p>
        <Heading>{landing.contentsTitle}</Heading>
        <p class="ebook3a-copy">{landing.contentsLead}</p>
        <TextLink href="#podglad">{copy.sampleLink}</TextLink>
        <p class="ebook3a-cloud" aria-label={copy.ingredientsAria}>
          {landing.ingredients.map((item) => (
            <span>{item}</span>
          ))}
        </p>
      </div>
      <div class="ebook3a-chapters">
        {chapters.map((chapter, index) => (
          <details class="ebook3a-chapter" open={index === 0}>
            <summary>
              <span class="ebook3a-chapter-num">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span>{chapter.title}</span>
              <svg
                class="ao-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M12 5v14M5 12h14"></path>
              </svg>
            </summary>
            <p>{chapter.summary}</p>
          </details>
        ))}
      </div>
    </Container>
  </Section>

  <Section id="podglad" surface="soft">
    <Container class="ebook3a-split ebook3a-preview">
      <div class="ebook3a-sheet-wrap">
        <SheetShadow />
        <div class="ebook3a-sheet">
          <p class="ebook3a-eyebrow">{copy.sampleKicker}</p>
          <Heading as="h3" size="card">
            {copy.sampleSheetTitle}
          </Heading>
          <p>{copy.sampleSheetLead}</p>
          <dl>
            {landing.sampleFields.map((label) => (
              <div>
                <dt>{label}</dt>
                <dd>................................................</dd>
              </div>
            ))}
          </dl>
          <p class="ebook3a-caption ebook3a-sheet-foot">
            {copy.sampleSheetFooter.map((item) => (
              <span>{item}</span>
            ))}
          </p>
        </div>
      </div>
      <div>
        <Heading>{landing.sampleTitle}</Heading>
        <p class="ebook3a-copy">{landing.sampleLead}</p>
        <ul class="ebook3a-materials">
          {materials.map((item) => (
            <li>
              <CheckMark />
              <span>{item.title}</span>
            </li>
          ))}
        </ul>
        <p class="ebook3a-note">{landing.sampleCaption}</p>
      </div>
    </Container>
  </Section>

  <Section id="efekty">
    <Container>
      <Heading>{landing.outcomesTitle}</Heading>
      <p class="ebook3a-copy ebook3a-outcomes-lead">{landing.outcomesLead}</p>
      <div class="ebook3a-compare">
        <div>
          <span class="ebook3a-eyebrow">{copy.beforeLabel}</span>
          {landing.comparisonItems.map((item) => (
            <p>{item.before}</p>
          ))}
        </div>
        <div>
          <span class="ebook3a-eyebrow">{copy.afterLabel}</span>
          {landing.comparisonItems.map((item) => (
            <p>{item.after}</p>
          ))}
        </div>
      </div>
      <p class="ebook3a-note">{landing.outcomesNote}</p>
    </Container>
  </Section>

  <Section id="autorka">
    <Container class="ebook3a-split ebook3a-author">
      <figure>
        <SiteImage
          src={author.photo?.src}
          fallback="about"
          alt={author.photo?.label ?? author.name}
          width={700}
          height={900}
          loading="lazy"
        />
      </figure>
      <div>
        <p class="ebook3a-eyebrow">{copy.authorEyebrow}</p>
        <Heading>{landing.authorTitle}</Heading>
        {landing.authorParagraphs.map((paragraph) => (
          <p class="ebook3a-copy">{paragraph}</p>
        ))}
        {content.sources[0] && (
          <TextLink
            href={content.sources[0].href}
            rel="noopener noreferrer"
            target="_blank"
          >
            {content.sources[0].title}
          </TextLink>
        )}
      </div>
    </Container>
  </Section>

  <Section id="cena" surface="soft">
    <Container class="ebook3a-split ebook3a-price-layout">
      <div>
        <Heading>{landing.offerTitle}</Heading>
        <p class="ebook3a-copy">{landing.offerLead}</p>
        <div class="ebook3a-price-book" aria-hidden="true">
          <div class="ebook3a-book">
            <BookCover
              title={content.title}
              subtitle={content.subtitle ?? ""}
              author={author.name}
              topic={copy.coverTopic}
              tone={content.coverTone}
            >
              <BookArtDecisions slot="art" labels={copy.coverArt} />
            </BookCover>
          </div>
        </div>
      </div>
      <div class="ebook3a-offer">
        <p class="ebook3a-eyebrow">{copy.offerPackage}</p>
        <Heading as="h3" size="card">
          {content.title}
        </Heading>
        {content.subtitle && <p class="ebook3a-muted">{content.subtitle}</p>}
        <p class="ebook3a-price">
          {content.priceGross}
          <span>{content.currencyLabel}</span>
          <small>{copy.offerPriceNote}</small>
        </p>
        <ul class="ebook3a-materials">
          {copy.offerIncludes.map((item) => (
            <li>
              <CheckMark />
              <span>{item}</span>
            </li>
          ))}
        </ul>
        {planned || !content.checkoutUrl ? (
          <details class="ebook3a-purchase">
            <summary class="ao-button">
              {purchaseText}
              <ArrowIcon />
            </summary>
            <div>
              <strong>{copy.purchasePreviewTitle}</strong>
              <p>{copy.purchasePreviewBody}</p>
            </div>
          </details>
        ) : (
          <Button as="a" href={content.checkoutUrl} arrow>
            {purchaseText}
          </Button>
        )}
        {landing.offerNote && <p class="ebook3a-note">{landing.offerNote}</p>}
      </div>
    </Container>
  </Section>

  <Section id="opinie">
    <Container>
      <Heading>{landing.testimonials.title}</Heading>
      <p class="ebook3a-copy">{landing.testimonials.lead}</p>
      <div class="ebook3a-reviews">
        {landing.testimonials.items.map((item) => (
          <ReviewCard
            author={
              item.anonymous ? (item.displayLabel ?? "") : (item.name ?? "")
            }
            context={item.anonymous ? undefined : item.role}
          >
            <p>{item.quote}</p>
          </ReviewCard>
        ))}
      </div>
    </Container>
  </Section>

  <Section id="faq">
    <Container class="ebook3a-split ebook3a-faq">
      <div>
        <Heading>{landing.faq.title}</Heading>
        <p class="ebook3a-copy">{landing.faq.lead}</p>
        <TextLink href="#cena">{copy.faqCta}</TextLink>
      </div>
      <div>
        {landing.faq.items.map((item, index) => (
          <FaqItem question={item.question} open={index === 0}>
            <p>{item.answer}</p>
          </FaqItem>
        ))}
      </div>
    </Container>
  </Section>
</main>

<style>
  .ebook3a :global(.ao-hero--product) {
    gap: 32px;
    padding-block: 44px 52px;
  }
  .ebook3a :global(.ao-hero--product .ao-lead) {
    max-inline-size: 480px;
    font-size: 1.25rem;
  }
  .ebook3a :global(.ao-text-link) {
    inline-size: fit-content;
    justify-content: flex-start;
    gap: 14px;
    border-block-end: 0;
    text-decoration: underline;
    text-underline-offset: 6px;
  }
  .ebook3a-eyebrow {
    margin-block: 0 var(--ao-space-12);
    margin-inline: 0;
    color: var(--ao-muted);
    font-size: 0.8125rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .ebook3a-copy {
    max-inline-size: 48ch;
    margin-block-start: 22px;
    font-size: 1.125rem;
    color: var(--ao-muted);
  }
  .ebook3a-copy strong {
    color: var(--ao-ink);
    font-weight: 600;
  }
  .ebook3a-muted,
  .ebook3a-note,
  .ebook3a-caption {
    color: var(--ao-muted);
    font-size: 0.875rem;
  }
  .ebook3a-note,
  .ebook3a-caption {
    margin-block-start: 24px;
  }
  .ebook3a-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 100px;
    align-items: center;
  }
  .ebook3a-stage {
    position: relative;
    display: grid;
    place-items: center;
    min-inline-size: 0;
    min-block-size: 540px;
    margin: 0;
    padding-block: 40px 18px;
    padding-inline: 32px;
    overflow: clip;
    border-radius: 160px 24px 24px 24px;
    background: var(--ao-surface);
  }
  .ebook3a-orbit {
    position: absolute;
    inline-size: min(500px, 120%);
    pointer-events: none;
  }
  .ebook3a-orbit :global(svg) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    color: var(--ao-line);
    transform: rotate(-20deg) scaleY(0.8);
  }
  .ebook3a-book {
    position: relative;
    inline-size: 252px;
    max-inline-size: 100%;
    transform: rotate(-8deg);
  }
  .ebook3a-stage .ebook3a-caption {
    position: relative;
    margin-block-start: 30px;
  }
  .ebook3a-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding-block: 24px;
    border-block: 1px solid var(--ao-line);
  }
  .ebook3a-facts p {
    display: grid;
    gap: 2px;
    padding-inline: 24px;
    border-inline-start: 1px solid var(--ao-line);
  }
  .ebook3a-facts p:first-child {
    padding-inline-start: 0;
    border-inline-start: 0;
  }
  .ebook3a-facts strong {
    font-size: 1.25rem;
    font-weight: 600;
  }
  .ebook3a-facts span {
    color: var(--ao-muted);
    font-size: 0.875rem;
  }
  .ebook3a-shelf {
    min-inline-size: 0;
    padding-block: 32px;
    padding-inline: 36px;
    border-radius: var(--ao-radius-image);
    background: var(--ao-surface);
  }
  .ebook3a-shelf :global(.ao-deco-bottles) {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }
  .ebook3a-questions {
    display: grid;
    gap: 8px;
    margin-block-start: 22px;
  }
  .ebook3a-questions p {
    inline-size: fit-content;
    padding-block: 8px;
    padding-inline: 15px;
    border: 1px solid var(--ao-line);
    border-radius: 999px;
    background: var(--ao-background);
    font-size: 0.875rem;
  }
  .ebook3a-questions p:nth-child(2) {
    margin-inline-start: auto;
  }
  .ebook3a-audience-head {
    max-inline-size: 700px;
  }
  .ebook3a-audience {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: 80px;
    row-gap: 35px;
    margin-block-start: 48px;
  }
  .ebook3a-audience article {
    position: relative;
    padding-inline-start: 48px;
  }
  .ebook3a-mark {
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: -4px;
    display: grid;
    color: var(--ao-ink);
  }
  .ebook3a-audience p {
    margin-block-start: 12px;
    max-inline-size: 420px;
    color: var(--ao-muted);
  }
  .ebook3a-audience-note {
    margin-block-start: 40px;
    padding-block-start: 20px;
    border-block-start: 1px solid var(--ao-line);
  }
  .ebook3a-contents {
    align-items: start;
  }
  .ebook3a-contents :global(.ao-text-link) {
    margin-block-start: 20px;
  }
  .ebook3a-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    max-inline-size: 360px;
    margin-block-start: 32px;
  }
  .ebook3a-cloud span {
    padding-block: 6px;
    padding-inline: 14px;
    border-radius: 999px;
    background: var(--ao-surface);
    font-size: 0.875rem;
  }
  .ebook3a-chapter {
    padding-block: 19px;
    border-block-end: 1px solid var(--ao-line);
  }
  .ebook3a-chapter:first-child {
    padding-block-start: 0;
  }
  .ebook3a-chapter summary {
    display: grid;
    grid-template-columns: 35px minmax(0, 1fr) 20px;
    gap: 14px;
    align-items: baseline;
    min-block-size: 44px;
    cursor: pointer;
    list-style: none;
    font-size: 1.3125rem;
    font-weight: 550;
    line-height: 1.3;
  }
  .ebook3a-chapter summary::-webkit-details-marker {
    display: none;
  }
  .ebook3a-chapter-num {
    color: var(--ao-muted);
    font-size: 0.8125rem;
    font-weight: 400;
  }
  .ebook3a-chapter[open] summary :global(.ao-icon) {
    transform: rotate(45deg);
  }
  .ebook3a-chapter p {
    margin-block: 10px 0;
    margin-inline: 34px 49px;
    color: var(--ao-muted);
  }
  .ebook3a-preview {
    align-items: center;
  }
  .ebook3a-sheet-wrap {
    position: relative;
    transform: rotate(-3deg);
  }
  .ebook3a-sheet-wrap :global(.ao-deco-sheet-shadow) {
    position: absolute;
    inset-block-start: 14px;
    inset-inline-end: -12px;
    inset-block-end: -14px;
    inset-inline-start: 12px;
    display: block;
    inline-size: 100%;
    block-size: 100%;
    color: color-mix(in oklch, var(--ao-ink) 9%, transparent);
    pointer-events: none;
    z-index: 0;
  }
  .ebook3a-sheet {
    position: relative;
    z-index: 1;
    padding: 40px;
    border-radius: 12px;
    background: var(--ao-background);
  }
  .ebook3a-sheet :global(.ao-heading--card) {
    margin-block-start: 25px;
    font-size: 2.25rem;
    font-weight: 600;
    line-height: 1.1;
  }
  .ebook3a-sheet > p:not(.ebook3a-eyebrow):not(.ebook3a-caption) {
    margin-block-start: 15px;
    color: var(--ao-muted);
    font-size: 0.875rem;
  }
  .ebook3a-sheet dl {
    margin-block: 24px;
    margin-inline: 0;
  }
  .ebook3a-sheet dl div {
    padding-block: 10px;
  }
  .ebook3a-sheet dt {
    font-size: 0.875rem;
    font-weight: 550;
  }
  .ebook3a-sheet dd {
    margin-block: 4px 0;
    margin-inline: 0;
    overflow: clip;
    color: var(--ao-muted);
    white-space: nowrap;
  }
  .ebook3a-sheet-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-block-start: 0;
    padding-block-start: 15px;
    border-block-start: 1px solid var(--ao-line);
    font-size: 0.6875rem;
  }
  .ebook3a-materials {
    display: grid;
    gap: 10px;
    margin-block: 25px 0;
    margin-inline: 0;
    padding: 0;
    list-style: none;
  }
  .ebook3a-materials li {
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
  }
  .ebook3a-materials :global(.ao-deco-check) {
    inline-size: 12px;
    block-size: 12px;
    margin-block-start: 4px;
    color: var(--ao-primary);
  }
  .ebook3a-outcomes-lead {
    max-inline-size: 650px;
  }
  .ebook3a-compare {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    margin-block-start: 40px;
    overflow: clip;
    border: 1px solid var(--ao-line);
    border-radius: var(--ao-radius-image);
  }
  .ebook3a-compare > div {
    padding: 40px;
  }
  .ebook3a-compare > div:last-child {
    background: var(--ao-surface);
  }
  .ebook3a-compare .ebook3a-eyebrow {
    display: block;
    margin-block-end: 24px;
    text-transform: none;
    letter-spacing: 0;
  }
  .ebook3a-compare p {
    margin-block-start: 22px;
    font-size: 1.6875rem;
    line-height: 1.25;
    letter-spacing: -0.025em;
  }
  .ebook3a-compare > div:first-child p {
    color: var(--ao-muted);
  }
  .ebook3a-compare > div:last-child p {
    font-weight: 550;
  }
  .ebook3a-author {
    align-items: center;
    padding-block: 0;
  }
  .ebook3a-author :global(img) {
    inline-size: 100%;
    block-size: 420px;
    object-fit: cover;
    object-position: center 35%;
    border-radius: 100px 24px 24px 24px;
    background: var(--ao-surface);
  }
  .ebook3a-author .ebook3a-eyebrow {
    line-height: 1.6;
  }
  .ebook3a-author :global(.ao-text-link) {
    margin-block-start: 22px;
    font-size: 0.8125rem;
  }
  .ebook3a-price-layout {
    align-items: start;
    gap: 70px;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
  }
  .ebook3a-price-book {
    padding-block: 55px 0;
    padding-inline: 35px;
  }
  .ebook3a-offer {
    padding: 40px;
    border-radius: var(--ao-radius-image);
