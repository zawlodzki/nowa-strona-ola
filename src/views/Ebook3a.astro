---
import type { Locale } from "@ola/shared";

import BookCover from "@/design-system/components/BookCover.astro";
import Button from "@/design-system/components/Button.astro";
import Container from "@/design-system/components/Container.astro";
import FaqItem from "@/design-system/components/FaqItem.astro";
import Heading from "@/design-system/components/Heading.astro";
import Hero from "@/design-system/components/Hero.astro";
import ReviewCard from "@/design-system/components/ReviewCard.astro";
import Section from "@/design-system/components/Section.astro";
import TextLink from "@/design-system/components/TextLink.astro";
import { ebookCopy } from "@/content/ebook-seed";
import { canPurchase, type EbookView } from "@/content/map-ebook";
import { schemaOfferAvailability } from "@/lib/offer";
import aboutPortrait from "@/assets/portraits/about.webp?url";

export interface Props {
  lang: Locale;
  content: EbookView;
}

const { lang, content } = Astro.props;
const copy = ebookCopy[lang];
const { landing, author, chapters, materials } = content;
const planned = !canPurchase(content.availability);
const purchaseText = `${landing.purchaseLabel} · ${content.priceGross} ${content.currencyLabel}`;
const photoSrc =
  author.photo?.src === "about" || !author.photo?.src?.startsWith("http")
    ? aboutPortrait
    : author.photo.src;
const oneLine = (value: string) => value.replaceAll("\n", " ");
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      name: oneLine(landing.heroTitle),
      description: landing.heroLead,
      inLanguage: lang,
      about: { "@id": "#ebook" },
    },
    {
      "@type": "Product",
      "@id": "#ebook",
      name: content.title,
      description: landing.heroLead,
      author: {
        "@type": "Person",
        name: author.name,
        jobTitle: author.role,
      },
      offers: {
        "@type": "Offer",
        price: content.priceGross,
        priceCurrency: content.currency,
        availability: schemaOfferAvailability(content.availability),
        url: content.checkoutUrl,
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: landing.faq.items.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    },
  ],
};
---

<main id="main" class="ebook3a">
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  ></script>
  <Hero
    id="start"
    kind="product"
    title={landing.heroTitle}
    description={landing.heroLead}
  >
    <p class="ebook3a-eyebrow" slot="actions">
      {copy.heroEyebrow}
    </p>
    <Button slot="actions" as="a" href="#cena" arrow>
      {landing.primaryLabel}
    </Button>
    <TextLink slot="actions" href="#podglad">
      {landing.secondaryLabel}
    </TextLink>
    <figure slot="media" class="ebook3a-product">
      <BookCover
        title={content.title}
        subtitle={content.subtitle ?? ""}
        author={author.name}
        topic={copy.coverTopic}
        tone={content.coverTone}
      >
        <div slot="art" class="ao-book-decisions" aria-hidden="true">
          {copy.coverArt.map((label) => (
            <span>{label}</span>
          ))}
        </div>
      </BookCover>
      <figcaption class="ebook3a-caption">{copy.coverCaption}</figcaption>
    </figure>
  </Hero>

  <div class="ao-container ebook3a-facts" aria-label={copy.factsAria}>
    {landing.facts.map((fact) => (
      <p>
        <strong>{fact.title}</strong>
        <span>{fact.detail}</span>
      </p>
    ))}
  </div>

  <Section id="problem">
    <Container class="ebook3a-split">
      <div>
        <Heading>{landing.problemTitle}</Heading>
        {landing.problemParagraphs.map((paragraph, index) => (
          <p class="ebook3a-copy">
            {index === 1 ? <strong>{paragraph}</strong> : paragraph}
          </p>
        ))}
      </div>
      <div class="ebook3a-shelf">
        <p class="ebook3a-cloud" aria-hidden="true">
          {copy.bottleLabels.map((label) => (
            <span>{label}</span>
          ))}
        </p>
        <div class="ebook3a-copy">
          {landing.problemQuestions.map((question) => (
            <p>{question}</p>
          ))}
        </div>
        <p class="ebook3a-caption">{copy.problemCaption}</p>
      </div>
    </Container>
  </Section>

  <Section id="dla-kogo" surface="soft">
    <Container>
      <div>
        <Heading>{landing.audienceTitle}</Heading>
        <p class="ebook3a-copy">{landing.audienceLead}</p>
      </div>
      <div class="ebook3a-audience">
        {landing.audienceItems.map((item) => (
          <article>
            <Heading as="h3" size="card">
              {item.title}
            </Heading>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
      <p class="ebook3a-note">{landing.educationNote}</p>
    </Container>
  </Section>

  <Section id="zawartosc">
    <Container class="ebook3a-split">
      <div>
        <p class="ebook3a-eyebrow">{copy.contentsEyebrow}</p>
        <Heading>{landing.contentsTitle}</Heading>
        <p class="ebook3a-copy">{landing.contentsLead}</p>
        <TextLink href="#podglad">{copy.sampleLink}</TextLink>
        <p class="ebook3a-cloud" aria-label={copy.ingredientsAria}>
          {landing.ingredients.map((item) => (
            <span>{item}</span>
          ))}
        </p>
      </div>
      <div>
        {chapters.map((chapter, index) => (
          <FaqItem
            question={`${String(index + 1).padStart(2, "0")} ${chapter.title}`}
            open={index === 0}
          >
            <p>{chapter.summary}</p>
          </FaqItem>
        ))}
      </div>
    </Container>
  </Section>

  <Section id="podglad" surface="soft">
    <Container class="ebook3a-split">
      <div class="ebook3a-sheet">
        <p class="ebook3a-eyebrow">{copy.sampleKicker}</p>
        <Heading as="h3" size="card">
          {copy.sampleSheetTitle}
        </Heading>
        <p>{copy.sampleSheetLead}</p>
        <dl>
          {landing.sampleFields.map((label) => (
            <div>
              <dt>{label}</dt>
              <dd>................................................</dd>
            </div>
          ))}
        </dl>
        <p class="ebook3a-caption ebook3a-sheet-foot">
          {copy.sampleSheetFooter.map((item) => (
            <span>{item}</span>
          ))}
        </p>
      </div>
      <div>
        <Heading>{landing.sampleTitle}</Heading>
        <p class="ebook3a-copy">{landing.sampleLead}</p>
        <ul class="ebook3a-materials">
          {materials.map((item) => (
            <li>{item.title}</li>
          ))}
        </ul>
        <p class="ebook3a-note">{landing.sampleCaption}</p>
      </div>
    </Container>
  </Section>

  <Section id="efekty">
    <Container>
      <Heading>{landing.outcomesTitle}</Heading>
      <p class="ebook3a-copy">{landing.outcomesLead}</p>
      <div class="ebook3a-compare">
        <div>
          <span class="ebook3a-eyebrow">{copy.beforeLabel}</span>
          {landing.comparisonItems.map((item) => (
            <p>{item.before}</p>
          ))}
        </div>
        <div>
          <span class="ebook3a-eyebrow">{copy.afterLabel}</span>
          {landing.comparisonItems.map((item) => (
            <p>{item.after}</p>
          ))}
        </div>
      </div>
      <p class="ebook3a-note">{landing.outcomesNote}</p>
    </Container>
  </Section>

  <Section id="autorka">
    <Container class="ebook3a-split">
      <figure>
        <img
          src={photoSrc}
          alt={author.photo?.label ?? author.name}
          width="700"
          height="900"
          loading="lazy"
        />
      </figure>
      <div>
        <p class="ebook3a-eyebrow">{copy.authorEyebrow}</p>
        <Heading>{landing.authorTitle}</Heading>
        {landing.authorParagraphs.map((paragraph) => (
          <p class="ebook3a-copy">{paragraph}</p>
        ))}
        {content.sources[0] && (
          <TextLink
            href={content.sources[0].href}
            rel="noopener noreferrer"
            target="_blank"
          >
            {content.sources[0].title}
          </TextLink>
        )}
      </div>
    </Container>
  </Section>

  <Section id="cena">
    <Container class="ebook3a-split">
      <div>
        <Heading>{landing.offerTitle}</Heading>
        <p class="ebook3a-copy">{landing.offerLead}</p>
        <div class="ebook3a-product" aria-hidden="true">
          <BookCover
            title={content.title}
            subtitle={content.subtitle ?? ""}
            author={author.name}
            topic={copy.coverTopic}
            tone={content.coverTone}
          />
        </div>
      </div>
      <div class="ebook3a-offer">
        <p class="ebook3a-eyebrow">{copy.offerPackage}</p>
        <Heading as="h3" size="card">
          {content.title}
        </Heading>
        {content.subtitle && <p class="ebook3a-muted">{content.subtitle}</p>}
        <p class="ebook3a-price">
          {content.priceGross}
          <span>{content.currencyLabel}</span>
          <small>{copy.offerPriceNote}</small>
        </p>
        <ul class="ebook3a-materials">
          {copy.offerIncludes.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        {planned || !content.checkoutUrl ? (
          <details class="ebook3a-purchase">
            <summary class="ao-button">{purchaseText}</summary>
            <div>
              <strong>{copy.purchasePreviewTitle}</strong>
              <p>{copy.purchasePreviewBody}</p>
            </div>
          </details>
        ) : (
          <Button as="a" href={content.checkoutUrl} arrow>
            {purchaseText}
          </Button>
        )}
        {landing.offerNote && <p class="ebook3a-note">{landing.offerNote}</p>}
      </div>
    </Container>
  </Section>

  <Section id="opinie">
    <Container>
      <Heading>{landing.testimonials.title}</Heading>
      <p class="ebook3a-copy">{landing.testimonials.lead}</p>
      <div class="ebook3a-reviews">
        {landing.testimonials.items.map((item) => (
          <ReviewCard
            author={
              item.anonymous ? (item.displayLabel ?? "") : (item.name ?? "")
            }
            context={item.anonymous ? undefined : item.role}
          >
            <p>{item.quote}</p>
          </ReviewCard>
        ))}
      </div>
    </Container>
  </Section>

  <Section id="faq">
    <Container class="ebook3a-split">
      <div>
        <Heading>{landing.faq.title}</Heading>
        <p class="ebook3a-copy">{landing.faq.lead}</p>
        <TextLink href="#cena">{copy.faqCta}</TextLink>
      </div>
      <div>
        {landing.faq.items.map((item, index) => (
          <FaqItem question={item.question} open={index === 0}>
            <p>{item.answer}</p>
          </FaqItem>
        ))}
      </div>
    </Container>
  </Section>
</main>
