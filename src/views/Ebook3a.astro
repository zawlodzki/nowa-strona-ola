---
import type { Locale } from "@ola/shared";

import BookCover from "@/design-system/components/BookCover.astro";
import Button from "@/design-system/components/Button.astro";
import Container from "@/design-system/components/Container.astro";
import FaqItem from "@/design-system/components/FaqItem.astro";
import Heading from "@/design-system/components/Heading.astro";
import Hero from "@/design-system/components/Hero.astro";
import ReviewCard from "@/design-system/components/ReviewCard.astro";
import Section from "@/design-system/components/Section.astro";
import TextLink from "@/design-system/components/TextLink.astro";
import { ebookCopy } from "@/content/ebook-seed";
import { canPurchase, type EbookView } from "@/content/map-ebook";
import { schemaOfferAvailability } from "@/lib/offer";
import aboutPortrait from "@/assets/portraits/about.webp?url";

export interface Props {
  lang: Locale;
  content: EbookView;
}

const { lang, content } = Astro.props;
const copy = ebookCopy[lang];
const { landing, author, chapters, materials } = content;
const planned = !canPurchase(content.availability);
const purchaseText = `${landing.purchaseLabel} · ${content.priceGross} ${content.currencyLabel}`;
const photoSrc =
  author.photo?.src === "about" || !author.photo?.src?.startsWith("http")
    ? aboutPortrait
    : author.photo.src;
const oneLine = (value: string) => value.replaceAll("\n", " ");
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      name: oneLine(landing.heroTitle),
      description: landing.heroLead,
      inLanguage: lang,
      about: { "@id": "#ebook" },
    },
    {
      "@type": "Product",
      "@id": "#ebook",
      name: content.title,
      description: landing.heroLead,
      author: {
        "@type": "Person",
        name: author.name,
        jobTitle: author.role,
      },
      offers: {
        "@type": "Offer",
        price: content.priceGross,
        priceCurrency: content.currency,
        availability: schemaOfferAvailability(content.availability),
        url: content.checkoutUrl,
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: landing.faq.items.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    },
  ],
};
---

<main id="main" class="ebook3a">
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  ></script>
  <Hero
    id="start"
    kind="product"
    title={landing.heroTitle}
    description={landing.heroLead}
  >
    <p class="ebook3a-eyebrow" slot="actions">
      {copy.heroEyebrow}
    </p>
    <Button slot="actions" as="a" href="#cena" arrow>
      {landing.primaryLabel}
    </Button>
    <TextLink slot="actions" class="ebook3a-sample" href="#podglad">
      {landing.secondaryLabel}
    </TextLink>
    <figure slot="media" class="ebook3a-product">
      <div class="ebook3a-orbit" aria-hidden="true"></div>
      <BookCover
        title={content.title}
        subtitle={content.subtitle ?? ""}
        author={author.name}
        topic={copy.coverTopic}
        tone={content.coverTone}
      >
        <div slot="art" class="ebook3a-cover-art" aria-hidden="true">
          {copy.coverArt.map((label) => (
            <span>{label}</span>
          ))}
        </div>
      </BookCover>
      <figcaption>{copy.coverCaption}</figcaption>
    </figure>
  </Hero>

  <div class="ao-container ebook3a-facts" aria-label={copy.factsAria}>
    {landing.facts.map((fact) => (
      <p>
        <strong>{fact.title}</strong>
        <span>{fact.detail}</span>
      </p>
    ))}
  </div>

  <Section id="problem">
    <Container class="ebook3a-split">
      <div>
        <Heading>{landing.problemTitle}</Heading>
        {landing.problemParagraphs.map((paragraph, index) => (
          <p class:list={[{ "ebook3a-strong": index === 1 }, "ebook3a-copy"]}>
            {paragraph}
          </p>
        ))}
      </div>
      <div class="ebook3a-shelf">
        <div class="ebook3a-bottles" aria-hidden="true">
          {copy.bottleLabels.map((label) => (
            <span class="ebook3a-bottle">{label}</span>
          ))}
        </div>
        <div class="ebook3a-questions">
          {landing.problemQuestions.map((question) => (
            <p>{question}</p>
          ))}
        </div>
        <p class="ebook3a-caption">{copy.problemCaption}</p>
      </div>
    </Container>
  </Section>

  <Section id="dla-kogo" surface="soft">
    <Container>
      <div class="ebook3a-audience-head">
        <Heading>{landing.audienceTitle}</Heading>
        <p class="ebook3a-copy">{landing.audienceLead}</p>
      </div>
      <div class="ebook3a-audience">
        {landing.audienceItems.map((item) => (
          <article>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
      <p class="ebook3a-note">{landing.educationNote}</p>
    </Container>
  </Section>

  <Section id="zawartosc">
    <Container class="ebook3a-split">
      <div>
        <p class="ebook3a-eyebrow">{copy.contentsEyebrow}</p>
        <Heading>{landing.contentsTitle}</Heading>
        <p class="ebook3a-copy">{landing.contentsLead}</p>
        <TextLink href="#podglad">{copy.sampleLink}</TextLink>
        <p class="ebook3a-cloud" aria-label={copy.ingredientsAria}>
          {landing.ingredients.map((item) => (
            <span>{item}</span>
          ))}
        </p>
      </div>
      <div class="ebook3a-chapters">
        {chapters.map((chapter, index) => (
          <details class="ebook3a-chapter" open={index === 0}>
            <summary>
              <span>{String(index + 1).padStart(2, "0")}</span>
              {chapter.title}
            </summary>
            <p>{chapter.summary}</p>
          </details>
        ))}
      </div>
    </Container>
  </Section>

  <Section id="podglad" surface="soft">
    <Container class="ebook3a-split">
      <div class="ebook3a-sheet">
        <p class="ebook3a-eyebrow">{copy.sampleKicker}</p>
        <h3>{copy.sampleSheetTitle}</h3>
        <p>{copy.sampleSheetLead}</p>
        <dl>
          {landing.sampleFields.map((label) => (
            <div>
              <dt>{label}</dt>
              <dd>................................................</dd>
            </div>
          ))}
        </dl>
        <p class="ebook3a-sheet-foot">
          {copy.sampleSheetFooter.map((item) => (
            <span>{item}</span>
          ))}
        </p>
      </div>
      <div>
        <Heading>{landing.sampleTitle}</Heading>
        <p class="ebook3a-copy">{landing.sampleLead}</p>
        <ul class="ebook3a-materials">
          {materials.map((item) => (
            <li>{item.title}</li>
          ))}
        </ul>
        <p class="ebook3a-note">{landing.sampleCaption}</p>
      </div>
    </Container>
  </Section>

  <Section id="efekty">
    <Container>
      <Heading>{landing.outcomesTitle}</Heading>
      <p class="ebook3a-copy ebook3a-copy--wide">{landing.outcomesLead}</p>
      <div class="ebook3a-compare">
        <div>
          <span class="ebook3a-eyebrow">{copy.beforeLabel}</span>
          {landing.comparisonItems.map((item) => (
            <p>{item.before}</p>
          ))}
        </div>
        <div>
          <span class="ebook3a-eyebrow">{copy.afterLabel}</span>
          {landing.comparisonItems.map((item) => (
            <p>{item.after}</p>
          ))}
        </div>
      </div>
      <p class="ebook3a-note">{landing.outcomesNote}</p>
    </Container>
  </Section>

  <Section id="autorka">
    <Container class="ebook3a-split">
      <figure>
        <img
          src={photoSrc}
          alt={author.photo?.label ?? author.name}
          width="700"
          height="900"
          loading="lazy"
        />
      </figure>
      <div>
        <p class="ebook3a-eyebrow">{copy.authorEyebrow}</p>
        <Heading>{landing.authorTitle}</Heading>
        {landing.authorParagraphs.map((paragraph) => (
          <p class="ebook3a-copy">{paragraph}</p>
        ))}
        {content.sources[0] && (
          <TextLink
            href={content.sources[0].href}
            rel="noopener noreferrer"
            target="_blank"
          >
            {content.sources[0].title}
          </TextLink>
        )}
      </div>
    </Container>
  </Section>

  <Section id="cena">
    <Container class="ebook3a-split">
      <div>
        <Heading>{landing.offerTitle}</Heading>
        <p class="ebook3a-copy">{landing.offerLead}</p>
        <div class="ebook3a-mini" aria-hidden="true">
          <BookCover
            title={content.title}
            subtitle={content.subtitle ?? ""}
            author={author.name}
            topic={copy.coverTopic}
            tone={content.coverTone}
          />
        </div>
      </div>
      <div class="ebook3a-offer">
        <p class="ebook3a-eyebrow">{copy.offerPackage}</p>
        <h3>{content.title}</h3>
        {content.subtitle && <p class="ebook3a-muted">{content.subtitle}</p>}
        <p class="ebook3a-price">
          {content.priceGross}
          <span>{content.currencyLabel}</span>
          <small>{copy.offerPriceNote}</small>
        </p>
        <ul class="ebook3a-materials">
          {copy.offerIncludes.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        {planned || !content.checkoutUrl ? (
          <details class="ebook3a-purchase">
            <summary>{purchaseText}</summary>
            <div>
              <strong>{copy.purchasePreviewTitle}</strong>
              <p>{copy.purchasePreviewBody}</p>
            </div>
          </details>
        ) : (
          <Button as="a" href={content.checkoutUrl} arrow>
            {purchaseText}
          </Button>
        )}
        {landing.offerNote && <p class="ebook3a-note">{landing.offerNote}</p>}
      </div>
    </Container>
  </Section>

  <Section id="opinie">
    <Container>
      <Heading>{landing.testimonials.title}</Heading>
      <p class="ebook3a-copy">{landing.testimonials.lead}</p>
      <div class="ebook3a-reviews">
        {landing.testimonials.items.map((item) => (
          <ReviewCard
            author={
              item.anonymous ? (item.displayLabel ?? "") : (item.name ?? "")
            }
            context={item.anonymous ? undefined : item.role}
          >
            <p>{item.quote}</p>
          </ReviewCard>
        ))}
      </div>
    </Container>
  </Section>

  <Section id="faq">
    <Container class="ebook3a-split">
      <div>
        <Heading>{landing.faq.title}</Heading>
        <p class="ebook3a-copy">{landing.faq.lead}</p>
        <TextLink href="#cena">{copy.faqCta}</TextLink>
      </div>
      <div>
        {landing.faq.items.map((item, index) => (
          <FaqItem question={item.question} open={index === 0}>
            <p>{item.answer}</p>
          </FaqItem>
        ))}
      </div>
    </Container>
  </Section>
</main>

<style>
  .ebook3a :global(.ao-heading),
  .ebook3a h3,
  .ebook3a-sheet h3 {
    white-space: pre-line;
  }
  .ebook3a h3 {
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .ebook3a-eyebrow {
    flex-basis: 100%;
    margin: 0 0 var(--ao-space-12);
    color: var(--ao-muted);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ebook3a-copy {
    max-width: 48ch;
    margin-top: var(--ao-space-16);
    font-size: 18px;
  }
  .ebook3a-copy--wide {
    max-width: 60ch;
  }
  .ebook3a-strong {
    font-weight: 650;
  }
  .ebook3a-muted,
  .ebook3a-note,
  .ebook3a-caption {
    color: var(--ao-muted);
  }
  .ebook3a-note,
  .ebook3a-caption {
    margin-top: var(--ao-space-16);
    font-size: 14px;
  }
  .ebook3a-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--ao-space-80);
    align-items: start;
  }
  .ebook3a-product {
    position: relative;
    margin: 0;
    text-align: center;
  }
  .ebook3a-orbit {
    position: absolute;
    inset: 8% 12%;
    border: 1px dashed color-mix(in srgb, var(--ao-primary) 35%, transparent);
    border-radius: 50%;
    pointer-events: none;
  }
  .ebook3a-product :global(.ao-book-cover) {
    position: relative;
    margin-inline: auto;
  }
  .ebook3a-cover-art {
    display: grid;
    gap: 6px;
    font-size: 11px;
  }
  .ebook3a-product figcaption,
  .ebook3a-sheet-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--ao-space-8);
    margin-top: var(--ao-space-16);
    font-size: 14px;
    color: var(--ao-muted);
  }
  .ebook3a-facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--ao-space-24);
    padding-block: var(--ao-space-32);
    border-block: 1px solid var(--ao-line);
  }
  .ebook3a-facts p,
  .ebook3a-facts strong,
  .ebook3a-facts span {
    display: grid;
    margin: 0;
  }
  .ebook3a-facts span {
    color: var(--ao-muted);
    font-size: 14px;
  }
  .ebook3a-shelf {
    padding: var(--ao-space-32);
    border-radius: var(--ao-radius-image);
    background: var(--ao-surface);
    text-align: center;
  }
  .ebook3a-bottles {
    display: flex;
    justify-content: center;
    gap: var(--ao-space-12);
  }
  .ebook3a-bottle {
    display: grid;
    place-items: end center;
    width: 72px;
    height: 120px;
    padding-bottom: var(--ao-space-12);
    border-radius: 12px 12px 8px 8px;
    background: var(--ao-background);
    border: 1px solid var(--ao-line);
    font-size: 10px;
    letter-spacing: 0.04em;
  }
  .ebook3a-questions {
    display: grid;
    gap: var(--ao-space-8);
    margin-top: var(--ao-space-24);
    font-size: 16px;
  }
  .ebook3a-audience-head {
    max-width: 40ch;
  }
  .ebook3a-audience {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--ao-space-40) var(--ao-space-48);
    margin-top: var(--ao-space-40);
  }
  .ebook3a-audience article {
    padding-top: var(--ao-space-20);
    border-top: 1px solid var(--ao-line);
  }
  .ebook3a-audience p {
    margin-top: var(--ao-space-12);
  }
  .ebook3a-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ao-space-8);
    margin-top: var(--ao-space-24);
  }
  .ebook3a-cloud span {
    padding: 6px 12px;
    border: 1px solid var(--ao-line);
    border-radius: 999px;
    font-size: 13px;
  }
  .ebook3a-chapters {
    display: grid;
    gap: var(--ao-space-8);
  }
  .ebook3a-chapter {
    border-bottom: 1px solid var(--ao-line);
  }
  .ebook3a-chapter summary {
    display: flex;
    gap: var(--ao-space-16);
    align-items: baseline;
    cursor: pointer;
    padding-block: var(--ao-space-16);
    font-weight: 650;
  }
  .ebook3a-chapter summary span {
    color: var(--ao-muted);
    font-variant-numeric: tabular-nums;
  }
  .ebook3a-chapter p {
    margin: 0 0 var(--ao-space-16) 3.2rem;
  }
  .ebook3a-sheet {
    padding: var(--ao-space-32);
    border-radius: var(--ao-radius-image);
    background: var(--ao-background);
    box-shadow: 0 16px 40px color-mix(in srgb, var(--ao-ink) 8%, transparent);
  }
  .ebook3a-sheet dl {
    display: grid;
    gap: var(--ao-space-16);
    margin: var(--ao-space-24) 0 0;
  }
  .ebook3a-sheet dt {
    font-size: 13px;
    color: var(--ao-muted);
  }
  .ebook3a-sheet dd {
    margin: 4px 0 0;
    letter-spacing: 0.08em;
    color: var(--ao-line);
  }
  .ebook3a-materials {
    display: grid;
    gap: var(--ao-space-12);
    margin: var(--ao-space-24) 0 0;
    padding: 0;
    list-style: none;
  }
  .ebook3a-materials li {
    padding-top: var(--ao-space-12);
    border-top: 1px solid var(--ao-line);
  }
  .ebook3a-compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--ao-space-32);
    margin-top: var(--ao-space-40);
  }
  .ebook3a-compare p {
    padding-top: var(--ao-space-16);
    border-top: 1px solid var(--ao-line);
  }
  .ebook3a img {
    width: 100%;
    border-radius: var(--ao-radius-image);
  }
  .ebook3a-mini {
    max-width: 220px;
    margin-top: var(--ao-space-32);
  }
  .ebook3a-offer {
    padding: var(--ao-space-40);
    border-radius: var(--ao-radius-image);
    background: var(--ao-surface);
  }
  .ebook3a-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    margin: var(--ao-space-16) 0 0;
    font-size: 48px;
    font-weight: 650;
    letter-spacing: -0.04em;
  }
  .ebook3a-price span {
    font-size: 20px;
  }
  .ebook3a-price small {
    width: 100%;
    color: var(--ao-muted);
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0;
  }
  .ebook3a-purchase summary {
    display: inline-flex;
    align-items: center;
    gap: var(--ao-space-8);
    margin-top: var(--ao-space-24);
    padding: 12px 20px;
    border-radius: 999px;
    background: var(--ao-primary);
    color: var(--ao-on-primary);
    font-weight: 650;
    cursor: pointer;
    list-style: none;
  }
  .ebook3a-purchase summary::-webkit-details-marker {
    display: none;
  }
  .ebook3a-purchase div {
    margin-top: var(--ao-space-16);
    padding: var(--ao-space-16);
    border-radius: var(--ao-radius-image);
    background: var(--ao-background);
  }
  .ebook3a-reviews {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--ao-space-32);
    margin-top: var(--ao-space-40);
  }
  @media (max-width: 900px) {
    .ebook3a-split,
    .ebook3a-facts,
    .ebook3a-audience,
    .ebook3a-compare,
    .ebook3a-reviews {
      grid-template-columns: 1fr;
    }
    .ebook3a-price {
      font-size: 36px;
    }
  }
  @media (max-width: 390px) {
    .ebook3a-copy {
      font-size: 16px;
    }
    .ebook3a-offer {
      padding: var(--ao-space-24);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ebook3a-orbit {
      display: none;
    }
  }
</style>
