---
import type { Locale } from "@ola/shared";

import { logoMark, type LogoVariant } from "@/assets/brand/logo";
import Layout from "../layouts/Layout.astro";
import { Button } from "../ui/button";
import Container from "../ui/container/Container.astro";
import {
  Dialog,
  DialogTrigger,
  DialogContent,
  DialogTitle,
  DialogDescription,
} from "../ui/dialog";
import Eyebrow from "../ui/eyebrow/Eyebrow.astro";
import Heading from "../ui/heading/Heading.astro";
import { Input } from "../ui/input";
import { Label } from "../ui/label";
import Logo from "../ui/logo/Logo.astro";
import SiteFooter from "../ui/site-footer/SiteFooter.astro";
import SiteHeader from "../ui/site-header/SiteHeader.astro";
import CatalogLibrary from "./CatalogLibrary.astro";

export interface Props {
  lang: Locale;
}

const colorTokens = [
  "white",
  "paper",
  "surface",
  "line",
  "ink",
  "body",
  "muted",
  "black",
  "deep",
  "accent",
] as const;

const { lang } = Astro.props as Props;
const pl = lang === "pl";
const logoVariants = Object.keys(logoMark.variants) as LogoVariant[];
const logoLabels: Record<LogoVariant, string> = {
  wordmark: pl ? "Jedna linia" : "One line",
  stacked: pl ? "Słowo pod słowem" : "Stacked",
  monogram: pl ? "Inicjały" : "Initials",
};
---

<Layout lang={lang} title={pl ? "Katalog komponentów" : "Component catalog"}>
  <SiteHeader lang={lang} section="catalog" />
  <main id="main">
    <section class="hero" aria-labelledby="catalog-title">
      <Container>
        <Eyebrow>
          {pl ? "Etap 3 · design system" : "Stage 3 · design system"}
        </Eyebrow>
        <Heading tag="h1" id="catalog-title">
          {pl ? "Katalog komponentów" : "Component catalog"}
        </Heading>
        <p class="lead">
          {pl
            ? "Tokeny pochodzą z tokens.json. Nagłówki i treść używają Switzera. Poniżej fundamenty, potem wszystkie sekcje strony."
            : "Tokens come from tokens.json. Headings and body copy use Switzer. Foundations come first, then every page section."}
        </p>
        <p class="pangram">Zażółć gęślą jaźń ąćęłńóśźż</p>
      </Container>
    </section>
    <section class="panel" aria-labelledby="logo-title">
      <Container>
        <Heading tag="h2" id="logo-title">
          {pl ? "Logo" : "Logo"}
        </Heading>
        <p class="lead">
          {pl
            ? "Znaki słowne złożono z Gambarino Regular. Krój strony to nadal Switzer. Źródło i warianty zapisane są w src/assets/brand/logo.ts."
            : "Wordmarks are set in Gambarino Regular. Page type remains Switzer. Source and variants live in src/assets/brand/logo.ts."}{" "}
          <a href={logoMark.font.source}>Fontshare · Gambarino</a>
        </p>
        <ul class="logo-specimens">
          {logoVariants.map((variant) => (
            <li>
              <Logo
                variant={variant}
                decorative={false}
                class="site-logo--display"
              />
              <p>
                <strong>{logoLabels[variant]}</strong>
                <span>
                  {logoMark.font.family} {logoMark.font.style}
                </span>
              </p>
            </li>
          ))}
        </ul>
      </Container>
    </section>
    <section class="panel" aria-labelledby="tokens-title">
      <Container>
        <Heading tag="h2" id="tokens-title">
          {pl ? "Kolory" : "Colors"}
        </Heading>
        <ul class="swatches">
          {colorTokens.map((token) => (
            <li>
              <span
                class="swatch"
                style={`background: var(--wf-color-${token})`}
              ></span>
              <code>{token}</code>
            </li>
          ))}
        </ul>
      </Container>
    </section>
    <section class="panel" aria-labelledby="actions-title">
      <Container>
        <Heading tag="h2" id="actions-title">
          {pl ? "Akcje i pole" : "Actions and field"}
        </Heading>
        <div class="actions">
          <Button type="button">
            {pl ? "Przycisk stały" : "Solid button"}
          </Button>
          <Button as="a" href={pl ? "/" : "/en/"} variant="outline">
            {pl ? "Przycisk-link" : "Button link"}
          </Button>
          <Button type="button" disabled>
            {pl ? "Niedostępny" : "Unavailable"}
          </Button>
          <Dialog>
            <DialogTrigger>
              {pl ? "Jak pracujemy" : "How we work"}
            </DialogTrigger>
            <DialogContent
              showCloseButton={false}
              aria-labelledby="catalog-dialog-title"
              aria-describedby="catalog-dialog-description"
            >
              <DialogTitle id="catalog-dialog-title">
                {pl ? "Najpierw rozmowa" : "A conversation first"}
              </DialogTitle>
              <DialogDescription id="catalog-dialog-description">
                {pl
                  ? "Poznajemy cel, porządkujemy potrzeby i wspólnie ustalamy następny krok."
                  : "We understand the goal, clarify your needs and agree on the next step together."}
              </DialogDescription>
              <Button
                data-slot="dialog-close"
                data-dialog-close
                class="relative inset-auto text-sm"
              >
                {pl ? "Zamknij" : "Close"}
              </Button>
            </DialogContent>
          </Dialog>
        </div>
        <div class="field-states">
          <div class="field catalog-field">
            <Label for="catalog-specimen-name">{pl ? "Imię" : "Name"}</Label>
            <Input
              id="catalog-specimen-name"
              name="specimen-name"
              value="Łucja"
              readonly
            />
          </div>
          <div class="field catalog-field">
            <Label for="catalog-specimen-error">
              {pl ? "Imię z błędem" : "Name with error"}
            </Label>
            <Input
              id="catalog-specimen-error"
              name="specimen-error"
              value="A"
              aria-invalid="true"
              aria-describedby="catalog-specimen-error-text"
              readonly
            />
            <p id="catalog-specimen-error-text" class="error">
              {pl
                ? "Wpisz imię (od 2 do 100 znaków)."
                : "Enter a name (2 to 100 characters)."}
            </p>
          </div>
        </div>
      </Container>
    </section>
    <section class="panel" data-theme="dark" aria-labelledby="dark-title">
      <Container>
        <Heading tag="h2" id="dark-title">
          {pl ? "Ciemna sekcja" : "Dark section"}
        </Heading>
        <p class="lead catalog-inverse">
          {pl
            ? "Ten sam zestaw tokenów, odwrócone tło i tekst."
            : "The same token set, with inverted background and text."}
        </p>
      </Container>
    </section>
    <CatalogLibrary lang={lang} />
  </main>
  <SiteFooter lang={lang} />
</Layout>

<style>
  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(7.5rem, 1fr));
    gap: var(--wf-space-16);
    padding: 0;
    margin: var(--wf-space-32) 0 0;
    list-style: none;
  }
  .swatches li {
    display: grid;
    gap: var(--wf-space-8);
    min-width: 0;
  }
  .swatch {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    border: 1px solid var(--wf-color-line);
    border-radius: var(--wf-radius-8);
  }
  .pangram {
    font-family: var(--wf-font-display);
    font-size: var(--wf-heading-size);
    font-weight: 300;
    letter-spacing: -0.04em;
    line-height: 1.15;
    max-width: 20ch;
  }
  .catalog-field {
    margin-top: var(--wf-space-32);
    max-width: 32rem;
  }
  .catalog-inverse {
    color: var(--wf-color-paper);
  }
  .logo-specimens {
    display: grid;
    gap: var(--wf-space-32);
    padding: 0;
    margin: var(--wf-space-32) 0 0;
    list-style: none;
  }
  .logo-specimens li {
    display: grid;
    gap: var(--wf-space-12);
    min-width: 0;
    padding: var(--wf-space-24);
    border: 1px solid var(--wf-color-line);
    border-radius: var(--wf-radius-12);
    background: var(--wf-color-paper);
  }
  .logo-specimens p {
    display: grid;
    gap: var(--wf-space-4);
    margin: 0;
    font-size: 14px;
    color: var(--wf-color-body);
  }
</style>
