---
import "./global.css";
import { stegaClean } from "@sanity/client/stega";
import "./components/ConsentPanel.css";
import ThemePreference from "./components/ThemePreference.astro";
import fontUrl from "../assets/fonts/switzer/Switzer-Variable.woff2?url";
import iconUrl from "../assets/brand/logo-monogram.svg?url";
import { htmlLang, isIndexingEnabled } from "@/lib/seo/site";
interface Props {
  title: string;
  lang: "pl" | "en";
  description?: string;
  /** Defaults to noindex unless the build sets SITE_INDEXING=production. */
  noindex?: boolean;
  /** Keep legacy Layout base metrics for routes migrated from it (visual parity). */
  legacyBase?: boolean;
}
const {
  title,
  lang,
  description,
  noindex = !isIndexingEnabled(),
  legacyBase = false,
} = Astro.props;
const headTitle = stegaClean(title).replace(/\s+/g, " ").trim();
const headDescription = description
  ? stegaClean(description).replace(/\s+/g, " ").trim()
  : undefined;
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <ThemePreference />
    <title>{headTitle}</title>
    {headDescription && <meta name="description" content={headDescription} />}
    <meta
      name="robots"
      content={
        noindex ? "noindex,nofollow" : "index,follow,max-image-preview:large"
      }
    />
    <link
      rel="preload"
      href={fontUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href={iconUrl} type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body class:list={["ao-site", legacyBase && "ao-site--legacy-base"]}>
    <a class="ao-skip" href="#main">
      {lang === "pl" ? "Przejdź do treści" : "Skip to content"}
    </a>
    <slot />
  </body>
</html>
