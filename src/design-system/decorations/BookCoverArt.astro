---
export type CoverArtKind =
  "decisions" | "route" | "nutrition" | "observation" | "journal" | "evening";

interface Props {
  kind: CoverArtKind;
  labels?: readonly string[] | string[];
  imageSrc?: string;
}
const { kind, labels = [], imageSrc } = Astro.props;
---

{kind === "decisions" && (
  <div class="ao-book-decisions" aria-hidden="true">
    {labels.map((label, index) => (
      <div>
        <span>{label}</span>
        <svg
          viewBox="0 0 100 2"
          preserveAspectRatio="none"
          aria-hidden="true"
          focusable="false"
        >
          <line
            x1="0"
            y1="1"
            x2={index === 1 ? 70 : 100}
            y2="1"
            stroke="currentColor"
            stroke-width="1"
          ></line>
        </svg>
      </div>
    ))}
  </div>
)}
{kind === "route" && (
  <div class="ao-book-art ao-book-art--route" aria-hidden="true">
    {labels.map((label) => (
      <span>
        <svg viewBox="0 0 12 12" aria-hidden="true" focusable="false">
          <circle
            cx="6"
            cy="6"
            r="5"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
          ></circle>
        </svg>
        {label}
      </span>
    ))}
  </div>
)}
{kind === "nutrition" && imageSrc && (
  <div class="ao-book-art ao-book-art--nutrition" aria-hidden="true">
    <img src={imageSrc} alt="" width="320" height="180" />
  </div>
)}
{kind === "observation" && (
  <div class="ao-book-art ao-book-art--observation" aria-hidden="true">
    {labels.map((label) => (
      <span>{label}</span>
    ))}
    <svg viewBox="0 0 160 23" preserveAspectRatio="none" aria-hidden="true">
      {Array.from({ length: 8 }, (_, index) => (
        <rect
          x={index * 20}
          y="0"
          width="18"
          height="23"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
        />
      ))}
    </svg>
  </div>
)}
{kind === "journal" && (
  <div class="ao-book-art ao-book-art--journal" aria-hidden="true">
    {labels[0] && <span>{labels[0]}</span>}
    <svg viewBox="0 0 168 28" aria-hidden="true" focusable="false">
      {Array.from({ length: 12 }, (_, index) => (
        <g transform={`translate(${(index % 6) * 28} ${index < 6 ? 0 : 14})`}>
          <line
            x1="0"
            y1="12"
            x2="24"
            y2="12"
            stroke="currentColor"
            stroke-width="1"
          />
          <text
            x="12"
            y="10"
            text-anchor="middle"
            fill="currentColor"
            font-size="8"
            font-family="inherit"
          >
            {index + 1}
          </text>
        </g>
      ))}
    </svg>
  </div>
)}
{kind === "evening" && (
  <div class="ao-book-art ao-book-art--evening" aria-hidden="true">
    <svg viewBox="0 0 180 36" aria-hidden="true" focusable="false">
      <line
        x1="0"
        y1="14"
        x2="180"
        y2="14"
        stroke="currentColor"
        stroke-width="1"
      />
      {labels.slice(0, 3).map((label, index) => (
        <text
          x={index === 0 ? 0 : index === 1 ? 90 : 180}
          y="10"
          text-anchor={index === 0 ? "start" : index === 1 ? "middle" : "end"}
          fill="currentColor"
          font-size="10"
          font-family="inherit"
          font-variant="tabular-nums"
        >
          {label}
        </text>
      ))}
      {labels[3] && (
        <text
          x="0"
          y="32"
          fill="currentColor"
          font-size="10"
          font-family="inherit"
        >
          {labels[3]}
        </text>
      )}
    </svg>
  </div>
)}

<style>
  .ao-book-art--route {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    font-size: 10px;
  }
  .ao-book-art--route span {
    display: grid;
    gap: 8px;
    justify-items: center;
    text-align: center;
  }
  .ao-book-art--route svg {
    width: 12px;
    height: 12px;
  }
  .ao-book-art--nutrition,
  .ao-book-art--nutrition img {
    width: 100%;
    height: 84px;
    object-fit: cover;
    object-position: right center;
  }
  .ao-book-art--observation {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    font-size: 10px;
  }
  .ao-book-art--observation svg {
    grid-column: 1 / -1;
    width: 100%;
    height: 23px;
  }
  .ao-book-art--journal {
    display: grid;
    gap: 8px;
    font-size: 10px;
  }
  .ao-book-art--journal svg,
  .ao-book-art--evening svg {
    width: 100%;
    height: auto;
  }
</style>
