      transform="translate(0 20)"
      fill="var(--ao-background)"
      stroke="var(--ao-line)"
      stroke-width="2"
    ></path>
    <path
      d={capPath(106)}
      transform="translate(12 0)"
      fill="var(--ao-ink)"
    ></path>
    <line
      x1="2"
      y1="68"
      x2="104"
      y2="68"
      stroke="var(--ao-line)"
      stroke-width="1"
    ></line>
    <line
      x1="2"
      y1="120"
      x2="104"
      y2="120"
      stroke="var(--ao-line)"
      stroke-width="1"
    ></line>
    <text
