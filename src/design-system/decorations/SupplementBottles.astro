---
interface Props {
  labels: readonly string[] | string[];
  class?: string;
}
const { labels, class: className } = Astro.props;
const [one = "INOZYTOL", two = "WITAMINA D", three = "OMEGA-3"] = labels;

function bodyPath(width: number, height: number) {
  const top = 22;
  const bottom = 14;
  return `M${top} 0H${width - top}Q${width} 0 ${width} ${top}V${height - bottom}Q${width} ${height} ${width - bottom} ${height}H${bottom}Q0 ${height} 0 ${height - bottom}V${top}Q0 0 ${top} 0Z`;
}

function capPath(width: number) {
  const inner = width - 24;
  return `M8 0H${inner - 8}Q${inner} 0 ${inner} 8V21Q${inner} 24 ${inner - 3} 24H3Q0 24 0 21V8Q0 0 8 0Z`;
}
---

<svg
  class:list={["ao-deco-bottles", className]}
  viewBox="0 0 354 210"
  role="img"
  aria-hidden="true"
  focusable="false"
>
  <line
    x1="12"
    y1="188"
    x2="342"
    y2="188"
    stroke="var(--ao-ink)"
    stroke-width="3"
  ></line>
  <circle cx="328" cy="188" r="3.5" fill="var(--ao-accent-on-light)"></circle>
  <g transform="translate(24 8) rotate(-7 53 90)">
    <path
      d={bodyPath(106, 160)}
      transform="translate(7 29)"
      fill="color-mix(in srgb, var(--ao-ink) 8%, transparent)"
    ></path>
    <path
      d={bodyPath(106, 160)}
      transform="translate(0 20)"
      fill="var(--ao-background)"
      stroke="var(--ao-line)"
      stroke-width="2"
    ></path>
    <path
      d={capPath(106)}
      transform="translate(12 0)"
      fill="var(--ao-ink)"
    ></path>
    <line
      x1="2"
      y1="72"
      x2="104"
      y2="72"
      stroke="var(--ao-line)"
      stroke-width="1"
    ></line>
    <line
      x1="2"
      y1="128"
      x2="104"
      y2="128"
      stroke="var(--ao-line)"
      stroke-width="1"
    ></line>
    <text
      x="53"
      y="104"
      text-anchor="middle"
      fill="var(--ao-ink)"
      font-size="11"
      font-family="inherit"
      letter-spacing="0.04em"
    >
      {one}
    </text>
  </g>
  <g transform="translate(133 50)">
    <path
      d={bodyPath(88, 118)}
      transform="translate(7 29)"
      fill="color-mix(in srgb, var(--ao-ink) 8%, transparent)"
    ></path>
    <path
      d={bodyPath(88, 118)}
      transform="translate(0 20)"
      fill="var(--ao-background)"
      stroke="var(--ao-line)"
      stroke-width="2"
    ></path>
    <path
      d={capPath(88)}
      transform="translate(12 0)"
      fill="var(--ao-ink)"
    ></path>
    <line
      x1="2"
      y1="58"
      x2="86"
      y2="58"
      stroke="var(--ao-line)"
      stroke-width="1"
    ></line>
    <line
      x1="2"
      y1="104"
      x2="86"
      y2="104"
      stroke="var(--ao-line)"
      stroke-width="1"
    ></line>
    <text
      x="44"
      y="86"
      text-anchor="middle"
      fill="var(--ao-ink)"
      font-size="10"
      font-family="inherit"
      letter-spacing="0.04em"
    >
      {two}
    </text>
  </g>
  <g transform="translate(232 20) rotate(7 53 84)">
    <path
      d={bodyPath(106, 148)}
