---
interface Props {
  variant?: "default" | "alt";
  class?: string;
}
const { variant = "default", class: className } = Astro.props;
---

<div class:list={["ao-cover-stage", `ao-cover-stage--${variant}`, className]}>
  <svg class="ao-cover-stage__fill" aria-hidden="true" focusable="false">
    <rect width="100%" height="100%" rx="24" fill="currentColor"></rect>
  </svg>
  <div class="ao-cover-stage__content">
    <slot />
  </div>
</div>

<style>
  .ao-cover-stage {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 100%;
    min-block-size: 440px;
    padding-block: 36px;
    padding-inline: var(--ao-space-24);
    color: var(--ao-stage);
  }
  .ao-cover-stage--alt {
    color: var(--ao-stage-alt);
  }
  .ao-cover-stage__fill {
    position: absolute;
    inset: 0;
    display: block;
    inline-size: 100%;
    block-size: 100%;
    pointer-events: none;
  }
  .ao-cover-stage__content {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
  }
</style>
