---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class:list={["ao-icon", "ui-icon", className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d="M20 11.5a8 8 0 0 1-12 7L3 20l1.5-5A8 8 0 1 1 20 11.5Z"></path>
  <path d="M8 7c-1 1-1 3 2 6s5 3 6 2l-2-2-1 1c-2-1-3-2-4-4l1-1Z"></path>
</svg>
