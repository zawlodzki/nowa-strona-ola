---
import type { EbookProblemVisual } from "@/content/map-ebook";

interface Props {
  kind: Exclude<EbookProblemVisual, "supplements">;
}
const { kind } = Astro.props;
---

<svg
  class="ao-deco-ebook-problem"
  viewBox="0 0 354 210"
  fill="none"
  stroke="var(--ao-ink)"
  stroke-width="2"
  aria-hidden="true"
  focusable="false"
>
  {kind === "results" && (
    <>
      <rect
        x="39"
        y="12"
        width="180"
        height="185"
        rx="12"
        fill="var(--ao-background)"
        stroke="var(--ao-line)"
      />
      <path d="M65 42h128M65 62h72" />
      {[90, 125, 160].map((y, index) => (
        <>
          <circle cx="75" cy={y} r="8" stroke="var(--ao-primary)" />
          <path
            d={`M97 ${y - 4}h96M97 ${y + 7}h${60 + index * 12}`}
            stroke="var(--ao-line)"
          />
        </>
      ))}
      <circle
        cx="248"
        cy="130"
        r="37"
        fill="var(--ao-surface)"
        stroke="var(--ao-primary)"
      />
      <path
        d="m275 158 38 34M228 130h40M248 110v40"
        stroke="var(--ao-primary)"
      />
    </>
  )}
  {kind === "plate" && (
    <>
      <circle
        cx="177"
        cy="105"
        r="90"
        fill="var(--ao-background)"
        stroke="var(--ao-line)"
      />
      <circle cx="177" cy="105" r="71" stroke="var(--ao-primary)" />
      <path d="M177 34v142M177 105h71" stroke="var(--ao-line)" />
      <path
        d="M135 76c-26-21-35 30-3 31-20 20 17 37 22 11 26 12 26-28 4-28 12-23-14-32-23-14Z"
        fill="var(--ao-accent)"
        stroke="var(--ao-accent-on-light)"
      />
      <path
        d="m202 66 22-8 14 20-27 13-17-11ZM203 135l26-10 13 23-27 13Z"
        fill="var(--ao-surface)"
        stroke="var(--ao-primary)"
      />
      <path d="M58 43v120M45 43v35q13 13 26 0V43M298 43v120M286 43v57h12" />
    </>
  )}
  {kind === "measurements" && (
    <>
      <rect
        x="32"
        y="20"
        width="168"
        height="176"
        rx="12"
        fill="var(--ao-background)"
        stroke="var(--ao-line)"
      />
      <path d="M56 50h118M56 71h69M59 102l6 6 12-14M86 105h87M59 134l6 6 12-14M86 137h87M59 166l6 6 12-14M86 169h87" />
      <path
        d="M241 35h54v147h-54z"
        fill="var(--ao-surface)"
        stroke="var(--ao-primary)"
      />
      {[55, 75, 95, 115, 135, 155].map((y, index) => (
        <path
          d={`M241 ${y}h${index % 2 === 0 ? 27 : 15}`}
          stroke="var(--ao-primary)"
        />
      ))}
      <circle
        cx="215"
        cy="177"
        r="13"
        fill="var(--ao-accent)"
        stroke="var(--ao-accent-on-light)"
      />
    </>
  )}
  {kind === "journal" && (
    <>
      <path
        d="M177 35Q108 8 32 33v151q76-24 145 3 69-27 145-3V33q-76-25-145 2Z"
        fill="var(--ao-background)"
        stroke="var(--ao-line)"
      />
      <path d="M177 35v152" stroke="var(--ao-primary)" />
      {[65, 89, 113, 137].map((y) => (
        <path
          d={`M57 ${y}q42-9 95 4M202 ${y + 4}q49-12 95-4`}
          stroke="var(--ao-line)"
        />
      ))}
      <path
        d="m250 45 26-27 12 12-26 27-18 5Z"
        fill="var(--ao-accent)"
        stroke="var(--ao-accent-on-light)"
      />
      <path d="m103 160 12 11 23-25" stroke="var(--ao-primary)" />
    </>
  )}
  {kind === "evening" && (
    <>
      <path
        d="M94 22c-40 4-63 51-41 85 17 27 52 33 77 17-35 2-58-28-52-58 3-17 9-30 16-44Z"
        fill="var(--ao-accent)"
        stroke="var(--ao-accent-on-light)"
      />
      <rect
        x="150"
        y="58"
        width="165"
        height="128"
        rx="12"
        fill="var(--ao-background)"
        stroke="var(--ao-line)"
      />
      <path d="M178 89h106M178 110h61" />
      <circle cx="189" cy="144" r="9" stroke="var(--ao-primary)" />
      <circle cx="231" cy="144" r="9" stroke="var(--ao-primary)" />
      <circle
        cx="273"
        cy="144"
        r="9"
        fill="var(--ao-accent)"
        stroke="var(--ao-accent-on-light)"
      />
      <path
        d="M33 172h103M44 153h81M160 23v16M152 31h16M121 52v12M115 58h12"
        stroke="var(--ao-primary)"
      />
    </>
  )}
</svg>
