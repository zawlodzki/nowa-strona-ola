---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class:list={["ao-icon", "ui-icon", className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d="m6 6 12 12M18 6 6 18"></path>
</svg>
