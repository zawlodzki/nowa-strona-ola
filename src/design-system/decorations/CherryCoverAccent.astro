---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class:list={["ao-deco-cherry-accent", className]}
  viewBox="0 0 72 20"
  aria-hidden="true"
  focusable="false"
>
  <line
    class="ao-deco-cherry-arrow-shaft"
    x1="1"
    y1="10"
    x2="42"
    y2="10"
    stroke="var(--ao-accent-on-primary)"
    stroke-width="1.25"
    stroke-linecap="round"
  ></line>
  <path
    class="ao-deco-cherry-arrow-head"
    fill="var(--ao-accent-on-primary)"
    d="M38 6.2 48 10 38 13.8Z"
  ></path>
  <path
    class="ao-deco-sparkle"
    fill="var(--ao-accent-on-primary)"
    d="M62 1.2 64.7 7.4 71 10 64.7 12.6 62 18.8 59.3 12.6 53 10 59.3 7.4Z"
  ></path>
</svg>
