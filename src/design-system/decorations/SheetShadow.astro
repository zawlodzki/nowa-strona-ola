---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class:list={["ao-deco-sheet-shadow", className]}
  aria-hidden="true"
  focusable="false"
>
  <rect width="100%" height="100%" rx="12" fill="currentColor"></rect>
</svg>

<style>
  .ao-deco-sheet-shadow {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
