---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class:list={["ao-deco-check", className]}
  viewBox="0 0 12 12"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d="M1.5 6.2 4.6 9.2 10.5 2.5"></path>
</svg>
