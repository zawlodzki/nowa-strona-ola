---
import type { Locale, NavigationLink, SocialLink } from "../types";
import Wordmark from "./Wordmark.astro";
import ArrowIcon from "./ArrowIcon.astro";
import ThemeToggle from "./ThemeToggle.astro";
interface Props {
  homeHref: string;
  description: string;
  links: NavigationLink[];
  socialLinks: SocialLink[];
  legalLinks: NavigationLink[];
  copyright: string;
  lang?: Locale;
  consentEnabled?: boolean;
}
const {
  homeHref,
  description,
  links,
  socialLinks,
  legalLinks,
  copyright,
  lang = "pl",
  consentEnabled = false,
} = Astro.props;
const pl = lang === "pl";
function socialName(label: string) {
  return pl
    ? `${label} Aleksandry Olesiewicz`
    : `${label} of Aleksandra Olesiewicz`;
}
function isHttpUrl(href: string) {
  return /^https?:\/\//i.test(href);
}
---

<footer class="ao-footer">
  <div class="ao-container">
    <div class="ao-footer__top">
      <Wordmark
        href={homeHref}
        label={
          pl
            ? "Aleksandra Olesiewicz — strona główna"
            : "Aleksandra Olesiewicz — home"
        }
      />
      <p>{description}</p>
      <nav
        class="ao-footer__social"
        aria-label={pl ? "Profile społecznościowe" : "Social profiles"}
      >
        {socialLinks.map((link) => (
          <a
            href={link.href}
            aria-label={socialName(link.label)}
            rel={isHttpUrl(link.href) ? "noopener noreferrer" : undefined}
            target={isHttpUrl(link.href) ? "_blank" : undefined}
          >
            {link.label}
            <ArrowIcon />
          </a>
        ))}
      </nav>
    </div>
    <nav
      class="ao-footer__navigation"
      aria-label={pl ? "Nawigacja w stopce" : "Footer navigation"}
    >
      {links.map((link) => (
        <a href={link.href} aria-current={link.current ? "page" : undefined}>
          {link.label}
        </a>
      ))}
    </nav>
    <div class="ao-footer__bottom">
      <p>{copyright}</p>
      <nav aria-label={pl ? "Informacje prawne" : "Legal information"}>
        {legalLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
        {consentEnabled && (
          <button
            class="ao-consent-settings"
            type="button"
            data-consent-open
            hidden
            aria-haspopup="dialog"
          >
            {pl ? "Ustawienia cookies" : "Cookie settings"}
          </button>
        )}
      </nav>
      <div class="ao-footer__tools">
        <ThemeToggle label={pl ? "Ciemny motyw" : "Dark theme"} />
        <a
          class="ao-back-to-top"
          href="#main"
          aria-label={pl ? "Powrót na górę" : "Back to top"}
        >
          <ArrowIcon />
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .ao-consent-settings {
    min-block-size: var(--ao-target-min);
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: start;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
</style>
