---
import { Image } from "astro:assets";

import { siteRasters as rasters } from "@/assets/site-rasters";
import {
  imageCropPosition,
  pickSiteImage,
  type SiteRasterKey,
} from "@/lib/site-images";

interface Props {
  src?: string;
  fallback?: SiteRasterKey;
  alt: string;
  width: number;
  height: number;
  class?: string;
  loading?: "eager" | "lazy";
  decoding?: "async" | "sync" | "auto";
  fetchpriority?: "high" | "low" | "auto";
  objectPosition?: string;
  fit?: "cover" | "contain" | "fill" | "none" | "scale-down";
}

const {
  src,
  fallback,
  alt,
  width,
  height,
  class: className,
  loading = "lazy",
  decoding = "async",
  fetchpriority,
  objectPosition,
  fit = "cover",
} = Astro.props;
const imageStyle = objectPosition
  ? `object-position: ${objectPosition}`
  : undefined;
const cropPosition = imageCropPosition(objectPosition);

const picked = pickSiteImage(src, fallback);
const eager = loading === "eager" || fetchpriority === "high";
---

{picked?.type === "local" && (
  <Image
    src={rasters[picked.key]}
    alt={alt}
    width={width}
    height={height}
    class={className}
    style={imageStyle}
    layout="none"
    format="webp"
    fit={fit}
    position={cropPosition}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={fetchpriority}
    decoding={decoding}
  />
)}
{picked?.type === "remote" && (
  <Image
    src={picked.src}
    alt={alt}
    width={width}
    height={height}
    class={className}
    style={imageStyle}
    layout="none"
    format="webp"
    fit={fit}
    position={cropPosition}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={fetchpriority}
    decoding={decoding}
  />
)}
