---
import type { Locale } from "@ola/shared";

interface Props {
  lang: Locale;
  endpoint: string;
}

const { lang, endpoint } = Astro.props;
const toolsEnabled = import.meta.env.PUBLIC_GTM_ENABLED === "true";
const copy = {
  pl: {
    title: "Pliki cookies na tej stronie",
    inactive:
      "Opcjonalne narzędzia nie zostały jeszcze uruchomione. Możesz zapisać swój wybór na przyszłość.",
    body: "Niezbędne pliki cookies zapewniają działanie strony. Za Twoją zgodą włączymy też narzędzia analityczne (pomagają nam ulepszać stronę) i marketingowe (mierzymy skuteczność reklam). Pomiar jest wyłączony na stronach kontaktu, konsultacji, odstąpienia i dokumentów prawnych oraz stronach oznaczonych „Bez pomiaru”. Zapis do newslettera nie wyklucza strony. Wybór zmienisz w każdej chwili w „Ustawieniach cookies”.",
    privacy: "Polityka prywatności",
    cookies: "Lista cookies",
    all: "Akceptuję wszystkie",
    necessary: "Odrzucam opcjonalne",
    customize: "Dostosuj",
    save: "Zapisuję wybór",
    settings: "Ustawienia cookies",
    close: "Zamknij bez zmiany zgód",
    categories: "Kategorie plików cookies",
    requiredTitle: "Niezbędne, zawsze aktywne",
    requiredDescription:
      "Działanie strony, ochrona przed botami, płatności, zapis Twojego wyboru.",
    measurementTitle: "Analityczne",
    measurementDescription:
      "Google Analytics 4: statystyki wyświetleń i czasu zaangażowania.",
    marketingTitle: "Marketingowe",
    marketingDescription: "Piksel Meta, z wyłączeniem stron opisanych powyżej.",
    success: "Ustawienia cookies zostały zapisane.",
    error:
      "Nie udało się zapisać ustawień cookies. Opcjonalne narzędzia pozostają wyłączone. Spróbuj ponownie.",
    storageError:
      "Przeglądarka blokuje trwały zapis wycofania zgody. Narzędzia są wyłączone na tej stronie, ale po przejściu dalej wcześniejszy wybór może wrócić. Odblokuj zapisywanie ustawień i spróbuj ponownie.",
    policyError:
      "Podstawy zgody zmieniły się. Sprawdź ustawienia i ponownie zapisz wybór.",
    loading: "Ładowanie ustawień cookies…",
    saving: "Zapisywanie ustawień cookies…",
  },
  en: {
    title: "Cookies on this website",
    inactive:
      "Optional tools have not been activated yet. You can save your preferences for later.",
    body: "Necessary cookies keep the website working. With your permission, we will also enable analytics tools (to improve the website) and marketing tools (to measure advertising performance). Measurement is disabled on contact, consultation, withdrawal and legal pages and on pages marked as excluded from measurement. A newsletter signup does not exclude a page. You can change your choice at any time in Cookie settings.",
    privacy: "Privacy policy",
    cookies: "Cookie list",
    all: "Accept all",
    necessary: "Reject optional",
    customize: "Customize",
    save: "Save my choice",
    settings: "Cookie settings",
    close: "Close without changing consent",
    categories: "Cookie categories",
    requiredTitle: "Necessary, always active",
    requiredDescription:
      "Website operation, bot protection, payments and saving your choice.",
    measurementTitle: "Analytics",
    measurementDescription:
      "Google Analytics 4: statistics on page views and engagement time.",
    marketingTitle: "Marketing",
    marketingDescription:
      "Meta pixel, except on the excluded pages described above.",
    success: "Cookie settings have been saved.",
    error:
      "Cookie settings could not be saved. Optional tools remain disabled. Please try again.",
    storageError:
      "Your browser prevents consent withdrawal from being saved. Optional tools are disabled on this page, but your previous choice may return after navigation. Allow settings to be saved and try again.",
    policyError:
      "The consent policy has changed. Review your settings and save your choice again.",
    loading: "Loading cookie settings…",
    saving: "Saving cookie settings…",
  },
}[lang];
const prefix = lang === "en" ? "/en" : "";
---

<div
  data-consent-panel
  data-endpoint={endpoint}
  data-language={lang}
  data-success={copy.success}
  data-error={copy.error}
  data-storage-error={copy.storageError}
  data-policy-error={copy.policyError}
  data-loading={copy.loading}
  data-saving={copy.saving}
>
  <section
    class="ao-consent-banner"
    data-consent-banner
    aria-labelledby="ao-consent-banner-title"
    hidden
  >
    <div class="ao-dialog__head">
      <h2 id="ao-consent-banner-title" class="ao-heading ao-heading--card">
        {copy.title}
      </h2>
      <button
        type="button"
        class="ao-dialog__close"
        data-consent-dismiss
        aria-label={copy.close}
      >
        <svg
          class="ao-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
    <p>
      {copy.body} {!toolsEnabled && <span>{copy.inactive} </span>}
      <span class="ao-consent-links">
        <a href={`${prefix}/polityka-prywatnosci/`}>{copy.privacy}</a>
        <a href={`${prefix}/lista-cookies-i-identyfikatorow/`}>
          {copy.cookies}
        </a>
      </span>
    </p>
    <div class="ao-consent-actions">
      <button type="button" class="ao-button" data-consent-action="all">
        {copy.all}
      </button>
      <button type="button" class="ao-button" data-consent-action="necessary">
        {copy.necessary}
      </button>
      <button
        type="button"
        class="ao-button"
        data-consent-action="customize"
        aria-haspopup="dialog"
        aria-controls="ao-consent-dialog"
      >
        {copy.customize}
      </button>
    </div>
    <p
      class="ao-consent-status"
      data-consent-status
      role="status"
      aria-live="polite"
      aria-atomic="true"
    ></p>
  </section>
  <dialog
    id="ao-consent-dialog"
    class="ao-dialog ao-consent-dialog"
    aria-labelledby="ao-consent-dialog-title"
    closedby="any"
  >
    <div class="ao-dialog__panel">
      <div class="ao-dialog__head">
        <h2 id="ao-consent-dialog-title" class="ao-heading ao-heading--card">
          {copy.settings}
        </h2>
        <button
          type="button"
          class="ao-dialog__close"
          data-consent-close
          aria-label={copy.close}
        >
          <svg
            class="ao-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </button>
      </div>
      <fieldset class="ao-consent-categories">
        <legend class="ao-consent-visually-hidden">{copy.categories}</legend>
        <label class="ao-consent-category">
          <input type="checkbox" checked disabled name="necessary" />
          <span>
            <strong>{copy.requiredTitle}</strong>
            <span>{copy.requiredDescription}</span>
          </span>
        </label>
        <label class="ao-consent-category">
          <input type="checkbox" name="measurement" data-consent-measurement />
          <span>
            <strong>{copy.measurementTitle}</strong>
            <span>{copy.measurementDescription}</span>
          </span>
        </label>
        <label class="ao-consent-category">
          <input type="checkbox" name="marketing" data-consent-marketing />
          <span>
            <strong>{copy.marketingTitle}</strong>
            <span>{copy.marketingDescription}</span>
          </span>
        </label>
      </fieldset>
      <p class="ao-consent-links">
        <a href={`${prefix}/polityka-prywatnosci/`}>{copy.privacy}</a>
        <a href={`${prefix}/lista-cookies-i-identyfikatorow/`}>
          {copy.cookies}
        </a>
      </p>
      <div class="ao-consent-actions">
        <button type="button" class="ao-button" data-consent-action="save">
          {copy.save}
        </button>
        <button type="button" class="ao-button" data-consent-action="all">
          {copy.all}
        </button>
        <button type="button" class="ao-button" data-consent-action="necessary">
          {copy.necessary}
        </button>
      </div>
      <p
        class="ao-consent-status"
        data-consent-status
        role="status"
        aria-live="polite"
        aria-atomic="true"
      ></p>
    </div>
  </dialog>
  <p
    class="ao-consent-visually-hidden"
    data-consent-announcement
    role="status"
    aria-live="polite"
    aria-atomic="true"
  ></p>
</div>

<script>
  import { initializeConsentPanel } from "@/lib/consent-panel";
  initializeConsentPanel();
</script>
