---
import type { HTMLAttributes } from "astro/types";
interface Props extends HTMLAttributes<"div"> {
  measure?: "wide" | "reading";
}
const { measure = "wide", class: className, ...attrs } = Astro.props;
---

<div
  class:list={[
    "ao-container",
    { "ao-container--reading": measure === "reading" },
    className,
  ]}
  {...attrs}
>
  <slot />
</div>
