---
import type { Locale, NavigationLink } from "../types";
import Wordmark from "./Wordmark.astro";
import ArrowIcon from "./ArrowIcon.astro";
interface Props {
  homeHref: string;
  links: NavigationLink[];
  cta?: NavigationLink;
  lang?: Locale;
  /** Makieta 3a nie pokazuje przełącznika języka. Adresy /en/ zostają. */
  languageHref?: string | null;
}
const { homeHref, links, cta, lang = "pl" } = Astro.props;
const pl = lang === "pl";
---

<header class="ao-header">
  <div class="ao-container ao-header__inner">
    <Wordmark
      href={homeHref}
      label={
        pl
          ? "Aleksandra Olesiewicz — strona główna"
          : "Aleksandra Olesiewicz — home"
      }
    />
    <nav aria-label={pl ? "Nawigacja główna" : "Primary navigation"}>
      <details>
        <summary
          class="ao-header__menu-toggle"
          aria-controls="site-navigation-panel"
        >
          Menu
        </summary>
      </details>
      <button
        class="ao-header__menu-toggle"
        type="button"
        hidden
        popovertarget="site-navigation-panel"
        aria-controls="site-navigation-panel"
      >
        Menu <span aria-hidden="true">+</span>
      </button>
      <div class="ao-header__panel" id="site-navigation-panel" popover="auto">
        <ul class="ao-header__links" role="list">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={link.current ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        {cta && (
          <a
            class="ao-header__cta"
            href={cta.href}
            aria-current={cta.current ? "page" : undefined}
          >
            {cta.label}
            <ArrowIcon />
          </a>
        )}
      </div>
    </nav>
  </div>
</header>
<script>
  if (CSS.supports("selector(:popover-open)")) {
    for (const header of document.querySelectorAll<HTMLElement>(".ao-header")) {
      const trigger = header.querySelector<HTMLButtonElement>(
        "button[popovertarget]",
      );
      const panel = header.querySelector<HTMLElement>(".ao-header__panel");
      const fallback = header.querySelector("details");
      const symbol = trigger?.querySelector("span");
      if (!trigger || !panel || !symbol || !fallback || fallback.open) continue;

      trigger.hidden = false;
      fallback.hidden = true;

      trigger.addEventListener("click", () =>
        trigger.focus({ preventScroll: true }),
      );
      panel.addEventListener("toggle", () => {
        symbol.textContent = panel.matches(":popover-open") ? "−" : "+";
      });
      panel.addEventListener("click", (event) => {
        if (
          panel.matches(":popover-open") &&
          event.target instanceof Element &&
          event.target.closest("a[href]")
        ) {
          panel.hidePopover();
        }
      });

      const updatePanel = () => {
        if (trigger.getClientRects().length) {
          const offset = `${header.offsetHeight}px`;
          panel.style.position = "fixed";
          panel.style.insetBlockStart = offset;
          panel.style.maxBlockSize = `calc(min(100%, 100dvh) - ${offset})`;
          return;
        }
        panel.style.removeProperty("position");
        panel.style.removeProperty("inset-block-start");
        panel.style.removeProperty("max-block-size");
        if (!panel.matches(":popover-open")) return;
        panel.hidePopover();
        if (document.activeElement === document.body) {
          panel
            .querySelector<HTMLAnchorElement>("a[href]")
            ?.focus({ preventScroll: true });
        }
      };
      updatePanel();
      const observer = new ResizeObserver(updatePanel);
      observer.observe(header);
      observer.observe(trigger);
    }
  }
</script>
