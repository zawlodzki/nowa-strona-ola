---
import TextLink from "./TextLink.astro";
interface Props {
  title: string;
  href: string;
  description: string;
  metadata?: string;
  actionLabel: string;
}
const { title, href, description, metadata, actionLabel } = Astro.props;
---

<article class="ao-card">
  <a class="ao-card__media" href={href} aria-label={title} tabindex="-1">
    <slot name="media" />
  </a>
  {metadata && <p class="ao-card__meta">{metadata}</p>}
  <h3 class="ao-heading ao-heading--card">
    <a href={href}>{title}</a>
  </h3>
  <p class="ao-card__description">{description}</p>
  <div class="ao-card__action">
    <slot name="price" />
    <TextLink href={href}>{actionLabel}</TextLink>
  </div>
</article>
