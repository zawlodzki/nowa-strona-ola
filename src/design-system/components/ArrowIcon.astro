---
interface Props {
  direction?:
    "up-right" | "left" | "right" | "down" | "chevron-left" | "chevron-right";
}
const { direction = "up-right" } = Astro.props;
const paths = {
  "up-right": "M7 17 17 7M7 7h10v10",
  left: "M19 12H5m7-7-7 7 7 7",
  right: "M5 12h14m-7-7 7 7-7 7",
  down: "M12 5v14m-7-7 7 7 7-7",
  "chevron-left": "m14 6-6 6 6 6",
  "chevron-right": "m10 6 6 6-6 6",
};
---

<svg
  class="ao-icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[direction]} />
</svg>
