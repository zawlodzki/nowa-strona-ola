---
interface PageLink {
  href: string;
  page: number;
  current?: boolean;
}
interface Props {
  pages: PageLink[];
  label?: string;
  pageLabel?: string;
}
const { pages, label = "Paginacja", pageLabel = "Strona" } = Astro.props;
---

<nav class="ao-pagination" aria-label={label}>
  {pages.map((link) => (
    <a
      href={link.href}
      aria-current={link.current ? "page" : undefined}
      aria-label={`${pageLabel} ${link.page}`}
    >
      {link.page}
    </a>
  ))}
</nav>

<style>
  .ao-pagination {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ao-space-8);
  }
  .ao-pagination a {
    display: grid;
    place-items: center;
    min-inline-size: var(--ao-target-min);
    min-block-size: var(--ao-target-min);
    border: 1px solid var(--ao-line);
    border-radius: var(--ao-radius-control);
    font-variant-numeric: tabular-nums;
  }
  .ao-pagination a[aria-current] {
    background: var(--ao-primary);
    color: var(--ao-on-primary);
    border-color: var(--ao-primary);
  }
</style>
