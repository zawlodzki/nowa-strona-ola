---
import type { HTMLAttributes } from "astro/types";
interface Props extends HTMLAttributes<"a"> {
  href: string;
  label?: string;
}
const {
  label = "Aleksandra Olesiewicz — strona główna",
  class: className,
  ...attrs
} = Astro.props;
---

<a class:list={["ao-wordmark", className]} aria-label={label} {...attrs}>
  <span aria-hidden="true">aleksandra</span>
  <span aria-hidden="true">olesiewicz</span>
</a>
