---
interface Props {
  label?: string;
}
const { label = "Ciemny motyw" } = Astro.props;
---

<button
  class="ao-theme-toggle"
  type="button"
  aria-label={label}
  aria-pressed="false"
  hidden
>
  <svg
    class="ao-icon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M20.8 13A9 9 0 0 1 11 3.2 9 9 0 1 0 20.8 13Z" />
  </svg>
</button>
