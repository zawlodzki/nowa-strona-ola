---
interface Props {
  title: string;
  subtitle: string;
  author: string;
  topic: string;
  tone?: "light" | "cherry";
}
const { title, subtitle, author, topic, tone = "light" } = Astro.props;
---

<div
  class:list={["ao-book-cover", `ao-book-cover--${tone}`]}
  aria-hidden="true"
>
  <span class="ao-book-cover__author">{author}</span>
  <strong>{title}</strong>
  <span class="ao-book-cover__subtitle">{subtitle}</span>
  <div class="ao-book-cover__art">
    <slot name="art" />
    <svg
      class="ao-deco-sparkle"
      viewBox="0 0 12 12"
      aria-hidden="true"
      focusable="false"
    >
      <path
        fill="var(--ao-deco-accent)"
        d="M6 1.1 6.9 4.7 10.6 5.5 6.9 6.3 6 9.9 5.1 6.3 1.4 5.5 5.1 4.7Z"
      ></path>
    </svg>
  </div>
  <span class="ao-book-cover__topic">{topic}</span>
</div>
