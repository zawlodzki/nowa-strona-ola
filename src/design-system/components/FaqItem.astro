---
interface Props {
  question: string;
  open?: boolean;
}
const { question, open = false } = Astro.props;
---

<details class="ao-faq" open={open}>
  <summary>
    {question}
    <svg
      class="ao-icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M12 5v14M5 12h14" />
    </svg>
  </summary>
  <div class="ao-prose">
    <slot />
  </div>
</details>
