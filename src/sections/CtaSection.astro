---
import type { CtaContent } from "@/sections/types";
import { Button } from "@/ui/button";
import Heading from "@/ui/heading/Heading.astro";
import Section from "@/ui/section/Section.astro";

export interface Props {
  id?: string;
  labelledby: string;
  content: CtaContent;
}

const { id, labelledby, content } = Astro.props as Props;
---

<Section id={id} theme={content.theme ?? "light"} labelledby={labelledby}>
  <div class="section-stack" data-reveal>
    <Heading tag="h2" id={labelledby}>
      {content.title}
    </Heading>
    <p class="lead section-lead">{content.lead}</p>
    <div class="actions">
      <Button as="a" href={content.action.href}>
        {content.action.label}
      </Button>
    </div>
  </div>
</Section>
