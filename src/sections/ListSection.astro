---
import type { ListContent } from "@/sections/types";
import Heading from "@/ui/heading/Heading.astro";
import Section from "@/ui/section/Section.astro";

export interface Props {
  id?: string;
  labelledby: string;
  content: ListContent;
}

const { id, labelledby, content } = Astro.props as Props;
---

<Section id={id} labelledby={labelledby}>
  <div class="section-stack" data-reveal>
    <Heading tag="h2" id={labelledby}>
      {content.title}
    </Heading>
    {content.lead && <p class="lead section-lead">{content.lead}</p>}
  </div>
  <ul class="plain-list" data-reveal>
    {content.items.map((item) => (
      <li>{item}</li>
    ))}
  </ul>
</Section>
