---
import type { ComparisonContent } from "@/sections/types";
import Heading from "@/ui/heading/Heading.astro";
import Section from "@/ui/section/Section.astro";

export interface Props {
  id?: string;
  labelledby: string;
  content: ComparisonContent;
}

const { id, labelledby, content } = Astro.props as Props;
---

<Section id={id} labelledby={labelledby}>
  <div class="section-stack" data-reveal>
    <Heading tag="h2" id={labelledby}>
      {content.title}
    </Heading>
    <p class="lead section-lead">{content.lead}</p>
  </div>
  <div
    class="table-wrap"
    tabindex="0"
    role="region"
    aria-label={content.caption}
  >
    <table class="comparison-table">
      <caption>{content.caption}</caption>
      <thead>
        <tr>
          <th scope="col">{content.rowHeading}</th>
          {content.columns.map((column) => (
            <th scope="col">{column}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {content.rows.map((row) => (
          <tr>
            <th scope="row">{row.feature}</th>
            {row.values.map((value) => (
              <td>{value}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Section>
