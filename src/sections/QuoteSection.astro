---
import type { QuoteContent } from "@/sections/types";
import Heading from "@/ui/heading/Heading.astro";
import Section from "@/ui/section/Section.astro";

export interface Props {
  id?: string;
  labelledby: string;
  content: QuoteContent;
}

const { id, labelledby, content } = Astro.props as Props;
---

<Section id={id} theme={content.theme ?? "light"} labelledby={labelledby}>
  <Heading tag="h2" id={labelledby} class="visually-hidden">
    {content.heading}
  </Heading>
  <blockquote class="pull-quote-block" data-reveal>
    <p class="pull-quote">{content.quote}</p>
    <footer>
      <cite>{content.attribution}</cite>
    </footer>
  </blockquote>
</Section>
