---
import type { TestimonialsContent } from "@/sections/types";
import Heading from "@/ui/heading/Heading.astro";
import Section from "@/ui/section/Section.astro";

export interface Props {
  id?: string;
  labelledby: string;
  content: TestimonialsContent;
}

const { id, labelledby, content } = Astro.props as Props;
---

<Section id={id} labelledby={labelledby}>
  <div class="section-stack" data-reveal>
    <Heading tag="h2" id={labelledby}>
      {content.title}
    </Heading>
  </div>
  <ul class="quote-grid">
    {content.items.map((item) => (
      <li class="quote-card" data-reveal>
        <blockquote>
          <p>{item.quote}</p>
          <footer>
            <cite>
              {item.name}, {item.role}
            </cite>
          </footer>
        </blockquote>
      </li>
    ))}
  </ul>
</Section>
