---
import type { Locale } from "@ola/shared";

import LeadForm from "@/design-system/components/LeadForm.astro";
import type { FormCopy } from "@/sections/types";
import Eyebrow from "@/ui/eyebrow/Eyebrow.astro";
import Heading from "@/ui/heading/Heading.astro";
import Section from "@/ui/section/Section.astro";

export interface Props {
  lang: Locale;
  labelledby: string;
  content: FormCopy;
  id?: string;
  idPrefix?: string;
}

const {
  lang,
  labelledby,
  content,
  id = "contact",
  idPrefix = "",
} = Astro.props as Props;
---

<Section id={id} labelledby={labelledby} class="form-grid">
  <div class="section-stack" data-reveal>
    {content.eyebrow && <Eyebrow>{content.eyebrow}</Eyebrow>}
    <Heading tag="h2" id={labelledby}>
      {content.title}
    </Heading>
    <p class="lead section-lead">{content.lead}</p>
  </div>
  <LeadForm
    content={content}
    lang={lang}
    idPrefix={idPrefix}
    layout="stacked"
  />
</Section>
