---
// Adapted from bejamas/ui; see THIRD-PARTY-NOTICES.md.

import { cn } from "@/lib/utils";
import { cva, type VariantProps } from "class-variance-authority";
import type { HTMLAttributes } from "astro/types";

const inputVariants = cva(
  "w-full min-w-0 outline-none file:inline-flex file:border-0 file:bg-transparent disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50",
  {
    variants: {
      size: {
        sm: "data-[size=sm]",
        default: "data-[size=default]",
        lg: "data-[size=lg]",
      },
    },
    defaultVariants: {
      size: "default",
    },
  },
);

type InputUiSize = NonNullable<VariantProps<typeof inputVariants>["size"]>;
type NativeInputSize = HTMLAttributes<"input">["size"];

interface Props extends Omit<HTMLAttributes<"input">, "size"> {
  size?: InputUiSize | NativeInputSize;
  nativeSize?: NativeInputSize;
}

const {
  class: className = "",
  type = "text",
  size: sizeProp,
  nativeSize,
  ...props
} = Astro.props as Props;

const isUiSize = (value: unknown): value is InputUiSize =>
  value === "sm" || value === "default" || value === "lg";

const resolvedUiSize = isUiSize(sizeProp) ? sizeProp : "default";
const resolvedNativeSize =
  nativeSize ?? (!isUiSize(sizeProp) ? sizeProp : undefined);
---

<input
  type={type}
  size={resolvedNativeSize}
  data-slot={props["data-slot"] ?? "input"}
  data-size={resolvedUiSize}
  class={cn(
    "dark:bg-input/30 border-input focus-visible:border-ring focus-visible:ring-ring/50 aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive dark:aria-invalid:border-destructive/50 h-9 rounded-md border bg-transparent px-2.5 py-1 text-base shadow-xs transition-[color,box-shadow] file:h-7 file:text-sm file:font-medium focus-visible:ring-3 aria-invalid:ring-3 md:text-sm rounded-lg data-[size=sm]:h-8 data-[size=sm]:px-2.5 data-[size=sm]:py-1 data-[size=sm]:md:text-xs data-[size=default]:h-9 data-[size=default]:px-3 data-[size=default]:py-1 data-[size=default]:md:text-sm data-[size=lg]:h-10 data-[size=lg]:px-3.5 data-[size=lg]:py-1.5 data-[size=lg]:md:text-base",
    inputVariants({ size: resolvedUiSize }),
    className,
  )}
  {...props}
/>
