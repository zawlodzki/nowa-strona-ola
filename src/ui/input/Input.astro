---
// Adapted from bejamas/ui; see THIRD-PARTY-NOTICES.md.

import { cn } from "@/lib/utils";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"input">;

const { class: className = "", type = "text", ...props } = Astro.props as Props;
---

<input
  type={type}
  data-slot={props["data-slot"] ?? "input"}
  class={cn(
    "dark:bg-input/30 border-input focus-visible:border-ring focus-visible:ring-ring/50 aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive dark:aria-invalid:border-destructive/50 h-9 rounded-md border bg-transparent px-3 py-1 text-base shadow-xs transition-[color,box-shadow] file:h-7 file:text-sm file:font-medium focus-visible:ring-3 aria-invalid:ring-3 md:text-sm rounded-lg",
    className,
  )}
  {...props}
/>
