---
import type { Locale } from "@ola/shared";

import {
  catalogPath,
  homePath,
  isLocaleEnabled,
  type SiteSection,
} from "@/lib/paths";
import Container from "@/ui/container/Container.astro";
import Logo from "@/ui/logo/Logo.astro";
import TextLink from "@/ui/text-link/TextLink.astro";

export interface HeaderLink {
  href: string;
  label: string;
}

export interface Props {
  lang: Locale;
  section?: SiteSection;
  alternateHref?: string | null;
  navigation?: HeaderLink[] | null;
}

const {
  lang,
  section = "home",
  alternateHref,
  navigation,
} = Astro.props as Props;
const pl = lang === "pl";
const homeHref = homePath(lang);
const otherLanguage: Locale = pl ? "en" : "pl";
const languageHref = !isLocaleEnabled(otherLanguage)
  ? null
  : alternateHref === undefined
    ? section === "catalog"
      ? catalogPath(otherLanguage)
      : homePath(otherLanguage)
    : alternateHref;
const links = navigation?.length
  ? navigation
  : [
      {
        href: catalogPath(lang),
        label: pl ? "Komponenty" : "Components",
      },
    ];
---

<Container tag="header" class="site-header">
  <TextLink
    href={homeHref}
    class="site-brand"
    aria-label={
      pl
        ? "Aleksandra Olesiewicz — strona główna"
        : "Aleksandra Olesiewicz — home"
    }
  >
    <Logo variant="wordmark" class="site-brand__wide" />
    <Logo variant="stacked" class="site-brand__narrow" />
  </TextLink>
  <nav aria-label={pl ? "Nawigacja główna" : "Primary"}>
    {links.map((link) => (
      <TextLink href={link.href}>{link.label}</TextLink>
    ))}
    {languageHref ? (
      <TextLink
        href={languageHref}
        lang={pl ? "en" : "pl"}
        hreflang={pl ? "en" : "pl"}
      >
        {pl ? "English" : "Polski"}
      </TextLink>
    ) : null}
  </nav>
</Container>
