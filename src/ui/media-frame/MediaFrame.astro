---
import { cn } from "@/lib/utils";

export interface Props {
  label: string;
  tone?: "photo" | "diagram" | "portrait";
  class?: string;
  src?: string;
}

const {
  label,
  tone = "photo",
  class: className = "",
  src,
} = Astro.props as Props;
---

{src ? (
  <img
    class={cn("media-frame", `media-frame--${tone}`, className)}
    src={src}
    alt={label}
  />
) : (
  <div
    class={cn("media-frame", `media-frame--${tone}`, className)}
    role="img"
    aria-label={label}
  ></div>
)}
