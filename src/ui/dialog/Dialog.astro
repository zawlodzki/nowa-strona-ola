---
// Adapted from bejamas/ui; see THIRD-PARTY-NOTICES.md.

import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  defaultOpen?: boolean;
  closeOnClickOutside?: boolean;
  closeOnEscape?: boolean;
  lockScroll?: boolean;
}

const {
  class: className,
  defaultOpen = false,
  closeOnClickOutside = true,
  closeOnEscape = true,
  lockScroll = true,
  ...rest
} = Astro.props as Props;
---

<div
  data-slot="dialog"
  data-default-open={defaultOpen}
  data-close-on-click-outside={closeOnClickOutside}
  data-close-on-escape={closeOnEscape}
  data-lock-scroll={lockScroll}
  class={className}
  {...rest}
>
  <slot />
</div>

<script>
  import { createDialog } from "@data-slot/dialog";

  document
    .querySelectorAll<HTMLElement>('[data-slot="dialog"]')
    .forEach((el) => {
      const trigger = el.querySelector<HTMLElement>(
        '[data-slot="dialog-trigger"]',
      );
      // Safari does not focus buttons on pointer activation. Capture the trigger
      // before the primitive remembers activeElement for its focus restoration.
      trigger?.addEventListener("click", () => trigger.focus(), {
        capture: true,
      });
      createDialog(el);
    });
</script>
