---
import type { HTMLAttributes } from "astro/types";

import { cn } from "@/lib/utils";

export type Props = HTMLAttributes<"a"> & {
  class?: string;
};

const { class: className = "", href, ...rest } = Astro.props as Props;
---

<a href={href} class={cn("text-link", className)} {...rest}>
  <slot />
</a>
