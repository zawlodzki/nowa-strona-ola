---
import type { Locale } from "@ola/shared";

import { catalogPath, homePath } from "@/lib/paths";
import Container from "@/ui/container/Container.astro";
import Logo from "@/ui/logo/Logo.astro";
import TextLink from "@/ui/text-link/TextLink.astro";

export interface Props {
  lang: Locale;
  note?: string;
}

const { lang, note } = Astro.props as Props;
const pl = lang === "pl";
---

<Container tag="footer" class="site-footer">
  <TextLink
    href={homePath(lang)}
    class="site-brand"
    aria-label={
      pl
        ? "Aleksandra Olesiewicz — strona główna"
        : "Aleksandra Olesiewicz — home"
    }
  >
    <Logo variant="wordmark" />
  </TextLink>
  <p>
    {note ??
      (pl
        ? "Lokalny prototyp · treści demonstracyjne"
        : "Local prototype · demonstration content")}
  </p>
  <TextLink href={catalogPath(lang)}>
    {pl ? "Katalog komponentów" : "Component catalog"}
  </TextLink>
</Container>
