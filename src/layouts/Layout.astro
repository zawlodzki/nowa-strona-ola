---
import monogramIcon from "../assets/brand/logo-monogram.svg?url";
import switzerWoff2 from "../assets/fonts/switzer/Switzer-Variable.woff2?url";
import "../styles/global.css";
interface Props {
  lang: "pl" | "en";
  title: string;
}
const { lang, title } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <link
      rel="preload"
      href={switzerWoff2}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href={monogramIcon} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">
      {lang === "pl" ? "Przejdź do treści" : "Skip to content"}
    </a>
    <slot />
  </body>
</html>
