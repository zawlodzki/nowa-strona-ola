---
import { env } from "cloudflare:workers";
import type { Locale } from "@ola/shared";

import ArticleView from "../../../src/views/ArticleView.astro";
import BlogIndex from "../../../src/views/BlogIndex.astro";
import ComposedPage from "../../../src/views/ComposedPage.astro";
import EbookPage from "../../../src/views/EbookPage.astro";
import { parseContentPath } from "../../../src/lib/content-path";
import { blogCategoryPath, blogPath } from "../../../src/lib/paths";
import { demonstrationSettings } from "../../../src/sanity/fixtures";
import {
  getPreviewArticle,
  getPreviewArticleIndex,
  getPreviewCategories,
  getPreviewCategory,
  getPreviewEbook,
  getPreviewPage,
  getPreviewSiteSettings,
} from "../lib/content";

const route = parseContentPath(Astro.params.locale);
const environment = {
  SANITY_PROJECT_ID: env.SANITY_PROJECT_ID,
  SANITY_DATASET: env.SANITY_DATASET,
  SANITY_STUDIO_URL: env.SANITY_STUDIO_URL,
  SANITY_API_READ_TOKEN: env.SANITY_API_READ_TOKEN,
};

if (route.kind === "unknown") {
  Astro.response.status = 404;
}

const language: Locale | null =
  route.kind === "unknown" ? null : route.language;

const settings = language
  ? await getPreviewSiteSettings(language, environment).catch(
      () => demonstrationSettings[language],
    )
  : null;
const page =
  route.kind === "home"
    ? await getPreviewPage(route.language, "home", environment)
    : route.kind === "page"
      ? await getPreviewPage(route.language, route.slug, environment)
      : null;
const article =
  route.kind === "article"
    ? await getPreviewArticle(route.language, route.slug, environment)
    : null;
const ebook =
  route.kind === "ebook"
    ? await getPreviewEbook(route.language, route.slug, environment)
    : null;
const blogIndex =
  route.kind === "blogIndex" && language
    ? await getPreviewArticleIndex(language, route.page, environment)
    : null;
const blogCategory =
  route.kind === "blogCategory" && language
    ? {
        category: await getPreviewCategory(language, route.slug, environment),
        index: await getPreviewArticleIndex(language, route.page, environment, {
          categorySlug: route.slug,
        }),
      }
    : null;
const categories = language
  ? await getPreviewCategories(language, environment)
  : [];
---

{article && language && settings ? (
  <ArticleView lang={language} article={article} settings={settings} />
) : ebook && language && settings ? (
  <EbookPage lang={language} ebook={ebook} settings={settings} preview />
) : page && language && settings ? (
  <ComposedPage
    lang={language}
    page={page}
    settings={settings}
    section={route.kind === "home" ? "home" : "page"}
    preview
  />
) : blogIndex && language && settings ? (
  <BlogIndex
    lang={language}
    settings={settings}
    title="Blog"
    lead={
      language === "pl"
        ? "Wpisy demonstracyjne. Każdy język ma osobne dokumenty."
        : "Demonstration posts. Each language has its own documents."
    }
    articles={blogIndex.items}
    featured={blogIndex.featured}
    categories={categories}
    page={blogIndex.page}
    totalPages={blogIndex.totalPages}
    pageHref={(pageNumber) => blogPath(language, pageNumber)}
    alternateHref={blogPath(language === "pl" ? "en" : "pl", blogIndex.page)}
  />
) : blogCategory && language && settings ? (
  <BlogIndex
    lang={language}
    settings={settings}
    title={blogCategory.category.title ?? blogCategory.category.slug ?? ""}
    lead={blogCategory.category.description ?? ""}
    articles={blogCategory.index.items}
    featured={blogCategory.index.featured}
    categories={categories}
    page={blogCategory.index.page}
    totalPages={blogCategory.index.totalPages}
    category={blogCategory.category}
    pageHref={(pageNumber) =>
      blogCategoryPath(language, blogCategory.category.slug ?? "", pageNumber)
    }
    alternateHref={
      blogCategory.category.translation?.slug
        ? blogCategoryPath(
            language === "pl" ? "en" : "pl",
            blogCategory.category.translation.slug,
            blogCategory.index.page,
          )
        : null
    }
  />
) : (
  <p>Nie znaleziono strony podglądu.</p>
)}
