---
import { env } from "cloudflare:workers";
import type { Locale } from "@ola/shared";

import ArticleView from "../../../src/views/ArticleView.astro";
import BlogCollectionPage from "../../../src/views/BlogCollectionPage.astro";
import ComposedPage from "../../../src/views/ComposedPage.astro";
import EbookCollectionPage from "../../../src/views/EbookCollectionPage.astro";
import EbookPage from "../../../src/views/EbookPage.astro";
import { parseContentPath } from "../../../src/lib/content-path";
import { blogCategoryPath, blogPath } from "../../../src/lib/paths";
import {
  demonstrationCategories,
  demonstrationSettings,
} from "../../../src/sanity/fixtures";
import { getArticleIndex } from "../../../src/sanity/repository";
import { fixtureEbooksForLanguage } from "../../../src/sanity/ebook-fixtures";
import {
  getPreviewArticle,
  getPreviewArticleIndex,
  getPreviewCategories,
  getPreviewCategory,
  getPreviewEbook,
  getPreviewEbooks,
  getPreviewPage,
  getPreviewSiteSettings,
} from "../lib/content";

const route = parseContentPath(Astro.params.locale);
const environment = {
  SANITY_PROJECT_ID: env.SANITY_PROJECT_ID,
  SANITY_DATASET: env.SANITY_DATASET,
  SANITY_STUDIO_URL: env.SANITY_STUDIO_URL,
  SANITY_API_READ_TOKEN: env.SANITY_API_READ_TOKEN,
};

if (route.kind === "unknown") {
  Astro.response.status = 404;
}

const language: Locale | null =
  route.kind === "unknown" ? null : route.language;

const settings = language
  ? await getPreviewSiteSettings(language, environment).catch(
      () => demonstrationSettings[language],
    )
  : null;
const page =
  route.kind === "home"
    ? await getPreviewPage(route.language, "home", environment)
    : route.kind === "page"
      ? await getPreviewPage(route.language, route.slug, environment)
      : null;
const article =
  route.kind === "article"
    ? await getPreviewArticle(route.language, route.slug, environment)
    : null;
const ebook =
  route.kind === "ebook"
    ? await getPreviewEbook(route.language, route.slug, environment)
    : null;
const collectionPage =
  route.kind === "ebookCollection"
    ? await getPreviewPage(
        route.language,
        route.language === "pl" ? "ebooki" : "ebooks",
        environment,
      )
    : null;
const collectionEbooks =
  route.kind === "ebookCollection" && language
    ? await getPreviewEbooks(language, environment).catch(() =>
        fixtureEbooksForLanguage(language),
      )
    : [];
const blogIndex =
  route.kind === "blogIndex" && language
    ? await getPreviewArticleIndex(language, route.page, environment).catch(
        () => getArticleIndex(language, route.page, { environment: {} }),
      )
    : null;
const blogCategory =
  route.kind === "blogCategory" && language
    ? {
        category: await getPreviewCategory(
          language,
          route.slug,
          environment,
        ).catch(() => {
          const match = demonstrationCategories[language].find(
            (item) => item.slug === route.slug,
          );
          if (!match) {
            throw new Error(
              `Brak kategorii podglądu ${language}/${route.slug}.`,
            );
          }
          return match;
        }),
        index: await getPreviewArticleIndex(language, route.page, environment, {
          categorySlug: route.slug,
        }).catch(() =>
          getArticleIndex(language, route.page, {
            environment: {},
            categorySlug: route.slug,
          }),
        ),
      }
    : null;
const categories = language
  ? await getPreviewCategories(language, environment).catch(
      () => demonstrationCategories[language],
    )
  : [];
---

{article && language && settings ? (
  <ArticleView lang={language} article={article} settings={settings} />
) : ebook && language && settings ? (
  <EbookPage lang={language} ebook={ebook} settings={settings} preview />
) : collectionPage &&
  language &&
  settings &&
  route.kind === "ebookCollection" ? (
  <EbookCollectionPage
    lang={language}
    page={collectionPage}
    settings={settings}
    ebooks={collectionEbooks}
    filter={route.topic}
    preview
  />
) : page && language && settings ? (
  <ComposedPage
    lang={language}
    page={page}
    settings={settings}
    section={route.kind === "home" ? "home" : "page"}
    preview
  />
) : blogIndex && language && settings ? (
  <BlogCollectionPage
    lang={language}
    settings={settings}
    index={blogIndex}
    categories={categories}
    pageHref={(pageNumber) => blogPath(language, pageNumber)}
    alternateHref={blogPath(language === "pl" ? "en" : "pl", blogIndex.page)}
    preview
  />
) : blogCategory && language && settings ? (
  <BlogCollectionPage
    lang={language}
    settings={settings}
    index={blogCategory.index}
    categories={categories}
    category={blogCategory.category}
    pageHref={(pageNumber) =>
      blogCategoryPath(language, blogCategory.category.slug ?? "", pageNumber)
    }
    alternateHref={
      blogCategory.category.translation?.slug
        ? blogCategoryPath(
            language === "pl" ? "en" : "pl",
            blogCategory.category.translation.slug,
            blogCategory.index.page,
          )
        : null
    }
    preview
  />
) : (
  <p>Nie znaleziono strony podglądu.</p>
)}
